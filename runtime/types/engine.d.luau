declare Vector3: {
    --- Returns a vector with the given components. A missing component is 0. The call allocates no
    --- memory.
    new: ((x: number?, y: number?, z: number?) -> vector),
    --- Returns a vector with the given components. It is the constructor of Luau's standard `vector`
    --- library, for code shared with other Luau runtimes. Unlike `new`, it requires `x` and `y`.
    create: ((x: number, y: number, z: number?) -> vector),
    --- Returns the length of a vector. It is faster than reading the `Magnitude` field.
    magnitude: ((v: vector) -> number),
    --- Returns a vector scaled to a length of 1. Normalizing a zero vector returns NaN components; it
    --- does not raise an error.
    normalize: ((v: vector) -> vector),
    --- Returns the dot product of two vectors.
    dot: ((a: vector, b: vector) -> number),
    --- Returns the cross product of two vectors. It is right-handed: for the axes of any `CFrame`,
    --- `cross(right, up) == -look`.
    cross: ((a: vector, b: vector) -> vector),
    --- Returns the angle between two vectors, in radians, from 0 to π. With `axis`, the angle is
    --- signed about that axis by the right-hand rule and ranges from -π to π.
    angle: ((a: vector, b: vector, axis: vector?) -> number),
    --- Returns the linear interpolation from `a` to `b`, component by component. `alpha` is not
    --- clamped, so a value outside 0 to 1 extrapolates.
    lerp: ((a: vector, b: vector, alpha: number) -> vector),
    --- Returns a vector with each component rounded down.
    floor: ((v: vector) -> vector),
    --- Returns a vector with each component rounded up.
    ceil: ((v: vector) -> vector),
    --- Returns a vector with the absolute value of each component.
    abs: ((v: vector) -> vector),
    --- Returns a vector with -1, 0 or 1 for each component, according to its sign.
    sign: ((v: vector) -> vector),
    --- Returns a vector with each component clamped between the matching components of `min` and `max`.
    --- Raises an error if a component of `min` is greater than that of `max`.
    clamp: ((v: vector, min: vector, max: vector) -> vector),
    --- Returns a vector with the smallest value of each component among the arguments. The result is a
    --- corner of their bounding box, not the shortest argument.
    min: ((a: vector, ...vector) -> vector),
    --- Returns a vector with the largest value of each component among the arguments. The result is the
    --- corner of their bounding box opposite the one `min` returns.
    max: ((a: vector, ...vector) -> vector),
    zero: vector,
    one: vector,
}

declare CFrame: {
    --- Returns a `CFrame` at the given position with no rotation. A missing component is 0, so
    --- `CFrame.new()` is the identity. The components are stored as 64-bit floats.
    new: ((x: number?, y: number?, z: number?) -> CFrame) & ((position: vector) -> CFrame),
    --- Returns a `CFrame` at `position` whose `LookVector` points toward `target`. `up` sets which way
    --- is up and defaults to `(0, 1, 0)`. If `target` equals `position`, or `up` is parallel to the
    --- direction, the result has no rotation.
    lookAt: ((position: vector, target: vector, up: vector?) -> CFrame),
    --- Returns a rotation from three angles, in radians, applied in the order that `order` gives. Each
    --- rotation is about the axes produced by the previous one (intrinsic rotations), and positive
    --- angles follow the right-hand rule.
    fromEuler: ((rx: number, ry: number, rz: number, order: EnumRotationOrder?) -> CFrame),
    --- Returns a rotation of `angle` radians about `axis`, by the right-hand rule, at the origin. The
    --- length of the axis is ignored.
    fromAxisAngle: ((axis: vector, angle: number) -> CFrame),
    --- Returns a `CFrame` at `position` with the rotation of the quaternion `(qx, qy, qz, qw)`, with w
    --- last. The quaternion is normalized.
    fromQuaternion: ((position: vector, qx: number, qy: number, qz: number, qw: number) -> CFrame),
    --- Returns a `CFrame` from a position and three axes. The third axis is the back direction, so
    --- `LookVector` is `-back`. The axes are stored as given, even if they are not unit length or not
    --- perpendicular; call `Orthonormalize` to correct them.
    fromMatrix: ((position: vector, right: vector, up: vector, back: vector) -> CFrame),
    identity: CFrame,
}

declare Color3: {
    --- Returns a color from three channels in the range 0 to 1. Each defaults to 0, so `Color3.new()`
    --- is black. Values outside the range are kept.
    new: ((r: number?, g: number?, b: number?) -> Color3),
    --- Returns a color from three channels in the range 0 to 255, as color pickers show them. Each
    --- channel is divided by 255.
    fromRGB: ((r: number, g: number, b: number) -> Color3),
    --- Returns a color from hue, saturation and value, each from 0 to 1. The hue is also 0 to 1, not
    --- degrees: `fromHSV(1/3, 1, 1)` is green.
    fromHSV: ((h: number, s: number, v: number) -> Color3),
    --- Returns a color from a hexadecimal string. It accepts `#rrggbb`, `rrggbb`, `#rgb` and `rgb`, in
    --- upper or lower case. Raises an error for any other string.
    fromHex: ((hex: string) -> Color3),
}

declare Vector2: {
    --- Returns a vector with the given components. Each defaults to 0.
    new: ((x: number?, y: number?) -> Vector2),
    zero: Vector2,
    one: Vector2,
}

declare UDim: {
    --- Returns a `UDim` with the given scale and offset. Each defaults to 0.
    new: ((scale: number?, offset: number?) -> UDim),
}

declare UDim2: {
    --- Returns a `UDim2` from four numbers: the X scale, the X offset, the Y scale and the Y offset.
    new: ((xs: number?, xo: number?, ys: number?, yo: number?) -> UDim2),
    --- Returns a `UDim2` with the given scales and zero offsets, for a size or position relative to the
    --- parent.
    fromScale: ((xs: number?, ys: number?) -> UDim2),
    --- Returns a `UDim2` with the given offsets in pixels and zero scales, for a fixed size or
    --- position.
    fromOffset: ((xo: number?, yo: number?) -> UDim2),
}

declare Rect: {
    --- Returns a rectangle from its two corners.
    new: ((min: Vector2, max: Vector2) -> Rect),
}

declare ColorSequenceKeypoint: {
    --- Returns a stop at `time`, which must be from 0 to 1.
    new: ((time: number, color: Color3) -> ColorSequenceKeypoint),
}

declare ColorSequence: {
    --- Returns a sequence of one color from start to end.
    new: ((color: Color3) -> ColorSequence) & ((from: Color3, to: Color3) -> ColorSequence) & ((keypoints: { ColorSequenceKeypoint }) -> ColorSequence),
}

declare NumberSequenceKeypoint: {
    --- Returns a stop at `time`, which must be from 0 to 1.
    new: ((time: number, value: number, envelope: number?) -> NumberSequenceKeypoint),
}

declare NumberSequence: {
    --- Returns a sequence of one number from start to end.
    new: ((value: number) -> NumberSequence) & ((from: number, to: number) -> NumberSequence) & ((keypoints: { NumberSequenceKeypoint }) -> NumberSequence),
}

declare Random: {
    --- Returns a generator seeded with `seed`, truncated to an integer. With no seed, a seed is taken
    --- from the system and the sequence is different on every run. Do not use an unseeded generator in
    --- simulation code; `ludwerk check` reports it. Use one only for effects that do not affect
    --- gameplay.
    new: ((seed: number?) -> Random),
}

declare RaycastParams: {
    --- Returns params from a table of options. `Filter` defaults to an empty list, `FilterType` to
    --- `Exclude` and `CollisionGroup` to an empty string, which means every group. An empty `Exclude`
    --- filter hits everything, and an empty `Include` filter hits nothing.
    new: ((options: { Filter: { Instance }?, FilterType: EnumRaycastFilterType?, CollisionGroup: string? }?) -> RaycastParams),
}

declare Signal: {
    --- Returns a new signal owned by the script. The argument types are inferred from the calls to
    --- `Fire` and `Connect`; annotate the type, as in `Signal<string>` or `Signal<()>`, where they
    --- cannot be inferred.
    new: (<T...>() -> Signal<T...>),
}

declare Collector: {
    --- Returns a new, empty `Collector`.
    new: (() -> Collector),
}

declare Promise: {
    --- Returns a promise that runs `executor(resolve, reject, onCancel)` immediately, in its own
    --- thread.
    new: ((executor: (resolve: (...any) -> (), reject: (...any) -> (), onCancel: (hook: (() -> ())?) -> boolean) -> ()) -> Promise),
    --- Returns a promise like `new`, except that the executor runs at the next resumption point instead
    --- of immediately.
    defer: ((executor: (resolve: (...any) -> (), reject: (...any) -> (), onCancel: (hook: (() -> ())?) -> boolean) -> ()) -> Promise),
    --- Returns a promise that is already resolved with the given values.
    resolve: ((...any) -> Promise),
    --- Returns a promise that is already rejected with the given values.
    reject: ((...any) -> Promise),
    --- Returns a promise for the call `fn(...)`. What the function returns resolves the promise, and an
    --- error it raises rejects it.
    try: ((fn: (...any) -> ...any, ...any) -> Promise),
    --- Returns a promise that resolves after `seconds` of simulation time, with `seconds` as its value.
    delay: ((seconds: number) -> Promise),
    --- Returns a promise that resolves with every value, in order, when all the promises resolve. It
    --- rejects with the first rejection and cancels the others.
    all: ((promises: { Promise }) -> Promise),
    --- Returns a promise that resolves when every promise has settled, with the final status of each.
    allSettled: ((promises: { Promise }) -> Promise),
    --- Returns a promise that settles the way the first of the promises to settle does, and cancels the
    --- others.
    race: ((promises: { Promise }) -> Promise),
    --- Returns a promise that resolves with the value of the first promise to resolve. It rejects if
    --- all of them reject.
    any: ((promises: { Promise }) -> Promise),
    --- Returns a promise that resolves with the values of the first `count` promises to resolve. It
    --- rejects as soon as that many can no longer resolve.
    some: ((promises: { Promise }, count: number) -> Promise),
    --- Returns a promise that resolves with the arguments of the next fire of a signal that `predicate`
    --- accepts, and then disconnects from the signal.
    fromEvent: ((event: Signal<...any>, predicate: ((...any) -> boolean)?) -> Promise),
    --- Returns a promise for `fn(...)`, like `try`, that calls the function again up to `times` more
    --- times while it rejects.
    retry: ((fn: (...any) -> ...any, times: number, ...any) -> Promise),
    --- Returns a promise like `retry`, with `seconds` of simulation time before each new attempt.
    retryWithDelay: ((fn: (...any) -> ...any, times: number, seconds: number, ...any) -> Promise),
    --- Returns whether `value` is a `Promise`.
    is: ((value: any) -> boolean),
    --- Returns a function that calls `fn` and returns a promise for its result.
    promisify: ((fn: (...any) -> ...any) -> (...any) -> Promise),
}

declare TweenInfo: {
    --- Returns a `TweenInfo`. The defaults are one second, `Quad`, `Out`, no repeat, no reverse and no
    --- delay. Raises an error for a negative `time` or `delayTime`. A negative `repeatCount` repeats
    --- forever.
    new: ((time: number?, easingStyle: EnumEasingStyle?, easingDirection: EnumEasingDirection?, repeatCount: number?, reverses: boolean?, delayTime: number?) -> TweenInfo),
}

declare Material: {
    --- Returns the shared, read-only handle of a material file, as in
    --- `Material.load("asset://materials/brick.material.json")`. Raises an error if the path is not a
    --- material.
    load: ((content: Content) -> Material),
}

declare task: {
    --- Runs `fn` in a new coroutine immediately, before `spawn` returns, and returns that coroutine. An
    --- error inside it does not reach the caller.
    spawn: (<T...>(fn: (T...) -> (), T...) -> thread),
    --- Queues `fn` to run in a new coroutine at the next resumption point, in order with deferred
    --- signal handlers. Returns the coroutine, which can be passed to `task.cancel`.
    defer: (<T...>(fn: (T...) -> (), T...) -> thread),
    --- Runs `fn` in a new coroutine after at least `duration` seconds of simulation time. A duration of
    --- 0 or less means the next tick; the function never runs before `delay` returns.
    delay: (<T...>(duration: number, fn: (T...) -> (), T...) -> thread),
    --- Yields the current coroutine for at least `duration` seconds of simulation time, or until the
    --- next tick if no duration is given. Returns the simulation time that passed, which is a whole
    --- number of ticks.
    wait: ((duration: number?) -> number),
    --- Cancels a coroutine that is scheduled to resume, such as one returned by `task.defer` that has
    --- not run yet. Raises an error for a coroutine that has finished, has already been canceled or is
    --- the one running.
    cancel: ((thread: thread) -> ()),
}

