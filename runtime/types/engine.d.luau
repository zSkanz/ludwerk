    function SendMessage(self, topic: string, ...: any): ()
    --- Runs `callback` with a message's values each time one is sent to this scene under `topic`. It
    --- belongs to the script that bound it and goes with that script's scene. A message nobody listens
    --- to is dropped, with a warning in the editor. Raises on a scene that has closed.
    function BindToMessage(self, topic: string, callback: (...any) -> ()): ()
end

declare extern type SceneLoad with
    --- The scene being prepared. A message sent to it waits until it opens and its scripts have
    --- started, and is delivered before `SceneLoaded`.
    read Scene: Scene
    --- The content-relative path of the scene's file.
    read Path: string
    --- From 0 to 1, and it only rises: half for the file read and parsed, the rest for the meshes it
    --- names, as each is loaded. 1 when `Ready` fires.
    read Progress: number
    --- Where the load is: `Preparing`, `Ready`, `Activating`, then `Done` -- or `Failed` or
    --- `Cancelled`.
    read Status: EnumSceneLoadStatus
    --- Why it failed, when `Status` is `Failed`; nil otherwise.
    read Error: string?
    --- Fires once, when the scene is prepared and waiting to be activated.
    read Ready: Signal<>
    --- Fires once, at the end: true when the scene opened, false when the load failed or was cancelled.
    read Finished: Signal<boolean>
    --- Switches to the scene now if it is ready, or as soon as it is. Raises on a load that failed or
    --- was cancelled.
    function Activate(self): ()
    --- Drops what was prepared, and `Finished` fires with false. Nothing once the switch has begun.
    function Cancel(self): ()
end

declare extern type InputObject with
    --- What kind of input this is. The coarse question, for a handler that does not care which key.
    read UserInputType: EnumUserInputType
    --- Which key, button or axis. `Unknown` for pointer motion and the wheel, which are not keys -- and
    --- `Unknown` is a real item rather than nil precisely so this property never has to be checked
    --- before it is compared.
    read KeyCode: EnumKeyCode
    --- Where the pointer is, in window pixels with the origin at the top left, with `z` carrying the
    --- accumulated wheel. For a gamepad axis it is the deflection instead: `x` and `y` for a stick, `x`
    --- alone for a trigger. A three-wide vector rather than a `Vector2` because `vector` is this
    --- engine's native primitive (ADR 0013) -- it costs no userdata and no allocation, which matters on
    --- a value produced several times a tick.
    read Position: vector
    --- How much it moved since the last tick, in the same units as `Position`. `z` is the wheel
    --- movement, which is where a `MouseWheel` event puts its one number. Zero for anything that is not
    --- motion.
    read Delta: vector
    --- Which finger, for a `Touch` input: the same number from its `InputBegan` to its `InputEnded`, so
    --- a handler follows two thumbs at once. Counted from 1, and reused once a finger lifts. Zero for
    --- anything that is not a touch.
    read TouchId: number
end

declare extern type IntentWriter with
    --- This tick's intent named `action`: a boolean is pressed or not, a number is one axis, a
    --- `Vector2` two and a `vector` three. A value that is not finite is refused.
    function Set(self, action: string, value: boolean | number | Vector2 | vector): ()
end

declare extern type PredictedStep with
    --- The character being stepped: its player's `Character` on this machine.
    read Character: BasePart
    --- Whose character it is.
    read Player: Player
    --- The player's own tick: the number their machine gave the tick of input this step takes, the same
    --- on the authority and on their replica. What a dash that lasts twenty ticks counts in.
    read Tick: number
    --- The step's length, in seconds.
    read DeltaTime: number
    --- Whether this is a step taken again after a correction, on a replica. What only happens once -- a
    --- sound, a particle -- checks it.
    read Replaying: boolean
    --- A generator seeded by the player and `Tick`: the same draws live and stepped again, on both
    --- ends. Each read starts it again; keep it in a local.
    read Random: Random
    --- The player's intent named `action` at this tick, as `Player:GetIntent` answers it -- stepped
    --- again, the one the tick first had.
    function GetIntent(self, action: string): boolean | number | Vector2 | vector
    --- Whether the button `action` went down at this tick: held now and not at the step before.
    function Pressed(self, action: string): boolean
end

declare extern type AnimationTrack with
    --- Whether the clock is advancing. False for a track that reached the end of a clip that is not
    --- `Looped` -- which still HOLDS its last frame until it is stopped or replayed, because `Ended` is
    --- deferred and a character that returned to its rest pose for the one tick before the handler ran
    --- would be a visible pop.
    read Playing: boolean
    --- Whether reaching the end wraps to the start instead of stopping. A looped track never fires
    --- `Ended`, because it never does. Wrapping keeps the fraction of a tick it overshot by, so a loop
    --- does not drift against everything else in the scene.
    Looped: boolean
    --- How fast the clip's clock runs. 2 is twice the speed and half the duration; 0 holds the pose
    --- where it is, which is the honest way to freeze a frame.
    Speed: number
    --- How much this track contributes when several drive one skeleton. Assigning it is immediate --
    --- the faded form is `Play`'s and `Stop`'s argument, and a property that took a fade time would not
    --- be a property. Blending is a weighted average PER JOINT and per component, so a joint no clip
    --- drives keeps its rest transform rather than being dragged towards the origin by tracks that say
    --- nothing about it.
    Weight: number
    --- The clip's duration in seconds, or zero for a track whose clip was not found.
    read Length: number
    --- Where the clip's clock is, in seconds. Read-only in v1: seeking a blended pose is a different
    --- feature from playing one, and a writable seek that ignored the blend would be the wrong half of
    --- it.
    read TimePosition: number
    --- Fires on the tick a track reaches the end of a clip that is not `Looped`. A PROPERTY here rather
    --- than an event because a track is not a class and only classes declare events; the signal it
    --- holds behaves like any other. A `Stop` does not fire it: it is a past-tense fact about reaching
    --- the end, and code that chains the next animation on it must not be fooled by one that was
    --- interrupted.
    read Ended: Signal<>
    --- Starts the clip from the BEGINNING, every time -- the opposite of `Tween:Play`, and
    --- deliberately: a jump animation triggered twice should play twice. `fadeTime` fades the weight in
    --- from zero over that many seconds, which is what makes a walk blend into an idle rather than
    --- snapping. It fades in to this track's own `Weight`, which is why one argument is enough.
    function Play(self, fadeTime: number?): ()
    --- Ends the track. `fadeTime` fades its weight out over that many seconds and stops it when it
    --- reaches zero; without one it stops on the spot. `Ended` does not fire either way.
    function Stop(self, fadeTime: number?): ()
end

declare extern type Material with
    --- The material asset this handle is, or the asset a clone was copied from -- a clone of a clone
    --- included. Always an asset's `Content`: a clone has nothing else to be named by.
    read Source: Content
    --- The base tint, multiplied into `ColorMap` if there is one. White with no map is a plain white
    --- surface.
    Color: Color3
    --- How see-through the surface is, 0 opaque and 1 invisible.
    Transparency: number
    --- The base-colour image, sampled and multiplied by `Color`. Colour data, encoded through the sRGB
    --- curve -- unlike the maps below, which are numbers.
    ColorMap: Content
    --- A tangent-space normal map. Linear data, not colour.
    NormalMap: Content
    --- Occlusion, roughness and metalness in one image's R, G and B -- glTF's packing, and one property
    --- because they are one file. Linear data, not colour.
    MetallicRoughnessMap: Content
    --- Light the surface gives off on its own. It lights nothing else -- that is a `PointLight` -- it
    --- only makes this surface bright.
    Emissive: Color3
    --- What the surface glows with, multiplied by `Emissive`. Colour data.
    EmissiveMap: Content
    --- 0 is a dielectric -- plastic, stone, wood -- and 1 is bare metal.
    Metalness: number
    --- 0 is a mirror and 1 is chalk. The default is 0.7, what an untextured building block looks like.
    Roughness: number
    --- Scales the sampled normal's XY. One is the map as authored; zero is a flat surface.
    NormalScale: number
    --- How alpha is read: `Opaque` ignores it, `Mask` is a coverage test against `AlphaCutoff`, and
    --- `Blend` blends.
    AlphaMode: EnumAlphaMode
    --- What `Mask` tests against. Read only in that mode.
    AlphaCutoff: number
    --- Whether the back faces are drawn. Leaves and cloth want this; anything solid does not.
    DoubleSided: boolean
    --- How big one repeat of the textures is on a part's faces, in metres: a face shows as many repeats
    --- as it is long, so a long, thin slab has the texture at one scale on its top and its edges. 0
    --- stretches each texture over the whole face. A `MeshPart` keeps its file's own UVs. A terrain
    --- layer repeats at this size too.
    TileSize: number
    --- A height image for a terrain layer, white high: where two layers meet, the higher one shows
    --- through. Read only by a terrain.
    HeightMap: string
    --- Whether a terrain layer is projected from three axes, so a cliff is textured rather than
    --- smeared. On by default; read only by a terrain.
    Triplanar: boolean
    --- How hard the edge is where this terrain layer meets another, from 0 (a wide fade) to 1 (a sharp
    --- line along the height map). Read only by a terrain.
    BlendSharpness: number
    --- How much a pattern tens of metres across varies a terrain layer's colour, from 0 (none) to 1, so
    --- its repeat does not read as a grid. 0.5 by default; read only by a terrain.
    TilingVariation: number
    --- How many times larger the second sample of a terrain layer's textures is, blended in with
    --- distance, from 1 (none) to 32. 6 by default; read only by a terrain.
    TilingFarScale: number
    --- Whether a terrain layer's textures are laid on a hexagonal grid of cells, each offset and turned
    --- at random with their borders blended -- for a photograph, whose repeat shows most. Three reads
    --- of each texture instead of one; off by default; read only by a terrain.
    HexTiling: boolean
    --- How much a body touching this surface resists sliding. A part wearing the material collides with
    --- it unless the part's own `Friction` says otherwise, and so does the ground where a terrain draws
    --- the material. 0.3 by default -- what everything collided with before a material said anything --
    --- and ice is slippery by being ice.
    Friction: number
    --- How much of its speed a body keeps when it bounces off this surface, from 0 (it lands dead) to
    --- 1. 0 by default.
    Restitution: number
    --- The sound a foot makes on this surface: a sound's content, or empty. The engine does not play
    --- it. A game does, from `CharacterBody.FloorMaterial`, at the pace its character walks.
    FootstepSound: Content
    --- Words a game reads off a surface -- "slippery", "metal", "lava" -- in the order the material
    --- wrote them. A fresh table each time it is read.
    Tags: { string }
    --- A writable runtime copy: the same properties, the same `Source`, owned by nobody and never
    --- saved. Put it on a part with `part.Material = copy`, then change it -- every part wearing this
    --- copy changes with it, and nothing else does.
    function Clone(self): Material
    --- A parameter of the surface shader this material names (ADR 0091), as the material sets it: a
    --- number, a `Vector2`, a `vector` (a colour reads as one), four numbers in a table, or a texture's
    --- URN. `nil` when the material leaves it to the shader's own default.
    function GetShaderParameter(self, name: string): (number | Vector2 | vector | { number } | string)?
    --- Sets a parameter of the surface shader, on a clone -- a loaded material is shared and read-only,
    --- as it is for the built-in fields. A string is a texture's URN. Every part wearing the clone
    --- draws with the new value from the next frame. **Not replicated**: a clone's shader parameters
    --- are this machine's; set them where the part is drawn.
    function SetShaderParameter(self, name: string, value: number | boolean | Vector2 | vector | Color3 | { number } | string): ()
end

declare extern type Instance with
    --- This instance's name; siblings may share one, and renaming into an awaited name satisfies a
    --- WaitForChild waiter exactly as parenting a new child does.
    Name: string
    --- The instance this one hangs under, nil when unparented; assigning it appends this instance last
    --- among its new siblings, assigning the current parent again changes nothing, and assigning after
    --- Destroy raises.
    Parent: Instance?
    --- The name of this instance's class; typeof answers Instance whatever the class, so this is what
    --- tells two classes apart.
    read ClassName: string
    --- Fired after an instance is parented to this one, carrying that child.
    read ChildAdded: Signal<Instance>
    --- Fired after an instance stops being parented to this one, carrying that child.
    read ChildRemoved: Signal<Instance>
    --- Fired after an instance is added anywhere below this one, carrying that descendant.
    read DescendantAdded: Signal<Instance>
    --- Fired as an instance leaves the subtree below this one, carrying that descendant; leaving is
    --- fully observed before arriving.
    read DescendantRemoving: Signal<Instance>
    --- Fired on a moved instance and then on each of its descendants in document order, carrying the
    --- instance whose ancestry changed and its new parent, nil when it was unparented.
    read AncestryChanged: Signal<Instance, Instance?>
    --- Fired when any attribute of this instance changes, carrying the attribute name.
    read AttributeChanged: Signal<string>
    --- Fired once when Destroy is called, carrying nothing; the tree mutation has already happened and
    --- only the signal is deferred.
    read Destroying: Signal<()>
    --- The first direct child with that name in document order, or nil; there is no recursive form in
    --- v1, so depth is a GetDescendants loop.
    function FindFirstChild(self, name: string): Instance?
    --- The first direct child whose ClassName is exactly className, or nil; asking for BasePart
    --- therefore never finds a Part.
    function FindFirstChildOfClass(self, className: string): Instance?
    --- The first direct child that IsA className, or nil; matching runs through the class hierarchy, so
    --- abstract base names are accepted.
    function FindFirstChildWhichIsA(self, className: string): Instance?
    --- The nearest ancestor with that name, searching upward from Parent; the instance itself is never
    --- a candidate.
    function FindFirstAncestor(self, name: string): Instance?
    --- The nearest ancestor whose ClassName is exactly className, searching upward from Parent; the
    --- instance itself is never a candidate.
    function FindFirstAncestorOfClass(self, className: string): Instance?
    --- The path to the instance, as the names of its ancestors and its own joined by dots:
    --- `Workspace.Recursos.Tree.Trunk`. It starts below the data model, as a script's own path from
    --- `game` does. For reading in a log -- two siblings may share a name, so it does not say which of
    --- them this is.
    function GetFullName(self): string
    --- A fresh array of the direct children in child order, which is the order they were parented; the
    --- caller owns it, so destroying while iterating is safe.
    function GetChildren(self): {Instance}
    --- A fresh array of every descendant in document order -- child order taken depth-first, preorder
    --- -- which is the order the Find family tie-breaks on.
    function GetDescendants(self): {Instance}
    --- Parks the caller until a child of that name exists here and returns it, returning immediately
    --- when one already does; with a timeout, expiry returns nil, and without one the wait is unbounded
    --- and warns after five sim-seconds.
    function WaitForChild(self, name: string, timeout: number?): Instance?
    --- Whether this instance is of that class or descends from it; a string naming no class answers
    --- false rather than raising, because the point is to test names you do not trust.
    function IsA(self, className: string): boolean
    --- Whether descendant sits anywhere below this instance; read strictly, so an instance is not its
    --- own ancestor. False when either is destroyed, so a check needs no pcall.
    function IsAncestorOf(self, descendant: Instance): boolean
    --- Whether this instance sits anywhere below ancestor; read strictly, so an instance is not its own
    --- descendant. False when either is destroyed, so a check needs no pcall.
    function IsDescendantOf(self, ancestor: Instance): boolean
    --- The stamp a linked copy was placed from, as its content path (`stamps/fighter.stamp.json`), or
    --- nil for anything else, a copy placed unlinked included (ADR 0155). A copy's parameters are its
    --- attributes.
    function GetStamp(self): string?
    --- Deep-copies this subtree unparented -- children, properties, attributes and tags at every depth
    --- -- rewiring object references that point inside the copy and leaving those that point outside it
    --- on the originals.
    function Clone(self): Instance
    --- Removes this instance and its children from the tree synchronously, clears its tags, locks
    --- Parent to nil and defers Destroying; the handle stops resolving at the end of that drain. After
    --- that, Parent still reads nil and IsDescendantOf and IsAncestorOf answer false -- what defensive
    --- code asks -- while Name, ClassName and IsA raise, the instance's data being gone.
    function Destroy(self): ()
    --- The value of that attribute, or nil when it has never been set; attribute names are
    --- case-sensitive.
    function GetAttribute(self, name: string): (string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence)?
    --- Sets that attribute, or removes it when value is nil; a table, an Instance or a function raises
    --- and leaves any previous value in place, and an empty name raises.
    function SetAttribute(self, name: string, value: (string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence)?): ()
    --- A fresh table of this instance's attributes, which the caller owns.
    function GetAttributes(self): { [string]: string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence }
    --- The signal fired when that attribute changes; any name is accepted, because an attribute that
    --- has never been set is a reasonable thing to wait for.
    function GetAttributeChangedSignal(self, name: string): Signal<()>
    --- The signal fired when that property changes -- the same object on every call, carrying no value
    --- so its type stays independent of the property's; a name the class does not have raises.
    function GetPropertyChangedSignal(self, name: string): Signal<()>
    --- Adds a tag to this instance, a no-op when it is already present; tags are pure instance state,
    --- so a nil-parented instance still carries and is found by them.
    function AddTag(self, tag: string): ()
    --- Removes a tag from this instance, a no-op when it is absent.
    function RemoveTag(self, tag: string): ()
    --- Whether this instance currently carries that tag.
    function HasTag(self, tag: string): boolean
    --- A fresh array of this instance's tags, which the caller owns.
    function GetTags(self): {string}
end

declare extern type PVInstance extends Instance with
    --- Where this object's pivot sits relative to the object itself; the identity puts it at the
    --- centre. Set it to a hinge edge and PivotTo rotates about that edge.
    PivotOffset: CFrame
    --- This object's pivot in world space.
    function GetPivot(self): CFrame
    --- Moves this object so its pivot lands on target. A Model moves every part under it and keeps
    --- their relative layout; a BasePart or Camera moves itself.
    function PivotTo(self, target: CFrame): ()
end

declare extern type Folder extends Instance with
end

declare extern type Model extends PVInstance with
    --- The part this model's pivot follows; Clone rewires it to the copy, since it is the reference
    --- into a cloned subtree that catches people.
    PrimaryPart: BasePart?
    --- What this model does when the world is partitioned into a streaming grid (ADR 0053). It is the
    --- one thing a person says about a world they built by hand: the grid decides WHEN something
    --- becomes eligible, and this decides WHAT comes with it. **The default changes nothing.**
    --- `Nonatomic` places each part in the cell its own position falls in, which is how a world of
    --- loose scenery already behaves. `Atomic` makes the model one unit that lives in a single cell
    --- however far it spreads, and `Persistent` keeps it out of the grid entirely so it is always
    --- there. It is read when the world is partitioned, not every frame: changing it at run time
    --- changes nothing until the world is built again.
    StreamingMode: EnumStreamingMode
    --- How big this model is relative to the size it was built at. Setting it resizes every part under
    --- the model and moves each one about the model's pivot, so the whole thing grows in place rather
    --- than drifting away from where it stood. **It is absolute, not cumulative.** Setting 2 twice
    --- leaves the model twice its built size, not four times -- the write scales by the ratio between
    --- the new value and the old one. Setting 1 puts it back exactly. **A descendant added afterwards
    --- is not scaled.** The write fans out once over what is there and then it is done: nothing is
    --- multiplied by this per frame, which is what makes a scaled model cost the same to draw and
    --- simulate as an unscaled one. Parent the part first, then scale. Zero and negative values are
    --- refused. A part with no size is not a small part, it is a shape the solver cannot build.
    Scale: number
    --- The size in metres of the smallest box enclosing every part in this model.
    function GetExtentsSize(self): vector
end

declare extern type BaseScript extends Instance with
    --- The Luau this instance carries. It is data on the instance rather than a path to a file, which
    --- is what makes a script something you can create, copy, put inside a prefab and save in a scene
    --- like anything else. **The editor writes it, and a script only reads it** (ADR 0137): a script
    --- that could write another's `Source` and enable it would run text the sandbox never loaded. A
    --- script made at run time takes its code from a copy -- `Clone` of one in the scene, or
    --- `Instance.stamp`.
    read Source: string
end

declare extern type Script extends BaseScript with
    --- **Whether this script's threads are resumed.** It decides nothing else (ADR 0059). False at the
    --- moment scripts start means this one never starts. Writing it afterwards takes effect at the next
    --- deferred drain: **false to true STARTS it**, on its own coroutine, file scope running now
    --- against the world as it is -- a start and not a resume, so a script that ran, was disabled and
    --- is enabled again runs its file scope a second time. **True to false stops resumption**, and that
    --- is all it does: a queued `task.defer`, a `task.delay` coming due and a signal fire are all
    --- discarded when they come up, and a thread already executing runs to its next yield, because a
    --- coroutine cannot be preempted. **Connections are NOT disconnected**, nothing it made is undone
    --- and nothing it built is removed. They stop being invoked because nothing resumes the threads
    --- that would run them; disconnect them yourself if that is what you need. Anything larger would
    --- answer whether a connection dies with the thing its closure captured, which is a separate
    --- question and not one a property setter may decide. Several scripts enabled by one tick start in
    --- document order.
    Enabled: boolean
    --- **Where this script runs, outside the script services** (ADR 0138): `Server` on the authority,
    --- `Client` where a player sits, `Shared` on both -- once per machine, so a solo game runs a
    --- `Shared` script once. Inside `ServerScriptService`, `ClientScriptService` or
    --- `GlobalScriptService`'s `Server` and `Client` folders **the service decides**, and moving a
    --- script into one writes the service's side here: server code taken back out stays server code. A
    --- package leaves out the code of every script whose side never runs there -- the instance stays,
    --- with no `Source` -- so a stamp can carry a server half and a client half and each machine gets
    --- its own. **The editor writes it, and a script only reads it**: the side was fixed when the
    --- package was made.
    read RunContext: EnumRunContext
end

declare extern type ModuleScript extends BaseScript with
end

declare extern type BasePart extends PVInstance with
    --- This part's transform in world space, and the f64 source of truth Position and Orientation are
    --- read back from.
    CFrame: CFrame
    --- This part's world position, the f32 rounding of the CFrame translation; gameplay math past a few
    --- kilometres from the origin belongs on CFrame instead.
    Position: vector
    --- This part's world rotation as intrinsic YXZ euler angles in degrees.
    Orientation: vector
    --- This part's dimensions in metres along its own axes.
    Size: vector
    --- The material this part wears: a handle to a material asset (`Material.load`), a runtime copy of
    --- one (`material:Clone()`), or nothing -- which is the engine default material, white, dielectric
    --- and fairly rough, and exactly what a plain part has always looked like. **A part has no colour
    --- of its own** (ADR 0090). Its look is its material's, and what it may change about that is what
    --- the material lets it: the parameters the material declares, set with `SetMaterialParameter`. The
    --- engine default declares `Color` and `Transparency`, so a part wearing nothing is still tinted
    --- and faded. **Reading it never copies.** It returns the handle the part wears; `material:Clone()`
    --- is how to get one to change. In a scene file it is written as the asset's `Content`. A
    --- `MeshPart` with no material draws what its own file described, and a `Color` it overrides tints
    --- that -- which is what an unimported mesh has always looked like.
    Material: Material?
    --- The parameters this part overrides, by name -- a fresh table on every read, holding only what is
    --- overridden. The names are the closed set a material may declare: `Color`, `Transparency`,
    --- `Emissive`, `Metalness`, `Roughness`, `NormalScale` and `AlphaCutoff`. **An override the current
    --- material does not declare is kept and ignored**, so a part that changes material and changes
    --- back looks as it did. `SetMaterialParameter` is the checked way to write one; assigning this
    --- property replaces the whole set and checks only that every entry is a parameter with a value of
    --- its kind.
    MaterialParameters: MaterialParameters
    --- Whether the part casts a shadow -- into the sun's shadow and every lamp's. Off for what is light
    --- or has no weight in the scene: a muzzle flash, a blade's trail, a pickup's glow, a ring on the
    --- ground under a boss. It changes only what the part casts: a part with this off is still drawn,
    --- still lit, and still receives the shadows of others. A part that is see-through casts none
    --- whatever this says, and a hidden one draws nothing at all.
    CastShadow: boolean
    --- Whether a `Decal` paints this part. A decal projects onto everything inside its box; off, the
    --- part is left as it is by every one of them -- a character standing on a scorch mark, an enemy
    --- inside a warning ring on the ground, a door a puddle would otherwise climb. It changes only what
    --- is painted ON the part: the decal still paints the ground round it and under it. Terrain always
    --- receives.
    ReceivesDecals: boolean
    --- Whether the simulation moves this part. An anchored part is immovable scenery that other parts
    --- collide with and gravity ignores -- not a very heavy part, a different kind of body -- so
    --- writing this rebuilds it in the simulation and keeps its transform.
    Anchored: boolean
    --- Whether this part physically stops anything. A part with this off still reports Touched, which
    --- is what makes a checkpoint, a trigger volume or a pickup work: things pass through it and it
    --- notices.
    CanCollide: boolean
    --- Whether this part takes part in touch reporting at all. **It gates the PAIR**: a part with this
    --- off is silent, and so is whatever touches it -- because a signal naming a part that said not to
    --- report touches would be that part reporting one on somebody else's handler. That is the
    --- difference from CanQuery, which is about one part being found and is therefore one part's
    --- decision. Off is what a world full of scenery wants: contacts are still solved, and nothing is
    --- queued for scripts that were never going to listen.
    CanTouch: boolean
    --- Whether raycasts, shapecasts and box queries can see this part. Independent of CanCollide,
    --- because a part that blocks movement and a part a camera ray should ignore are different
    --- questions.
    CanQuery: boolean
    --- Whether a `Water` holds it up (ADR 0118): the engine pushes an unanchored part in water up by
    --- the water it displaces, at points over its shape, so a hull pitches and rolls, and drags it by
    --- the water's `Viscosity`. Off, the water ignores it -- a game floating it its own way, or a
    --- stone.
    Buoyant: boolean
    --- The named group deciding which other parts this one collides with, registered through
    --- `PhysicsService:RegisterCollisionGroup`. An unregistered name is an error rather than a silent
    --- fallback to Default: the failure mode of a typo here is a wall players walk through, which is
    --- expensive to find and cheap to refuse.
    CollisionGroup: string
    --- How much this surface resists sliding, 0 frictionless and 1 very grippy. The value the solver
    --- uses for a contact combines both surfaces' -- one slippery part is enough to make a pair slide.
    Friction: number
    --- How much of an impact this surface gives back, 0 a dead stop and 1 a perfect bounce. Combined
    --- across a contact pair the same way Friction is.
    Restitution: number
    --- Mass per cubic metre. Mass is this times the volume the Size and Shape describe, which is why
    --- `Mass` can be read and not written: the two cannot be set to contradict each other.
    Density: number
    --- What the part weighs, in kilograms: `Density` times the volume of its shape, as the simulation
    --- worked it out. An impulse is this times a change of speed.
    read Mass: number
    --- The mass of this part and of everything rigidly joined to it by welds and `FixedConstraint`s:
    --- what has to be moved to move it.
    read AssemblyMass: number
    --- The share of its speed a part loses each second with nothing touching it. Zero keeps moving for
    --- ever; one is thick air.
    LinearDamping: number
    --- The same for its spin.
    AngularDamping: number
    --- Whether `Collided` fires for this part. Off by default, so a world of scenery pays nothing for a
    --- signal nobody listens to.
    ContactDetails: boolean
    --- How fast this part is moving, in metres per second, as of the last simulation tick. Writing it
    --- sets the speed the next tick starts from: a ball served, a thing stopped dead. To push rather
    --- than to set, `ApplyImpulse`.
    LinearVelocity: vector
    --- How fast this part is spinning, in radians per second about each world axis, as of the last
    --- simulation tick. Writable, as `LinearVelocity` is.
    AngularVelocity: vector
    --- Fires once when another part begins touching this one, with the part it touched. Deferred like
    --- every signal here (ADR 0015), so it arrives at the next resumption point rather than inside the
    --- solver. A pair that stays in contact fires once, not once per tick -- including across the
    --- moment the simulation puts both parts to sleep.
    read Touched: Signal<BasePart>
    --- Fires with `Touched`, for a part whose `ContactDetails` is on, and says what the contact was:
    --- where in the world, the direction from this part into the other, and how fast the two were
    --- closing along it when they met, in metres a second -- before the simulation answered. How hard a
    --- blow was is that speed times what was moving.
    read Collided: Signal<BasePart, vector, vector, number>
    --- Fires when a pair that was touching stops. Destroying a part does NOT fire it for that part's
    --- contacts: the instance is gone, and a signal on an instance nobody can reach is a signal nobody
    --- can handle.
    read TouchEnded: Signal<BasePart>
    --- Overrides one parameter of the material this part wears, for this part alone. **Raises for a
    --- parameter the material does not declare**: a material decides what a part may change about it,
    --- and a tint written to one that did not allow it would be a surface that silently ignores its
    --- script. `Color` and `Emissive` take a `Color3`; the rest take a number. A parameter of the
    --- material's surface shader, when the material lists it in `instanceParameters`, takes a number, a
    --- boolean, a `Vector2`, a `vector` or a `Color3`, or four numbers in a table -- not a texture,
    --- which would make the part a material of its own. **A surface shader parameter is not
    --- replicated**: set it where the part is drawn.
    function SetMaterialParameter(self, name: string, value: Color3 | number | boolean | Vector2 | vector | { number }): ()
    --- The value this part draws with for one parameter: its override when it has one the material
    --- declares, and the material's own value otherwise. `nil` for a surface shader parameter neither
    --- sets, which draws with the shader's own default.
    function GetMaterialParameter(self, name: string): (Color3 | number | Vector2 | vector | { number })?
    --- Removes this part's override of one parameter, so it draws with the material's value again.
    --- Clearing one that is not overridden does nothing.
    function ClearMaterialParameter(self, name: string): ()
    --- Hands this part to one player's machine (ADR 0099), which then simulates it and sends where it
    --- is: what that player pushes moves at once rather than a round trip later. `nil` hands it back to
    --- the authority. Only the authority may call it, and only on a part that is not anchored; a player
    --- who leaves gives back everything they owned. **What the owner sends is trusted** -- a game that
    --- must not trust it checks it, or does not hand the part over.
    function SetNetworkOwner(self, player: Player?): ()
    --- The player whose machine simulates this part, or `nil` for the authority. A replica knows only
    --- about itself: it answers its own `Player` for a part it owns, and `nil` otherwise.
    function GetNetworkOwner(self): Player?
    --- Adds an instantaneous change of momentum at the part's centre of mass, in kilogram-metres per
    --- second. Applied at the next simulation tick and ignored by an anchored part, which has no
    --- momentum to change.
    function ApplyImpulse(self, impulse: vector): ()
    --- Runs `fn(character, step)` **inside the simulation step** (ADR 0157) when a player's character
    --- this machine steps begins touching this part -- on a replica, again for every tick it steps over
    --- after a correction, exactly as `RunService:BindToPredictedStep` runs. What a jump pad, a booster
    --- or a trampoline does to who lands on it, predicted without a rubber band. Nothing runs while
    --- nobody touches it. One function a part: binding again replaces it. It may not wait.
    function BindToPredictedTouch(self, fn: (character: BasePart, step: PredictedStep) -> ()): ()
    --- Stops this part's predicted touch. Nothing bound is not an error.
    function UnbindFromPredictedTouch(self): ()
    --- **Where this is drawn this frame** (ADR 0136): between the last two ticks, as the picture shows
    --- it -- in a render phase, which is a `RunService:BindToRenderStep` function, a `PreRender`
    --- handler or an action at `Rate = Render`. Anywhere else -- a simulation phase, a run with no
    --- window, a server -- it is `CFrame`, because what a tick reads must not depend on when a frame
    --- happened. A camera that follows this reads it.
    function GetRenderCFrame(self): CFrame
    --- The same push, at a point in the world: off the centre it also turns the part, as a shove at a
    --- boat's bow swings it round (ADR 0118). Applied at the next tick.
    function ApplyImpulseAtPosition(self, impulse: vector, position: vector): ()
    --- An instantaneous change of angular momentum, about the axis it points along, in
    --- kilogram-square-metres per second: a twist with no push. Applied at the next tick.
    function ApplyAngularImpulse(self, impulse: vector): ()
end

declare extern type Part extends BasePart with
    --- Which primitive solid this part is. It drives BOTH the geometry that is drawn and the collider
    --- that is simulated, which is the point: a `Ball` that rolled like a box would be the kind of
    --- divergence nobody can see in a screenshot. **`Size` is the full extent, and two shapes read it
    --- slightly differently so that the mesh agrees with the collider.** A `Ball` is a sphere of the
    --- LARGEST half-extent, so a non-uniform `Size` gives a ball that sticks out of its own box rather
    --- than an ellipsoid you cannot collide with. A `Cylinder` and a `Capsule` stand along Y, take
    --- their diameter from the larger of X and Z, and take their full height from Y -- caps included. A
    --- capsule's caps are hemispheres the collider never stretches, so `Size.y == 2 * Size.x` is where
    --- the drawn shape and the simulated one agree exactly; away from it the drawn ends are slightly
    --- oval. A `Wedge` is a ramp with its tall face towards -Z, so an unrotated one is walked UP as you
    --- walk towards -Z. Its collider is deliberately the whole box (§2.2's physics notes).
    Shape: EnumPartShape
end

declare extern type MeshPart extends BasePart with
    --- The glTF file this part renders. Setting it replaces the geometry; a file that fails to import
    --- leaves the previous mesh in place and reports why, because a part that silently becomes
    --- invisible is harder to diagnose than one that says it could not load.
    MeshContent: Content
    --- How closely the collision shape follows the rendered geometry. `Box` names a shape rather than
    --- an accuracy and is honoured exactly: a caller who asked for the bounding box gets it even when
    --- the mesh's geometry is loaded. Every other value asks for the geometry, and what it gets is a
    --- CONVEX HULL -- a hull is what a rigid-body solver can use directly, and a concave triangle mesh
    --- is a different shape class with different rules (it cannot be dynamic) that nothing in v1 asks
    --- for. A mesh whose points have not arrived yet collides as its bounding box, which is the state
    --- of every `MeshPart` in the frame before its file finishes loading: a body with no shape for one
    --- frame is a body that falls through the floor. So does a mesh too degenerate to make a solid from
    --- -- three points are a triangle, not a hull. The property reads back what was written rather than
    --- what it resolved to, because a value that silently became another value is worse than one that
    --- says what it did.
    CollisionFidelity: EnumCollisionFidelity
    --- What the mesh measures at its authored size, in metres. `Size` divided by this is what the part
    --- is scaled by, so setting `Size` to twice `MeshSize` draws the mesh at twice its authored size
    --- and collides with a hull to match -- which is what makes `Size` mean the same thing here as it
    --- does on a `Part`. **The import writes it, and it is saved with the scene.** It is not read back
    --- off the file: the mesh's real bounds are known only where something loaded it, and a scene has
    --- to describe the same world whether or not anything is rendering. A part whose `Size` and
    --- `MeshSize` are both one draws exactly as it always has. Writing it yourself stretches the mesh,
    --- which is a legitimate thing to want; zero and negative components are refused, since they are a
    --- division rather than a size.
    MeshSize: vector
end

declare extern type Attachment extends Instance with
    --- Where this sits relative to the part it is parented to.
    CFrame: CFrame
    --- Where that lands in the world, recomputed each tick. Read-only because a world transform that
    --- could be assigned would be a second source of truth about the same place: the part moves, and
    --- whatever was written here would be either overwritten or wrong.
    read WorldCFrame: CFrame
    --- **Where this is drawn this frame** (ADR 0136): between the last two ticks, as the picture shows
    --- it -- in a render phase, which is a `RunService:BindToRenderStep` function, a `PreRender`
    --- handler or an action at `Rate = Render`. Anywhere else -- a simulation phase, a run with no
    --- window, a server -- it is `WorldCFrame`, because what a tick reads must not depend on when a
    --- frame happened. A camera that follows this reads it.
    function GetRenderCFrame(self): CFrame
end

declare extern type Bone extends Attachment with
    --- The joint in the parent `MeshPart`'s skeleton this follows, as the file names it.
    JointName: string
    --- Where that name resolved to, or -1 for a name the rig does not have. Re-resolved when the mesh
    --- reloads, so an index survives a file changing under it.
    read JointIndex: number
    --- An offset applied on top of the animated pose, in the joint's own space. This is the writable
    --- half of procedural animation: bend an arm towards a target, turn a head to look at something,
    --- kick a gun up on a shot. It composes with whatever the clip is doing rather than replacing it,
    --- and the identity is a bone nobody drives.
    Transform: CFrame
end

declare extern type Constraint extends Instance with
    --- One end of the joint. The part it is on is the body the solver holds.
    Attachment0: Attachment?
    --- The other end. The two frames are the same place when the constraint is built, which is what
    --- "this is where they are attached" means.
    Attachment1: Attachment?
    --- Whether the joint holds. A disabled constraint stays in the world holding nothing, rather than
    --- being destroyed and rebuilt -- rebuilding would move it to the end of the solve order, and a
    --- ragdoll that switched itself off and on would simulate differently afterwards.
    Enabled: boolean
    --- Whether the two parts still collide with each other. **False is what a ragdoll needs.** An upper
    --- arm and a lower arm overlap at the elbow by construction, and left colliding they shove each
    --- other apart every step -- a character that vibrates rather than falls.
    CollideConnected: boolean
    --- Whether it is drawn. In the editor and under the debug overlay every constraint draws what it is
    --- -- an arrow, a rail, a line. In a game only a rope, a rod and a spring are drawn, as a thin line
    --- of their `Color` and `Thickness`.
    Visible: boolean
    --- The force, in newtons, past which the joint gives: it is disabled, and `Broken` fires. Zero
    --- never breaks.
    BreakForce: number
    --- The same for the turning it resists, in newton-metres. Zero never breaks.
    BreakTorque: number
    --- Fires when the joint carried more than its `BreakForce` or `BreakTorque` and gave. It is
    --- disabled, not destroyed: enabling it again mends it.
    read Broken: Signal<()>
    --- The force the joint carried over the last simulation tick to hold its two parts together, in
    --- newtons: what a `BreakForce` is a threshold on. Zero for a mover -- what it does is its motor's,
    --- and `GetMotorForce` says it -- and for a joint that held nothing.
    function GetForce(self): number
    --- The same for the turning it resisted, in newton-metres. Zero for a joint with nothing to resist
    --- a turn with -- a ball joint, a rope.
    function GetTorque(self): number
    --- The force its own motor used over the last simulation tick, in newtons: a
    --- `PrismaticConstraint`'s actuator, an `AlignPosition`, a `LinearVelocity`. Apart from `GetForce`
    --- on purpose -- that is what the joint bore, which is what breaks it; this is how hard it worked.
    --- Zero for anything with no motor along a line.
    function GetMotorForce(self): number
    --- The torque its own motor used over the last simulation tick, in newton-metres: a
    --- `HingeConstraint`'s or a `BallSocketConstraint`'s actuator, an `AlignOrientation`, an
    --- `AngularVelocity`. A servo holding a weight level reads the weight times its arm here, and at
    --- its `ServoMaxTorque` it is doing all it can. Zero for anything with no motor about an axis.
    function GetMotorTorque(self): number
end

declare extern type BallSocketConstraint extends Constraint with
    --- Whether the cone and twist below apply. Off is a free ball joint.
    LimitsEnabled: boolean
    --- The half-angle of the swing cone in degrees, measured from the joint's own X axis.
    UpperAngle: number
    --- How far it may twist about that axis, in degrees, either way.
    TwistLimit: number
    --- What the joint does of itself: nothing, or hold a pose (`Servo`). A ball joint has no axis to
    --- spin about, so `Motor` is read as `None`.
    ActuatorType: EnumActuatorType
    --- Servo: the orientation of `Attachment1` in `Attachment0`'s frame that the joint pulls to. Only
    --- the rotation is read. The identity is the pose the two were joined in. With the joint's X along
    --- a limb, a turn about X twists the limb and a turn about Y or Z swings it: about Y by a positive
    --- angle swings its far end towards the frame's -Z, about Z towards its +Y.
    TargetOrientation: CFrame
    --- Servo: the most torque it may use, in newton-metres, about each of the joint's axes. A shoulder
    --- that holds an arm out, and gives when the arm is pulled harder than this.
    ServoMaxTorque: number
    --- Servo: how eagerly it pulls when `Stiffness` is zero, as the natural frequency of the spring it
    --- is, in radians a second. Critically damped, so it settles without ringing, and sized for the two
    --- parts the joint holds -- about the socket, arm and all -- so the same number settles a finger
    --- and a crane alike. What hangs further down a chain is not counted: a joint that carries more
    --- than its own part takes a `Stiffness`.
    AngularResponsiveness: number
    --- The spring it pulls with, in newton-metres a radian: the torque for each radian it is away. Zero
    --- leaves the pull to `AngularResponsiveness`; above zero this and `Damping` decide it, and one
    --- number no longer has to say both how firm and how bouncy. For what it turns weighing `I`
    --- kilogram metres squared about it, `w * w * I` settles at `w` radians a second.
    Stiffness: number
    --- What resists its turning, in newton-metre-seconds a radian, read with `Stiffness`. Critical
    --- damping -- it arrives without crossing -- is `2 * math.sqrt(Stiffness * I)` for an inertia of
    --- `I` kilogram metres squared; less overshoots and rings, more arrives late and stays.
    Damping: number
end

declare extern type HingeConstraint extends Constraint with
    --- Whether the range below applies. Off is a hinge that spins freely.
    LimitsEnabled: boolean
    --- How far it may turn one way, in degrees.
    LowerAngle: number
    --- How far it may turn the other, in degrees. A lower above the upper is unlimited.
    UpperAngle: number
    --- What the hinge does of itself: nothing, turn at a speed (`Motor`), or go to an angle and hold it
    --- (`Servo`).
    ActuatorType: EnumActuatorType
    --- Motor: the speed it turns at, in radians a second, about the hinge's own X. Negative turns the
    --- other way.
    AngularVelocity: number
    --- Motor: the most torque it may use, in newton-metres. A load heavier than this stalls it.
    MotorMaxTorque: number
    --- Motor: how fast its speed may change, in radians a second squared. Low is a fan that winds up.
    MotorMaxAcceleration: number
    --- Servo: the angle it goes to, in DEGREES, measured as the limits are. (Speeds are in radians a
    --- second: `AngularVelocity`, `AngularSpeed`.)
    TargetAngle: number
    --- Servo: the fastest it turns on the way, in radians a second. Far from its angle it turns at this
    --- speed; near, it is the spring.
    AngularSpeed: number
    --- Servo: the most torque it may use to get there and to stay, in newton-metres. A load that asks
    --- more sags to where its weight is this much, and -- a servo at its cap being a constant torque --
    --- swings about there until something else takes its speed away.
    ServoMaxTorque: number
    --- Servo: how eagerly it closes the last of the distance when `Stiffness` is zero, as the natural
    --- frequency of the spring it is, in radians a second. Critically damped: it arrives without
    --- crossing, sooner the higher this is. Sized for the two parts the hinge holds, about the hinge --
    --- an arm a metre long counts as a metre long -- and not for what hangs further down a chain: a
    --- joint that carries more than its own part takes a `Stiffness`.
    AngularResponsiveness: number
    --- The spring it pulls with, in newton-metres a radian: the torque for each radian it is away. Zero
    --- leaves the pull to `AngularResponsiveness`; above zero this and `Damping` decide it, and one
    --- number no longer has to say both how firm and how bouncy. For what it turns weighing `I`
    --- kilogram metres squared about it, `w * w * I` settles at `w` radians a second.
    Stiffness: number
    --- What resists its turning, in newton-metre-seconds a radian, read with `Stiffness`. Critical
    --- damping -- it arrives without crossing -- is `2 * math.sqrt(Stiffness * I)` for an inertia of
    --- `I` kilogram metres squared; less overshoots and rings, more arrives late and stays.
    Damping: number
end

declare extern type FixedConstraint extends Constraint with
end

declare extern type PrismaticConstraint extends Constraint with
