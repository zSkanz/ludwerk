    function AddAgent(self, body: BasePart, settings: { Radius: number?, Height: number?, Speed: number?, Floats: boolean?, FloatHeight: number?, Climbs: boolean? }?): number
    --- Adds an agent with no body, its feet at `position`, and returns its number: a row the swarm
    --- steps and nothing drawn. What a server keeps when it simulates a horde for players who draw it
    --- themselves -- read the agents with `GetPositions` and send what they need. The settings are
    --- `AddAgent`'s.
    function AddAgentAt(self, position: vector, settings: { Radius: number?, Height: number?, Speed: number?, Floats: boolean?, FloatHeight: number?, Climbs: boolean? }?): number
    --- Where the agents walk when there is more than one place to go -- every player of a match: each
    --- agent walks at the nearest of them, and thinks as often as that one is near (`NearDistance`,
    --- `FarDistance`). Called again whenever they move. An empty table is `Target` alone again.
    function SetTargets(self, targets: { vector }): ()
    --- Stops moving an agent and forgets it. Its body stays where it was.
    function RemoveAgent(self, agent: number): ()
    --- How fast it walks, in metres a second. Zero holds it where it stands, still pushed.
    function SetAgentSpeed(self, agent: number, speed: number): ()
    --- Puts it somewhere, falling from there.
    function SetAgentPosition(self, agent: number, position: vector): ()
    --- A knock-back, in metres a second along the ground, that dies away in a moment.
    function Push(self, agent: number, velocity: vector): ()
    --- Where it stands, or nil when there is no such agent.
    function GetAgentPosition(self, agent: number): vector?
    --- Every live agent's number, in slot order.
    function GetAgents(self): { number }
    --- Where each live agent stands, in the order `GetAgents` gives them.
    function GetPositions(self): { vector }
    --- Every live agent whose feet are within `radius` of `centre`, in slot order: what a weapon aims
    --- at, and who has reached `Target`. Answered from the swarm's grid, so its cost is the agents near
    --- `centre`, not all of them. `into`, when given, is emptied and filled and returned -- a weapon
    --- asking every tick makes no table. `flat` measures along the ground alone, so every agent of a
    --- tower over the circle is in it.
    function QueryRadius(self, centre: vector, radius: number, into: { number }?, flat: boolean?): { number }
    --- Something agents walk round -- a tree, a rock -- as a circle on the ground.
    function AddObstacle(self, position: vector, radius: number): ()
    --- Forgets every obstacle.
    function ClearObstacles(self): ()
    --- Gives an agent a number that means what the game says -- a whole number from 0 to 65535: a kind
    --- in some bits, flags in the others (ADR 0162). It reaches every machine that has the agent, which
    --- reads it with `GetAgentTag` and hears `AgentTagChanged`: what a replica picks a mesh and a pose
    --- from. The tag an agent has when it is removed arrives with its removal, so a "killed" bit set
    --- just before `RemoveAgent` is in every machine's `AgentRemoved`. The authority's to call.
    function SetAgentTag(self, agent: number, tag: number): ()
    --- The agent's tag, 0 for one that was never given any or that is not there.
    function GetAgentTag(self, agent: number): number
    --- Gives an agent a part of THIS machine's to move, or nil to let it go: each tick the swarm writes
    --- the part's `CFrame` -- where the agent is, facing its target -- and nothing else about it. On
    --- the authority it replaces the body `AddAgent` took. On a replica it is how a horde is drawn: a
    --- body made when `AgentAdded` fires, given here, and taken back when `AgentRemoved` does. The part
    --- is drawn between ticks like any other that moves.
    function SetAgentBody(self, agent: number, body: BasePart?): ()
end

declare extern type NavigationAgent extends Instance with
    --- Where it is going. Writing it starts the walk; while `Active` is false it stands still.
    Target: vector
    --- Whether it is walking. Writing `Target` sets it; arriving clears it.
    Active: boolean
    --- Its fastest, in metres per second.
    MaxSpeed: number
    --- Which agent it is, as `NavigationService:DefineAgent` named it; empty for the service's own.
    AgentType: string
    --- Fired once when it arrives at `Target`.
    read Reached: Signal<()>
end

declare extern type FoliageLayer extends Instance with
    --- Whether it grows at all. Off hides every instance of it, and nothing is placed.
    Enabled: boolean
    --- How many instances a square metre of ground holds where every rule allows it, before the
    --- material's multiplier, the painted mask and `[render] foliage_density` scale it.
    Density: number
    --- The flattest ground it grows on, in degrees from level.
    SlopeMin: number
    --- The steepest ground it grows on, in degrees: grass thins out before a cliff does.
    SlopeMax: number
    --- The lowest ground it grows on, in metres of world height.
    HeightMin: number
    --- The highest ground it grows on, in metres: a tree line.
    HeightMax: number
    --- How much it gathers into patches, from 0 to 1: 0 is even cover, 1 is tufts with bare ground
    --- between.
    Clumping: number
    --- The least distance between two instances, in metres.
    MinSpacing: number
    --- How far from the camera it is drawn, in metres. Past it nothing of the layer costs a draw.
    DrawDistance: number
    --- Over how many metres before `DrawDistance` it thins away, so the edge of the field is not a
    --- line.
    FadeDistance: number
    --- Which of the endless arrangements the same rules give. The same seed grows the same field on
    --- every machine.
    Seed: number
    --- The terrain materials it grows on, each with a multiplier of `Density`: material `n` is the
    --- terrain's layer `n` (`Terrain:GetLayers`). Empty is every material at 1.
    function GetMaterials(self): { { Material: number, Density: number } }
    --- Sets the materials it grows on, as `GetMaterials` returns them: up to 32, `Density` 1 when left
    --- out. An empty list grows on every material. Saved with the scene.
    function SetMaterials(self, materials: { { read Material: number, read Density: number? } }): ()
end

declare extern type FoliageMesh extends Instance with
    --- The mesh that grows: any mesh asset of the project.
    Mesh: Content
    --- Its share of the layer's instances against the other meshes of the layer: two meshes of weight 1
    --- and 3 grow one to three.
    Weight: number
    --- The smallest an instance is, as a multiple of the mesh.
    ScaleMin: number
    --- The largest an instance is, as a multiple of the mesh.
    ScaleMax: number
    --- Whether each instance turns about its up axis at random, so a field is not rows of the same
    --- leaf.
    RandomRotation: boolean
    --- How much it leans with the ground, from 0 upright to 1 along the slope.
    AlignToNormal: number
    --- How far below the ground its base goes, in metres, so a stem on a slope is not floating at one
    --- edge.
    Sink: number
    --- How much the wind moves it, from 0 still to 1 full sway.
    WindResponse: number
    --- How hard it resists the wind: a reed 0.5, a bush 3.
    Stiffness: number
    --- Whether it casts a shadow, near the camera: `[render] foliage_shadow_distance` is how near.
    CastShadow: boolean
    --- What it is drawn with: a material asset, or nothing for the mesh's own. A material whose surface
    --- shader has a `surfaceVertex` moves it as it likes, with the wind and the instance's random
    --- value; otherwise the built-in sway bends it from its base.
    Material: Material?
end

declare extern type ClickDetector extends Instance with
    --- How far from the player's character, in metres, a click still counts -- from the camera when
    --- there is no character.
    MaxActivationDistance: number
    --- The picture the pointer shows over it. Empty keeps the pointer as it is. Stored, replicated and
    --- not drawn yet: the pointer keeps its look (the toolkit's F1 ledger).
    CursorIcon: Content
    --- The primary button, or a tap, went down on it within reach.
    read MouseClick: Signal<Player>
    --- The secondary button went down on it within reach.
    read RightMouseClick: Signal<Player>
    --- The pointer came onto it, within reach. On this machine only.
    read MouseHoverEnter: Signal<Player>
    --- The pointer left it, or it went out of reach. On this machine only.
    read MouseHoverLeave: Signal<Player>
end

declare extern type Water extends Instance with
    --- Everywhere (`Ocean`), a rectangle (`Pool`), along its `WaterPoint` children (`River`), or inside
    --- the closed curve through them (`Lake`).
    Shape: EnumWaterShape
    --- The height of the still surface, in metres; the waves rise and fall about it.
    SurfaceLevel: number
    --- The middle of a `Box`, across the ground; its height is `SurfaceLevel`'s.
    Position: vector
    --- A `Pool`'s width, depth under the surface, and length. A `River`'s width is its X and its depth
    --- its Y, where a point does not say its own; a `Lake`'s depth is its Y, and its outline is its
    --- points -- it has no width or length to give. Y must be greater than zero; X and Z may be zero.
    Size: vector
    --- Mass per cubic metre, in the units of `BasePart.Density`: a part less dense than the water
    --- floats, and one of half its density floats half under.
    Density: number
    --- How much it drags what moves through it: 0 none, 1 a sea's, more a swamp's.
    Viscosity: number
    --- Metres a second the water flows, carrying what floats in it. A `River` adds `FlowSpeed` along
    --- its course.
    Current: vector
    --- How fast a river flows along its points, first to last, in metres a second -- where it is level.
    --- Where it drops it runs faster, by four times its slope: twice as fast down one in four.
    FlowSpeed: number
    --- How wide the bank `Carve` cuts is, in metres: the bed slopes from the water's edge, where it is
    --- at the surface, down to the water's depth this far in. Zero is a wall.
    BankWidth: number
    --- The height of the surface above the position's column now, waves and all -- the height the
    --- picture draws there -- or nil where this water is not.
    function GetHeightAt(self, position: vector): number?
    --- Which way the surface faces above the position's column now, or nil where this water is not.
    function GetNormalAt(self, position: vector): vector?
    --- Cuts this water's bed into the terrain under it (ADR 0146): every column of ground it covers is
    --- lowered to the bed -- the surface at the water's edge, sloping to its depth `BankWidth` in --
    --- and ground already lower is left alone. A river's bed follows it down. Answers how many columns
    --- it lowered; a sea carves nothing. Call it again after moving the water: it only ever digs.
    function Carve(self): number
end

declare extern type WaterWave extends Instance with
    --- Metres from one crest to the next.
    Wavelength: number
    --- Metres a crest rises above the still surface.
    Amplitude: number
    --- Which way it travels, in degrees about the vertical: 0 along +X, 90 along +Z.
    Direction: number
    --- 0 a rounded swell, 1 sharp crests and flat troughs.
    Steepness: number
    --- Where in its cycle it starts, in radians, so two alike waves need not rise together.
    Phase: number
end

declare extern type WaterPoint extends Instance with
    --- Where the water passes. For a `River` its height is the surface's height there, so a river whose
    --- points descend runs downhill; a `Lake` and a `Spline` are level at the water's `SurfaceLevel`
    --- and read only where the point is across the ground.
    Position: vector
    --- How wide a river is here, in metres, changing smoothly to the next point's. Zero is the water's
    --- `Size.X`.
    Width: number
    --- How deep a river is here, in metres. Zero is the water's `Size.Y`.
    Depth: number
    --- A corner here, where the curve would round it.
    Sharp: boolean
end

declare extern type DataModel extends Instance with
    --- The version of the engine runtime executing this VM, as `project.toml` pins it. Read-only: the
    --- runtime is chosen before the VM exists, so nothing a script does can change it.
    read EngineVersion: string
    --- The version of the Luau language runtime this engine build embeds. Read-only, and fixed per
    --- engine release: a language upgrade is an engine release rather than a silent change underneath a
    --- running project.
    read LuauVersion: string
    --- Fires once, after every entry script has had its first resumption. Connecting at file scope
    --- inside an entry script still works: the fire is deferred like every other, so a handler
    --- registered while the world is still being built is registered in time. It carries no arguments.
    read Loaded: Signal<()>
    function GetService(self, name: "Workspace"): Workspace
    function GetService(self, name: "Lighting"): Lighting
    function GetService(self, name: "ReplicatedStorage"): ReplicatedStorage
    function GetService(self, name: "SaveService"): SaveService
    function GetService(self, name: "LocalizationService"): LocalizationService
    function GetService(self, name: "GraphicsService"): GraphicsService
    function GetService(self, name: "HapticService"): HapticService
    function GetService(self, name: "CryptoService"): CryptoService
    function GetService(self, name: "ContentProvider"): ContentProvider
    function GetService(self, name: "SceneService"): SceneService
    function GetService(self, name: "ServerStorage"): ServerStorage
    function GetService(self, name: "NetworkService"): NetworkService
    function GetService(self, name: "RunService"): RunService
    function GetService(self, name: "ServerScriptService"): ServerScriptService
    function GetService(self, name: "ClientScriptService"): ClientScriptService
    function GetService(self, name: "GlobalScriptService"): GlobalScriptService
    function GetService(self, name: "StreamingService"): StreamingService
    function GetService(self, name: "TagService"): TagService
    function GetService(self, name: "DebugService"): DebugService
    function GetService(self, name: "HotReloadService"): HotReloadService
    function GetService(self, name: "PhysicsService"): PhysicsService
    function GetService(self, name: "InputService"): InputService
    function GetService(self, name: "TweenService"): TweenService
    function GetService(self, name: "UIService"): UIService
    function GetService(self, name: "AudioService"): AudioService
    function GetService(self, name: "VoxelService"): VoxelService
    function GetService(self, name: "NavigationService"): NavigationService
    --- Returns the service of this name. Services are singletons and all of them exist from boot, so
    --- this is a lookup rather than a creation and every call returns the same ordinary child of
    --- `game`. A string literal gives an exactly typed result; a name computed at runtime gives the
    --- general `Instance`, which is the honest cost of not knowing the name at analysis time. An
    --- unknown name raises `scene.err.unknown_service`.
    function GetService(self, name: string): Instance
    --- Returns the service of this name, or `nil` for a name that is not a service at all. **It answers
    --- the same as `GetService` for every real service now**, and that is a narrowing worth stating: it
    --- used to mean "is this service in use", because a service was created by its first `GetService`.
    --- All of them exist from boot, so there is no such question left to ask. What is left is the
    --- difference in how they refuse an unknown name -- this one returns `nil` where `GetService`
    --- raises -- which is the reason to keep it.
    function FindService(self, name: string): Instance?
    --- Registers a function to run while the game is shutting down, for work that has to happen before
    --- the process ends. The callbacks run against a capped timeout and the shutdown proceeds when it
    --- expires, finished or not: a close handler is a chance to finish, never a veto. The editor's Stop
    --- is the game closing too. **For the game, not a level** (ADR 0124): the open scene's
    --- `scene:BindToClose` handlers run first, then these. One registered by a scene's script is
    --- dropped when that scene closes, without running -- with a warning in the editor -- because it
    --- asked for a close its scene did not live to see; `scene:BindToClose` is the one for a level.
    --- Every call adds one, in order, each in its own thread; one that errors does not stop the others.
    function BindToClose(self, callback: () -> ()): ()
    --- Sends a message to the game (ADR 0124): every function bound to `topic` on `game` runs,
    --- deferred, in send order, each in its own thread. **Send to the mailbox of whom you want to
    --- reach** -- a level tells the game's HUD `game:SendMessage("CoinCollected", 1)` -- and listen on
    --- your own. The values are `Scene:SendMessage`'s: copied, never a function or a live object. Local
    --- to this machine.
    function SendMessage(self, topic: string, ...: any): ()
    --- Runs `callback` with a message's values each time one is sent to `game` under `topic`. It
    --- belongs to the script that bound it: a scene script's binding goes with its scene.
    function BindToMessage(self, topic: string, callback: (...any) -> ()): ()
    --- Ends the run. The registered `BindToClose` callbacks are given their timeout and the process
    --- then exits. This is how a game closes itself deliberately.
    function Shutdown(self): ()
end

declare extern type Workspace extends Instance with
    --- The acceleration applied to every unanchored part, in metres per second squared. SI and signed,
    --- so the default points down; a game wanting moon gravity scales it rather than reaching for a
    --- separate multiplier.
    Gravity: vector
    --- The wind's direction and speed, in metres per second. **Visual only**: it moves what is drawn --
    --- particles that drift with it, surface shaders that read it, foliage -- and pushes no body. Zero,
    --- the default, is a still world. `GetWindAt` is the wind at a point, gusts and all.
    GlobalWind: vector
    --- How far the wind's speed rises and falls in gusts, from 0 (steady) to 1. Gusts travel downwind
    --- at the wind's own speed, so one is seen crossing a field.
    WindGusts: number
    --- How far the wind's direction wanders from place to place, from 0 (straight) to 1.
    WindTurbulence: number
    --- The camera the world is rendered from. Nil renders nothing rather than falling back to a camera
    --- the engine invented, because a view nobody asked for is harder to debug than a black frame that
    --- says why.
    CurrentCamera: Camera?
    --- This world's ground, or nil in a world that has none. Read-only because it names rather than
    --- owns: a `Terrain` is an ordinary instance parented under the workspace, and this is how you
    --- reach the one the engine treats as the world's ground. Parent a second one and it is a perfectly
    --- good terrain that this does not point at.
    read Terrain: Terrain?
    --- The wind at a point now, in metres per second: `GlobalWind` with its gusts and turbulence, at
    --- `RunService.SimTime`. It is the same function the renderer draws with, so a flag, a sail or a
    --- sound put where this says the wind is agrees with the picture.
    function GetWindAt(self, position: vector): vector
    --- The nearest thing a ray from `origin` hits, or nil. The direction is NOT normalised: its length
    --- is how far the ray reaches, so `direction * 100` is a hundred-metre ray. A tie between two
    --- surfaces at the same distance resolves the same way on every run, because a query whose answer
    --- depends on traversal order is a replay divergence waiting for a body count to change (R10).
    function Raycast(self, origin: vector, direction: vector, params: RaycastParams?): RaycastResult?
    --- The nearest `Part2D` or `Tilemap2D` a ray on the 2D plane hits, or nil. As with `Raycast`, the
    --- direction's length is the reach. Sensors are passed through, and so is a part with `CanCollide`
    --- off. Two hits at the same distance resolve the same way on every run (R10).
    function Raycast2D(self, origin: Vector2, direction: Vector2, params: RaycastParams?): RaycastResult2D?
    --- The same question with a sphere swept along the ray instead of a point. This is what a camera
    --- boom or a character's ground check wants: a ray slips through a gap narrower than the thing it
    --- is standing in for.
    function Spherecast(self, origin: vector, radius: number, direction: vector, params: RaycastParams?): RaycastResult?
    --- Every part overlapping an oriented box, as a fresh array in a stable order -- one entry per part
    --- however many of its surfaces are inside. `size` is the full extent, matching `BasePart.Size`.
    function GetBodiesInBox(self, cframe: CFrame, size: vector, params: RaycastParams?): {BasePart}
    --- Every part overlapping a ball, as `GetBodiesInBox` answers for a box: what an explosion reaches,
    --- what is within arm's length.
    function GetBodiesInSphere(self, position: vector, radius: number, params: RaycastParams?): {BasePart}
end

declare extern type Lighting extends Instance with
    --- The hour of day, 0 to 24, wrapping rather than clamping so that adding a delta every tick never
    --- has to check. It is the ONLY input to the sun's direction, which is what makes a replay light
    --- the same way the live run did.
    ClockTime: number
    --- Degrees north of the equator, which tilts the sun's arc across the sky. The second and last
    --- input to SunDirection.
    GeographicLatitude: number
    --- The flat light in ENCLOSED spaces -- a cave, a tunnel, under an overhang: surfaces that see none
    --- of the sky. `OutdoorAmbient` is the light of those that see all of it, and a surface that sees
    --- some takes a blend of the two by how much. A stand-in for bounced light, so a cave is dim rather
    --- than black; set it darker for a darker cave. Not clamped, so it can be pushed above one
    --- deliberately.
    Ambient: Color3
    --- The flat light on surfaces that see the open sky. What `Ambient` is for enclosed spaces; the two
    --- start equal, so a world that sets neither is lit the same inside and out, and one that wants
    --- dark caves darkens `Ambient` alone. A part is outdoors unless the terrain says otherwise.
    OutdoorAmbient: Color3
    --- How strong the sun is, independent of its colour.
    Brightness: number
    --- What distance fades towards between FogStart and FogEnd. **Kept and not used while an
    --- `Atmosphere` is directly under `Lighting`** -- the air replaces the linear fog -- and it applies
    --- again when the `Atmosphere` goes.
    FogColor: Color3
    --- Distance in metres at which fog begins. Kept and not used while an `Atmosphere` is directly
    --- under `Lighting`.
    FogStart: number
    --- Distance in metres at which fog is total. Equal to or below FogStart means no fog at all, which
    --- is how fog is turned off without a separate flag.
    FogEnd: number
    --- Exposure in EV stops, on top of the automatic exposure the renderer measures from the frame
    --- itself. Zero means whatever it measured; +1 is twice the light and -1 is half, which is the unit
    --- a camera uses. It is a look rather than a limit, so it is not clamped.
    ExposureCompensation: number
    --- The most the automatic exposure may DARKEN the picture, in EV stops: how far it follows a world
    --- that gets brighter. About two and three quarter stops down by default. Raise it towards 0 and a
    --- bright place stays bright -- snow glares, a desert at noon is hard to look at.
    ExposureMin: number
    --- The most the automatic exposure may BRIGHTEN the picture, in EV stops: how far it follows a
    --- world that gets darker. About a stop and a half by default, so a night is darker than a day and
    --- still seen. **Lower it and night is dark**: at 0 the exposure never brightens at all, and a
    --- world lit a third as bright LOOKS a third as bright -- what a game with a day and a night that
    --- should feel like one sets. Set both to the same number and the exposure is fixed there.
    ExposureMax: number
    --- How much the sky lights the world's matte surfaces, from 0 to 1: 1 is all of its light, 0 none
    --- -- a surface is then lit by the sun, its lamps and `Ambient` alone. The sky itself is drawn as
    --- it is either way.
    EnvironmentDiffuseScale: number
    --- How much the sky is reflected in the world's shiny surfaces, from 0 to 1. 0 leaves metal
    --- reflecting nothing but the sun's highlight, which is what an interior with the sky shut out
    --- should look like.
    EnvironmentSpecularScale: number
    --- How soft the edge of a sun shadow is, from 0 (as hard as the shadow map allows) to 1 (a quarter
    --- of a metre of penumbra either side of the edge). The default is the edge the engine drew before
    --- this property existed.
    ShadowSoftness: number
    --- Whether the sun -- or the moon, at night -- casts shadows. Off, nothing shades anything from it:
    --- the look of an overcast day, or of a stylised world with no shadows at all. Lamps that cast
    --- shadows still do.
    GlobalShadows: boolean
    --- Whether the picture's brightness follows what the camera sees, as an eye adapting from a cave to
    --- daylight does. Off holds the exposure fixed, so a world lit darker LOOKS darker;
    --- `ExposureCompensation` still applies either way. A machine whose graphics settings turn
    --- automatic exposure off has it off whatever this says.
    AutoExposure: boolean
    --- The unit vector pointing from the world towards the sun, derived from ClockTime and
    --- GeographicLatitude and nothing else -- no wall clock and no accumulated state, so the same
    --- ClockTime always gives the same direction.
    read SunDirection: vector
end

declare extern type ReplicatedStorage extends Instance with
end

declare extern type SaveService extends Instance with
    --- The version of this game's save layout, a whole number from 1. Set it before the first
    --- `GetSlotAsync`; a slot written by an older version is handed to `OnMigrate` first, once, and
    --- saved at this version.
    Version: number
    --- Brings a slot saved by an older `Version` up to this one, by editing it in place. Runs once,
    --- before `GetSlotAsync` returns that slot, in a thread of its own; the slot is then saved at the
    --- current version. An error in it is logged and leaves the slot as it was read.
    OnMigrate: ((slot: SaveSlot, fromVersion: number) -> ())?
    --- The slot called `name`, read from disk -- yields until it is. A name is 1 to 64 letters, digits,
    --- `_` and `-`; anything else is an error, because a slot is a file and a name is never a path. A
    --- slot that does not exist yet is an empty one. One whose file is damaged is read from the backup
    --- the previous save left, with a warning; when both are, it is empty and `Recovered` is false.
    function GetSlotAsync(self, name: string): SaveSlot
    --- The names of the slots this game has saved, sorted.
    function ListSlots(self): { string }
    --- Removes a slot and its backup. A `SaveSlot` already handed out is emptied.
    function DeleteSlot(self, name: string): ()
end

declare extern type LocalizationService extends Instance with
    --- The locale text is asked for in, as `en` or `pt-BR`. It starts as the player's saved choice,
    --- else the system's language, else `[project] default_locale`, else `en` -- each narrowed to a
    --- catalog the project has. Writing it is the player choosing: it is kept for the next run, and
    --- `LocaleChanged` fires. A locale the project has no catalog for is narrowed to one of its
    --- language (`pt` reads `pt-BR`), and refused when there is none.
    Locale: string
    --- `Locale` changed, or -- while a game is being made -- a catalog was edited and read again: where
    --- a game sets its labels' text.
    read LocaleChanged: Signal<string>
    --- The locales the project has a catalog for, in order: what a language menu lists.
    function GetLocales(self): { string }
    --- The text for `key` in `Locale`. `{name}` in the text is replaced by `arguments.name` -- a
    --- string, a number or a boolean. A key nobody has comes back as the key, and is warned about once.
    function Translate(self, key: string, arguments: { [string]: any }?): string
end

declare extern type GraphicsService extends Instance with
    --- The quality level. Writing one is `ApplyPreset`: every quality setting becomes that level's. It
    --- reads `Custom` when any of them is not the level's -- a script, the player or the project said
    --- otherwise -- and `Custom` cannot be written.
    QualityLevel: EnumGraphicsQuality
    --- The fraction of the window's resolution the world is drawn at, a third to 1. The interface is
    --- drawn at the window's own, whatever this is.
    RenderScale: number
    --- The sun's shadow, as a level. Writing one writes `ShadowResolution` and `ShadowCascades` as that
    --- level has them; `Off` is no cascades.
    ShadowQuality: EnumShadowQuality
    --- One shadow cascade's side in texels, 256 to 2048, rounded down to a power of two.
    ShadowResolution: number
    --- How many cascades the sun casts into, 0 to 4. Zero is no sun shadow.
    ShadowCascades: number
