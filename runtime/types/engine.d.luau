    --- Fires when the new scene is in place and its scripts have started.
    read SceneLoaded: Signal<string>
    --- Fires when a `LoadScene` fails because the scene file does not exist or cannot be read. The
    --- scene that was open stays as it was, and its close handlers do not run. `message` gives the
    --- reason, which is also logged.
    read SceneLoadFailed: Signal<string, string>
    --- Inside a `SubWorld`: fires with the values that the game running this world passed to
    --- `SubWorld:Send`, one tick after they were sent. It never fires in a world that is not inside a
    --- `SubWorld`.
    read HostMessageReceived: Signal<...any>
    --- Unloads the current scene and loads the one at `path`, which is relative to the content folder.
    --- It returns at once; the change happens at the next safe point between ticks, after
    --- `SceneLoading` has fired. The old scene is removed entirely: its world, the contents and
    --- settings of its services, and its scripts, whose threads stop. The new scene starts from the
    --- engine's default settings, reads its file, loads its own code from `src/scenes/<scene>/` and
    --- starts its scripts. `data` is passed to the new scene, which reads it with `GetLoadData`. It can
    --- hold only plain values, the same as a `RemoteEvent` argument, and no instances. A client
    --- connected to a match cannot call this method.
    function LoadScene(self, path: string, data: any?): ()
    --- Starts preparing the scene at `path` while the current scene keeps running, and returns at once
    --- with a `SceneLoad` object. Use its `Progress` for a loading bar, its `Ready` event to know when
    --- the scene is prepared, and its `Activate` method to switch. `options.Activate`, true by default,
    --- switches as soon as the scene is ready. Set it to false to wait for a call to `Activate`, for
    --- example after a fade or a button press. `options.Data` is the `data` of `LoadScene`. The switch
    --- works like `LoadScene`, with the file already parsed and its meshes already loaded. Only one
    --- load runs at a time: a second call cancels the first. A client connected to a match cannot call
    --- this method.
    function LoadSceneAsync(self, path: string, options: { Activate: boolean?, Data: any? }?): SceneLoad
    --- Returns the `data` that the last `LoadScene` passed, as a fresh copy, or nil.
    function GetLoadData(self): any
    --- Inside a `SubWorld`: sends values out to the game that runs this world. The `Received` event of
    --- the `SubWorld` fires there with them on its next tick. Use it to report a score or a game over.
    --- It accepts the values a `RemoteEvent` accepts, except instances. Raises an error if this world
    --- is not inside a `SubWorld`.
    function SendToHost(self, ...: any): ()
    --- Returns whether this world is running inside another game's `SubWorld`.
    function IsSubWorld(self): boolean
    --- Keeps the loading screen up over a scene until `ReleaseLoading` has been called the same number
    --- of times. The engine shows a loading screen while a scene loads: at the first scene and at every
    --- `LoadScene`. It removes the screen once the scene's meshes and images are loaded and the terrain
    --- around the camera is meshed. A scene whose scripts build its world, such as generated terrain or
    --- parts created from code, should hold the screen until the world is built. A `ScreenGui` with
    --- `KeepOnSceneLoad` on, or one of the new scene's own, is drawn over the engine's loading screen,
    --- so a game can show its own. A hold that is never released ends after one minute, with a warning
    --- in the log.
    function HoldLoading(self): ()
    --- Ends one `HoldLoading`. When none remain, the loading screen is removed as soon as the scene has
    --- loaded. Extra calls are ignored.
    function ReleaseLoading(self): ()
end

declare extern type ServerStorage extends Instance with
end

declare extern type NetworkService extends Instance with
    --- Which channel of its world this server is: 1 for a world without channels, and for the first of
    --- a world with them. A `[[world]]` with `channels = true` in `servers.toml` is copied into
    --- channels 2, 3 and on as the open ones fill, each a server of its own.
    read Channel: number
    --- Whether this process decides the state of the world. It is true in single-player, when hosting
    --- and on a dedicated server, and false on a client, which shows the state it is sent.
    read Authority: boolean
    --- The network role this process runs in. For gameplay decisions, use `Authority`; this property is
    --- for showing the role, for example in a menu.
    read Topology: EnumNetworkTopology
    --- The authority's tick number. On the authority it is its own tick; on a client it is the newest
    --- tick the client has applied; in single-player it is 0. It counts ticks and is not a time.
    read ServerTick: number
    --- The number of connected peers, not counting this process. On an authority it is the number of
    --- clients; on a connected client it is 1.
    read PeerCount: number
    --- The connection state of this machine: `Offline`, `Connecting`, `Connected`, `Hosting`, `Serving`
    --- or `Reconnecting`.
    read State: EnumNetworkState
    --- The port of this machine's match: the port it hosts or serves on, or the port it joined. It is 0
    --- when there is no match. A host can show it with `GetLocalAddresses` for others to join.
    read Port: number
    --- The state of this machine's match with its relay. It is `None` when there is no relay or no
    --- hosted match, `Connecting` until the relay answers, `Ready` once the relay has registered the
    --- match, and `Unreachable` while the relay does not answer. `RelayStateChanged` fires when it
    --- changes.
    read RelayState: EnumRelayState
    --- The code other players use to join this machine's match through a relay. It is eight letters and
    --- digits, without 0, 1, I or O, which are easily confused. The relay resolves it to this host
    --- wherever the host is, including behind a home router or on a mobile network. It is empty until
    --- `RelayState` is `Ready`, and on a machine that is not hosting through a relay. It stays the same
    --- for as long as the match is hosted, even if the relay restarts, and changes the next time `Host`
    --- is called.
    read JoinCode: string
    --- The player at this machine. It exists from startup in single-player, when hosting and when
    --- joining. It is nil on a dedicated server.
    read LocalPlayer: Player?
    --- The largest number of players in this machine's match, including the host's own player. It is
    --- the limit on the length of `GetPlayers()`. The host sets it, to an integer of at least 1, before
    --- or after calling `Host`. A player who tries to join a full match is refused, and their
    --- `JoinFailed` reports that the match is full. Lowering the value removes no one: players already
    --- in the match stay until they leave or are removed with `Player:Kick`. The value cannot exceed
    --- the capacity the match was opened with, which is 32 other players or the `--max-players` flag;
    --- that capacity is what it reads while hosting if it was never set. On a machine that joined a
    --- match it reads 0, and setting it raises an error.
    MaxPlayers: number
    --- Called on the server for everybody who joins, before they are a player, to say whether they may.
    --- Return true to let them in, or false and the words they are shown. `joiner` has their
    --- `PublicKey`, their `Address` and the `Ticket` their game presented, empty for none; set
    --- `joiner.AccountId` to the account they are, usually the `sub` of `VerifyTicket`'s claims. It
    --- runs on a thread of its own and may yield, to ask the game's backend; after 10 seconds it is a
    --- refusal, and so is an error in it. While it runs the joiner has no `Player` and is sent nothing.
    --- An account already playing is dropped when the same account joins again, and an account banned
    --- with the console's `ban` is refused after this has named it. With no `OnJoinRequest`, everybody
    --- is let in. Set it once, in a server script: a second assignment replaces the first, and a client
    --- cannot set it.
    OnJoinRequest: ((joiner: { PublicKey: string, Address: string, Ticket: string, AccountId: string? }) -> (boolean, string?))?
    --- Fires when a join succeeds and this machine is in the server's match.
    read Connected: Signal<()>
    --- Fires when a join fails. This machine stays in single-player, in the state it was in before
    --- `Join` was called, so the menu that called `Join` is still there to handle the event. The reason
    --- is passed as readable text: the server did not answer, the server is full, it runs a different
    --- version, or it is taking no more players from this machine's network address. Players behind one
    --- router or one mobile network share an address, and a server allows 64 of them by default
    --- (`[network] max_connections_per_address` in `project.toml`, or `--max-per-address` for a
    --- dedicated server; 0 is no limit). With a join code, it can also be that the relay did not
    --- answer, no match has that code, the host has blocked this machine, or no connection could be
    --- established in time.
    read JoinFailed: Signal<string>
    --- Fires when `RelayState` or `JoinCode` changes: the relay registered the match, stopped
    --- answering, or started answering again. Read the two properties for the new values.
    read RelayStateChanged: Signal<()>
    --- Fires when `Host` cannot open its port, for example because another program is using it. This
    --- machine stays as it was. The reason is passed as readable text.
    read HostFailed: Signal<string>
    --- Fires when the connection ends and this machine is back in single-player. The server left, the
    --- network failed, or `Disconnect` was called.
    read Disconnected: Signal<string>
    --- Fires on a channel the manager is about to merge into another, because it has held under a
    --- quarter of its players for a while. In `seconds` its players are moved, all together, to the
    --- fullest channel with room. A game can say so first.
    read ChannelMerging: Signal<number>
    --- Fires on a client waiting in line at a full game's front door, with its place and an estimate.
    --- The place counts from 1. The estimate is about how many seconds until its turn, measured by how
    --- fast the line moved in the last five minutes, and nil before anybody has left it. It fires when
    --- the machine joins the line and every five seconds after; `Connected` fires as usual when it is
    --- let in. `@engine/travelscreen` shows it.
    read Queued: Signal<number, number?>
    --- Fires on the server of the world a player traveled to, after `PlayerAdded`, with the `data` the
    --- world they left sent and that world's name. A player who came through the front door fires it
    --- too, with nil and an empty origin. `reason` is empty, or `"InstanceFailed"` for a player sent
    --- back because the instance they were in stopped without closing: the game can say so, and give
    --- back what the run cost.
    read TravelArrived: Signal<Player, any, string, string>
    --- Fires on a client when it is sent to another world, by the front door or by the world it is in,
    --- before it leaves, with that world's name. Show a loading screen here and take it down on
    --- `Connected`, which fires when the next world has taken this machine; `@engine/travelscreen` is
    --- one, mounted in one line.
    read TravelStarted: Signal<string>
    --- Fires on every machine of the match when the server's operator says something to everybody, with
    --- the console's `say` or as `stop` counts down. The engine writes it to the log and draws nothing:
    --- a game shows it its own way, or mounts `@engine/announcements`, which shows each one across the
    --- top of the screen for a few seconds.
    read Announced: Signal<string>
    --- Fires when a player joins. A script that connects at its top level and then loops over
    --- `GetPlayers()` handles each player exactly once.
    read PlayerAdded: Signal<Player>
    --- Fires when a player is leaving. The player object is still valid inside the handler, so a game
    --- can save that player's data.
    read PlayerRemoving: Signal<Player>
    --- Returns the local players on this machine in the order they joined, with the primary player
    --- first. Players that are being removed are not included.
    function GetLocalPlayers(self): {Player}
    --- Adds a guest player to an offline game on this machine and fires `PlayerAdded`. Returns nil on a
    --- dedicated server or while connected to a match. A guest's id is valid for the session only and
    --- is not a platform account. The game decides how many local players it allows, and assigns each
    --- one's input with `InputContext.Player`. Local guests cannot join online matches.
    function AddLocalPlayer(self): Player?
    --- Removes a guest player from an offline game, firing `PlayerRemoving`. Returns whether the
    --- removal was started. It does not remove the primary local player or a remote player.
    function RemoveLocalPlayer(self, player: Player): boolean
    --- Returns every player in the game, in the order they joined. In single-player it returns the one
    --- local player, so code that loops over players works with and without networking.
    function GetPlayers(self): {Player}
    --- Returns this machine's IPv4 addresses on its local networks, best first. A host can show them
    --- for players on the same network to type. Only interfaces that are up are listed. Loopback and
    --- link-local (169.254) addresses are left out, as are virtual adapters that can be identified,
    --- such as those of a hypervisor or a container. Private ranges come first, and among them the
    --- interface of the default route. The list does not depend on a match, is not replicated, and is
    --- empty when the machine has no network.
    function GetLocalAddresses(self): {string}
    --- Measures the round trip to a relay and returns what the relay reports, or nil if it did not
    --- answer. Use it before hosting or joining to choose among relays in several regions. `relay` is
    --- `host:port`; if omitted, the project's `[network] relay` is used. The method yields until the
    --- relay has answered three requests sent a tenth of a second apart, or until `timeout` seconds
    --- have passed (1.5 by default). The result has `Ping`, the shortest of the three round trips in
    --- milliseconds; `Matches`, the matches registered with the relay; `Relayed`, the players it is
    --- relaying; `BytesPerSecond`, its traffic; and `Uptime`, in seconds. It does not need a match and
    --- does not disturb one, and several relays can be pinged at once from separate tasks.
    function PingRelayAsync(self, relay: string?, timeout: number?): { Ping: number, Matches: number, Relayed: number, BytesPerSecond: number, Uptime: number }?
    --- Says how often each player may do one of the game's own actions: `PerSecond` of them a second,
    --- up to `Burst` at once (1 when not given). Said again for the same name, it replaces the first.
    --- `CheckAction` then counts each player's.
    function DefineAction(self, name: string, rule: { PerSecond: number, Burst: number? }): ()
    --- Whether this player may do the action now, by the rate `DefineAction` gave it, counted by the
    --- simulation's clock. True takes one; false is logged as a suspicion (`action_over_rate`), and
    --- what to do about it is the game's. Raises an error for an action never defined.
    function CheckAction(self, player: Player, name: string): boolean
    --- Writes a line in the suspicion log, beside those the engine writes when a player goes past a
    --- limit. The server console's `suspects` and `suspect` read it, and `/metrics` counts it by
    --- `kind`. Nothing is done to the player by it.
    function ReportSuspicion(self, player: Player, kind: string, detail: string?): ()
    --- Whether the server console has muted this player (`mute`), by their account where the game named
    --- one, else by their key. What a mute stops, such as chat or voice, is the game's to decide.
    function IsMuted(self, player: Player): boolean
    --- Returns statistics about the connection, as a table. Use them to show a connection quality
    --- indicator. Every number is 0 in single-player. On an authority, the link numbers are those of
    --- the worst client and the deepest input queue. Link quality: - `Ping`: the round trip, in
    --- milliseconds. - `Jitter`: how much the round trip varies. - `Loss`: the share of packets lost,
    --- in percent. - The number of snapshots per second. - `Corrections`: how often this machine's own
    --- character was corrected, per second and in total since joining. `LastCorrection` is how far the
    --- last correction moved it, in meters. - `PredictedDrift`: how far the parts this machine predicts
    --- were from the authority's at the last answer, in meters, whether or not that was a correction.
    --- These are what its character pushes and the vehicle it drives. A driven vehicle is left a few
    --- centimeters of drift and pulled back gently, so this stays small but is rarely zero.
    --- `PredictedDriftPart` is the part that was furthest, or nil. - `InputBufferDepth`: how many ticks
    --- of this player's input the authority has queued. `InputStarvations` counts the times the queue
    --- ran empty, and `InputReanchors` the times it was restarted because the player's clock jumped, as
    --- after a long frame. - `InterpolationDelay`: how far in the past other players are drawn, in
    --- milliseconds. It is two snapshot intervals plus the link's jitter, and adapts to the link. - On
    --- a client, `PredictedParts` is the number of loose parts near its character that it predicts. The
    --- table also reports how often a correction made the client simulate them again, how many ticks it
    --- simulated again, and `ResimulationTime`, the average time that took in milliseconds. Traffic:
    --- `BytesSent` and `BytesReceived` are totals since the session began. Five more fields break the
    --- total down, sent and received together: `SnapshotBytes` for world state, `AttributeBytes` for
    --- attributes, `RemoteBytes` for `RemoteEvent`s and `RemoteFunction`s, `UnreliableBytes` for
    --- `UnreliableRemoteEvent`s, and `InputBytes` for a client's input and the state of the parts it
    --- owns. `SwarmBytes` is the positions of replicated swarms. The remainder is instances being
    --- created and removed, terrain and the handshake. To get a rate, read a field twice, one second
    --- apart, and subtract. `CrossWorldDropped` counts `CrossWorldService` messages this world dropped
    --- unheard: too many waiting, or older than 10 seconds when their turn came. `WireBytesSent` and
    --- `WireBytesReceived` are what the network itself carried: the same messages with the transport's
    --- headers, acknowledgements, resends and encryption added. They are what a player's connection
    --- pays for, and are larger than `BytesSent` and `BytesReceived`. On an authority, `Deferred`
    --- counts the updates its players' budgets held back in the last second
    --- (`Player.ReplicationBudget`), and `BudgetUsed` is how much of those budgets that second's
    --- snapshots spent, from 0 to 1; above 1 when what may not wait, such as a player joining, spent
    --- more. Both are 0 on a client. `Path` says how the other end is reached: `"lan"` on the same
    --- network, `"direct"` across the internet, or `"relayed"` through a relay, which adds the relay's
    --- distance to the round trip. On a host it is the longest path among its players. It is empty when
    --- nobody is connected. `LocalPlayers` has one entry for each local player on a machine that joined
    --- a match: the primary player first, then the guests. Each entry has the player's `UserId` and the
    --- three correction numbers for that player's character alone. It is empty on an authority and in
    --- single-player.
    function GetStats(self): { Ping: number, Jitter: number, Loss: number, SnapshotsPerSecond: number, CorrectionsPerSecond: number, Corrections: number, LastCorrection: number, PredictedDrift: number, PredictedDriftPart: BasePart?, InputBufferDepth: number, InputStarvations: number, InputReanchors: number, InterpolationDelay: number, PredictedParts: number, ResimulationsPerSecond: number, ResimulatedTicksPerSecond: number, ResimulationTime: number, UnreliableSent: number, UnreliableReceived: number, UnreliableDropped: number, BytesSent: number, BytesReceived: number, WireBytesSent: number, WireBytesReceived: number, Deferred: number, BudgetUsed: number, SwarmBytes: number, SnapshotBytes: number, AttributeBytes: number, RemoteBytes: number, UnreliableBytes: number, InputBytes: number, CrossWorldDropped: number, Path: string, LocalPlayers: { { UserId: number, Corrections: number, CorrectionsPerSecond: number, LastCorrection: number } } }
    --- Connects to a server at `address`, written as `host` or `host:port`. With no address, it
    --- connects to `[network] server` from `project.toml`. Joining replaces this machine's scene with
    --- the server's, and server scripts stop, because this machine is no longer the authority.
    --- `Connected` or `JoinFailed` fires with the outcome. A dedicated server cannot join. `address`
    --- can also be a join code, when a relay is known from `options.Relay` or `[network] relay`. A code
    --- is accepted as a player types it: in either case, with spaces or a dash. The relay is asked for
    --- the host, and the best available path is used automatically: the same network, a direct
    --- connection across the internet, or the relay. `GetStats().Path` reports which. Set
    --- `options.Direct` to false to always go through the relay. `relay://host:port/CODE` gives the
    --- relay and the code in one string. To connect to a host whose name could be read as a code,
    --- include its port. `options.Ticket` is what this player presents to be let in: a ticket the
    --- game's backend signed when they logged in. It travels inside the encrypted connection, and the
    --- server's `OnJoinRequest` reads it.
    function Join(self, address: string?, options: { Relay: string?, Direct: boolean?, Ticket: string? }?): ()
    --- Makes this machine the authority of a match that others can join, on `port` (7777 by default),
    --- keeping the current scene. A dedicated server cannot call it. With a relay, from `options.Relay
    --- = "host:port"` or `[network] relay`, the match is registered with the relay, and players
    --- anywhere can join it with `JoinCode`, with no port opened on a router. Hosting does not wait for
    --- the relay or depend on it: `RelayState` reports the relay's state, and the match can always be
    --- joined by address.
    function Host(self, port: number?, options: { Relay: string? }?): ()
    --- Leaves the match, or stops hosting, and returns to single-player in the current scene. Server
    --- scripts start again from the beginning, because this machine is the authority again.
    --- `Disconnected` fires. A dedicated server cannot call it.
    function Disconnect(self): ()
    --- Sends `player` to another world of the game: `target` is a world's name from `servers.toml`, or
    --- an instance's `Id`. Their machine leaves this world and joins that one, which fires
    --- `TravelArrived` with `data` and the name of this world. `data` is anything `SaveService` can
    --- store, at most 16 KiB. Their character does not travel; the target spawns one. Only a world a
    --- manager started can send players elsewhere: anywhere else, and for a world the manager does not
    --- have, this raises at once. Returns whether `player` was sent. A player who left while the script
    --- waited, for `CreateInstanceAsync` say, is not an error: they are gone, nothing is sent, and it
    --- returns false.
    function Travel(self, player: Player, target: string, data: any?): boolean
    --- Sends `player` to channel `channel` of the world this server is, for a channel menu: as `Travel`
    --- does, and with `TravelArrived` there. A channel that is not open, or full, leaves them where
    --- they are, and a warning says why. Only a world a manager started can call it. Returns whether
    --- `player` was asked to go: false for a player who has left.
    function SwitchChannel(self, player: Player, channel: number): boolean
    --- Sends `player` to the world, and the channel of it, where the player whose `PublicKey` is `key`
    --- is now: a friend, a party's leader. When that world is full, or the other player is in none,
    --- they stay where they are, and a warning says why. Returns whether `player` was asked to go:
    --- false for a player who has left.
    function TravelToPlayer(self, player: Player, key: string): boolean
    --- Returns the open channels of the world this server is, each with how many players it holds and
    --- may hold, as the manager last heard. It waits for the manager's answer. For a world without
    --- channels, the one entry is this world.
    function GetChannelsAsync(self): { { Channel: number, Players: number, MaxPlayers: number } }
    --- Sends several players to the same world together, as `Travel` sends one. The target fires
    --- `TravelArrived` for each, in the order given. Returns the players sent, in the order given. Any
    --- who left while the script waited are skipped, not an error, and the rest still go together; when
    --- none is left, it returns an empty table and sends nobody.
    function TravelGroup(self, players: {Player}, target: string, data: any?): {Player}
    --- Checks a ticket the game's backend signed, on the server and with no call out, and returns its
    --- claims, or nil. The ticket is a standard JWT signed with Ed25519 (`EdDSA`), which any backend's
    --- JWT library issues. A ticket is accepted when its signature checks against `ticket_public_key`
    --- under `[network]` in `project.toml`, its `aud` is this game's `[project] id`, it lives at most
    --- 90 seconds between `iat` and `exp` and has not expired, and its `jti` has not been seen before
    --- by this server. Clocks may differ by 30 seconds each way. The algorithm is never the ticket's to
    --- choose: one that says anything but `EdDSA`, including `none`, is refused before its signature is
    --- looked at, and a key the ticket names is ignored. What was wrong is written to the server's log,
    --- never told to the player. The claims are the ticket's top-level strings, numbers and booleans:
    --- `sub`, the account, and whatever else the backend put in.
    function VerifyTicket(self, ticket: string): { [string]: any }?
    --- Forgets the key this machine saved for the server at `address`, written as for `Join`. The first
    --- time a machine joins a server by its address, it saves the server's key, and a later join to the
    --- same address with another key fails with `JoinFailed`: someone may be in the way. A server whose
    --- owner reinstalled it has a new key too. A game can offer the player a way to trust it again:
    --- call this, then `Join`. Joining by code saves nothing, so there is nothing to forget.
    function ForgetServerKey(self, address: string): ()
end

declare extern type RemoteEvent extends Instance with
    --- Fires on a machine with local guests when the authority sends a message to one of its guest
    --- players. Passes that player, followed by the arguments. Messages to the primary player and to
    --- all clients fire `ClientReceived` instead.
    read LocalClientReceived: Signal<(Player, ...any)>
    --- Fires on the authority when a player's machine calls `FireServer`. Passes the player who sent
    --- the message, followed by the arguments. The sender is reliable, because it comes from the
    --- connection; treat the arguments as claims by the client and validate them.
    read ServerReceived: Signal<(Player, ...any)>
    --- Fires on a player's machine when the authority calls `FireClient` for that player or
    --- `FireAllClients`.
    read ClientReceived: Signal<...any>
    --- Sets how often each client may call this remote on the authority, in calls a second. Up to
    --- `burst` may come at once (twice `perSecond`, and at least 480, when not given). Calls past it
    --- are dropped before any script sees them and are logged as a suspicion. Nought lifts the limit,
    --- for a game's own heavy channel. Without it a remote takes 240 calls a second with a burst of
    --- 480, and calls of up to 16 KiB; the attributes `RateLimit`, `Burst` and `MaxBytes` hold the same
    --- numbers.
    function SetRateLimit(self, perSecond: number, burst: number?): ()
    --- Sends a message to the authority on behalf of one of this machine's local players, on a machine
    --- that is itself the authority. `ServerReceived` fires with that player. Raises an error on a
    --- client, and for a remote player or a guest that has been removed. `FireServer` always sends as
    --- the primary local player.
    function FireServerFor(self, player: Player, ...: any): ()
    --- Sends the arguments to the authority, where `ServerReceived` fires with this machine's player
    --- followed by the arguments. On an authority that has a player of its own, in single-player or
    --- when hosting, the event fires locally. Raises an error on a dedicated server, which has no
    --- player.
    function FireServer(self, ...: any): ()
    --- Sends the arguments to one player's machine, where `ClientReceived` fires. Only the authority
    --- can call it; it raises an error on a client.
    function FireClient(self, player: Player, ...: any): ()
    --- Sends the arguments to every player's machine, including a host's own. Only the authority can
    --- call it; it raises an error on a client.
    function FireAllClients(self, ...: any): ()
end

declare extern type UnreliableRemoteEvent extends Instance with
    --- Fires on a machine with local guests when the authority sends a message to one of its guest
    --- players. Passes that player, followed by the arguments. Messages to the primary player and to
    --- all clients fire `ClientReceived` instead.
    read LocalClientReceived: Signal<(Player, ...any)>
    --- Fires on the authority when a message that a player's machine sent with `FireServer` arrives.
    --- Passes the player who sent it, followed by the arguments. Treat the arguments as claims by the
    --- client and validate them.
    read ServerReceived: Signal<(Player, ...any)>
    --- Fires on a player's machine when a message arrives that the authority sent with `FireClient` for
    --- that player or with `FireAllClients`.
    read ClientReceived: Signal<...any>
    --- Sets how often each client may call this remote on the authority, in calls a second. Up to
    --- `burst` may come at once (twice `perSecond`, and at least 480, when not given). Calls past it
    --- are dropped before any script sees them and are logged as a suspicion. Nought lifts the limit,
    --- for a game's own heavy channel. Without it a remote takes 240 calls a second with a burst of
    --- 480, and calls of up to 16 KiB; the attributes `RateLimit`, `Burst` and `MaxBytes` hold the same
    --- numbers.
    function SetRateLimit(self, perSecond: number, burst: number?): ()
    --- Sends a message to the authority on behalf of one of this machine's local players, on a machine
    --- that is itself the authority. `ServerReceived` fires with that player. Raises an error on a
    --- client, and for a remote player or a guest that has been removed. `FireServer` always sends as
    --- the primary local player.
    function FireServerFor(self, player: Player, ...: any): ()
    --- Sends the arguments to the authority once. If the message arrives, `ServerReceived` fires there
    --- with this machine's player followed by the arguments. On an authority that has a player of its
    --- own, the event fires locally. Raises an error on a dedicated server, which has no player.
    function FireServer(self, ...: any): ()
    --- Sends the arguments to one player's machine once. If the message arrives, `ClientReceived` fires
    --- there. Only the authority can call it; it raises an error on a client.
    function FireClient(self, player: Player, ...: any): ()
    --- Sends the arguments to every player's machine once, including a host's own. Only the authority
    --- can call it; it raises an error on a client.
    function FireAllClients(self, ...: any): ()
end

declare extern type RemoteFunction extends Instance with
    --- Called on the authority to answer `InvokeServerAsync`. It receives the player who asked,
    --- followed by the arguments, and returns the answer. It runs in its own thread and can yield. Set
    --- it once, in a server script; a callback set on a client is never called.
    OnServerInvoke: ((player: Player, ...any) -> ...any)?
    --- Sets how often each client may call this remote on the authority, in calls a second. Up to
    --- `burst` may come at once (twice `perSecond`, and at least 480, when not given). Calls past it
    --- are dropped before any script sees them and are logged as a suspicion. Nought lifts the limit,
    --- for a game's own heavy channel. Without it a remote takes 240 calls a second with a burst of
    --- 480, and calls of up to 16 KiB; the attributes `RateLimit`, `Burst` and `MaxBytes` hold the same
    --- numbers.
    function SetRateLimit(self, perSecond: number, burst: number?): ()
    --- Sends a request to the authority, yields until it answers, and returns what its `OnServerInvoke`
    --- returned. Raises an error if the handler raised one, or if the server has no handler. On an
    --- authority that has a player of its own, in single-player or when hosting, the handler is called
    --- locally as that player at the start of the next tick. Raises an error on a dedicated server,
    --- which has no player.
    function InvokeServerAsync(self, ...: any): ...any
end

declare extern type Player extends Instance with
    --- The camera a local player looks through. When `Workspace.ScreenSplit` is set, every local player
    --- that has a camera gets a view in the window; with nil, the player has no view of its own. It is
    --- local to this machine, is not replicated, and has no meaning for a player that is not local.
    Camera: Camera?
    --- The id of the gamepad a local player uses, as numbered by `InputService:GetGamepads`; 0 means
    --- none is assigned. It selects which gamepad navigates that player's interfaces (see
    --- `ScreenGui.Player`). It does not affect input actions: an `InputContext` has its own
    --- `GamepadId`. The game sets it when a gamepad joins.
    GamepadId: number
    --- The number the authority gives this player. It is 1 for the player on a single-player or hosting
    --- machine, and 2 and up for clients in the order they joined. It is never reused within a session,
    --- and a player who reconnects while the server runs gets the same one. It is not kept when the
    --- server restarts: what lasts is `PublicKey`, and an account id a game gives its players
    --- (`NetworkService.OnJoinRequest`).
    read UserId: number
    --- The account the game knows this player as, on the server: what its
    --- `NetworkService.OnJoinRequest` set when they joined, or nil. Two joins with the same account are
    --- one player: the second drops the first.
    read AccountId: string?
    --- The key this player's game proved when it joined, in hexadecimal. It is the same on every
    --- connection from the same copy of the game, and after the server restarts. On the server every
    --- player has one; on a client only its own players do. Empty where the match is not encrypted.
    --- Saved data and a ban are kept by it; a player who deletes their game's key file is a new player,
    --- so a game with accounts keys what lasts by its own account id.
    read PublicKey: string
    --- The part that represents this player in the world: a `CharacterBody`, a vehicle or whatever the
    --- game moves for them. For a character on the 2D plane, use `Character2D`. The game sets it on the
    --- authority, and it replicates: on each machine, the `Player` refers to that machine's copy of the
    --- part. The engine uses it for three things. A client predicts its own player's character: its
    --- local scripts move it immediately, and the authority's updates correct it instead of overwriting
    --- it. A client draws every other player's character interpolated between updates. And the
    --- authority sends each client only the instances near that client's character, within
    --- `StreamingService.LoadRadius`; a client whose player has no character is sent everything.
    Character: BasePart?
    --- The part used in place of this player's character to decide what is sent to their machine. For
    --- example, set it to a friend's character while a defeated player spectates. With nil, the
    --- default, the player's own `Character` is used. Only the authority sets it. It controls which
    --- parts are streamed to the player and which agents of a replicated `Swarm` are sent. It does not
    --- change which character the client predicts.
    ReplicationFocus: BasePart?
    --- The most of the world's state, in kilobytes (1,024 bytes) a second, this player's machine is
    --- sent. 0, the default, is the game's `client_budget_kb_per_second` under `[network]` in
    --- `project.toml`, which is 48 unless the game says otherwise. When more changes than that, the
    --- authority sends what matters most to this player first: their own character and what they own,
    --- always; then what is nearest them, times `BasePart.ReplicationPriority`, times
    --- `SetReplicationPriority`. What waits keeps growing in priority until it is sent, and a changed
    --- part waits no more than about a second while the budget can carry each once a second. Messages a
    --- script sends (`RemoteEvent`) and what a player is sent as they join are not counted. Only the
    --- authority reads it. A player on a weak network, or a spectator, can be given less.
    ReplicationBudget: number
    --- The `Part2D` that represents this player on the 2D plane; the 2D counterpart of `Character`. A
    --- player has one character: setting either property clears the other, and each reads nil while the
    --- other is set. There are two properties so that each has the right type. It is used the same way
    --- as `Character`. The authority sends each client the instances near its character. On the
    --- player's own machine, the character is not drawn from past updates: what local scripts did to it
    --- is kept, and the authority's updates correct it by the difference. A client that moves it with
    --- the same code the server uses is never corrected; the multiplayer guide shows the pattern. On a
    --- client that does not move it, it is at the position of the newest update.
    Character2D: Part2D?
    --- Returns the value of this player's input action of the given name for the current tick. The type
    --- is the one `InputAction:GetState` returns: a boolean, a number, a `Vector2` or a `vector`. For
    --- the local player it is this machine's own action; for a remote player it is the value their
    --- machine sent. An action the player never sent reads false.
    function GetIntent(self, action: string): boolean | number | Vector2 | vector
    --- Returns this player's network round trip, in milliseconds, for a scoreboard. On the server it is
    --- the round trip to that player's machine, which a machine's other players share. On a client it
    --- is this machine's own, for its own players. It is 0 for the host's own player, in a
    --- single-player game, for another machine's player on a client, and for a player who has left; it
    --- never raises.
    function GetNetworkPing(self): number
    --- Puts this player in `phase`: they see, and collide with, what has that `Phase`. Only the server
    --- calls it; the player's own machine is told, and reads it with `HasPhase` and `GetPhases`. A
    --- world names at most 64 phases, and the 65th raises.
    function AddPhase(self, phase: string): ()
    --- Takes this player out of `phase`: what has that `Phase` leaves their machine within a snapshot.
    --- Only the server calls it.
    function RemovePhase(self, phase: string): ()
    --- Whether this player is in `phase`.
    function HasPhase(self, phase: string): boolean
    --- The phases this player is in, in no particular order.
    function GetPhases(self): {string}
    --- Whether this player is in the phase of `instance` and of everything above it: what decides
    --- whether it is sent to them. For a game's own hit and interaction code. It says nothing of
    --- distance.
    function CanSee(self, instance: Instance): boolean
    --- How much `instance`'s changes come first for this player alone, on top of its
    --- `BasePart.ReplicationPriority`. Use 4 for a party member's character, and 0.5 for what this
    --- player hardly needs. 1 forgets what was set. It matters only when the player's budget
    --- (`ReplicationBudget`) cannot carry every change at once. Only the authority calls it; on a
    --- client it raises an error. A player keeps at most 256 of these; the instance being destroyed
    --- forgets it.
    function SetReplicationPriority(self, instance: Instance, priority: number): ()
    --- Removes this player from the match. Only the authority can call it, and only on a player who
    --- joined: it raises an error on a client, and when a host calls it on its own player. The player's
    --- machine returns to single-player, and its `NetworkService.Disconnected` fires with `reason`:
    --- text the game provides, up to 512 bytes, or the engine's default text. That machine does not
    --- reconnect by itself. On the authority, `PlayerRemoving` fires at the end of the frame, as for
    --- any player who leaves. Nothing stops the player from joining again; to ban a player, keep a list
    --- and remove them when they join.
    function Kick(self, reason: string?): ()
end

declare extern type RunService extends Instance with
    --- How fast this world's clock runs against the wall's: 1 at full speed, less while an overloaded
    --- server is slowed (`[server] time_dilation` in `project.toml`). The tick is the same, so `dt` and
    --- what a tick does do not change; fewer ticks run a second, and every machine in the match runs at
    --- the same rate. `task.wait`, animations and sounds driven by the simulation slow with it; the
    --- interface, the camera and `os.time` do not. `TimeDilationChanged` fires when it changes.
    read TimeDilation: number
    --- The operating system this machine runs: `Windows`, `Linux`, `MacOS`, `Android` or `IOS`. On a
    --- dedicated server, it is the server's operating system.
    read Platform: EnumPlatform
    --- The simulation time at the current tick, in seconds. It is constant during a tick and advances
    --- by `PhysicsService.FixedTimestep` between ticks. It stops while the world is paused. Simulation
    --- code should use this clock. `os.clock` measures real time and is only for profiling.
    read SimTime: number
    --- Fires when `TimeDilation` changes: an overloaded server slowing its world, or bringing it back
    --- to full speed. A game can say so to its players.
    read TimeDilationChanged: Signal<()>
    --- Fires every frame before the frame is drawn, after the functions bound with `BindToRenderStep`.
    --- Passes the time since the previous frame, in seconds. Its handlers run in a render step:
    --- `GetRenderCFrame` returns where things are drawn, and a camera set there is drawn exactly as
    --- set. It never fires in a headless run.
    read PreRender: Signal<number>
    --- Fires at the start of each simulation tick, before animation is evaluated. Passes the fixed tick
    --- length, in seconds.
    read PreAnimation: Signal<number>
    --- Fires each simulation tick, after animation and before the physics step. Passes the fixed tick
    --- length, in seconds.
    read PreSimulation: Signal<number>
    --- Fires each simulation tick, immediately after the physics step. Passes the fixed tick length, in
    --- seconds.
    read PostSimulation: Signal<number>
    --- Fires at the end of each simulation tick. Passes the fixed tick length, in seconds. It is the
    --- usual place for gameplay code that runs every tick and needs the state the tick ended in.
    read Heartbeat: Signal<number>
    --- Pauses the world. The simulation clock stops: `SimTime` stops advancing, and no `task.wait` or
    --- `task.delay` timer completes. Rendering and the debug overlay keep running. Pausing a world that
    --- is already paused does nothing.
    function Pause(self): ()
    --- Resumes a paused world and its clock. Resuming a world that is running does nothing.
    function Resume(self): ()
    --- Binds a function that runs as `fn(dt)` on every drawn frame, where `dt` is the time since the
    --- last frame. Use it for a camera that follows something: inside the function, `GetRenderCFrame`
    --- returns where things are drawn, and a camera set there is drawn exactly as set. Bound functions
    --- run in order of `priority`, lowest first, and in the order they were bound when priorities are
    --- equal. They run after the input that the frame reads for contexts with `Rate = Render`, and
    --- before `PreRender` fires. `Enum.RenderPriority` provides reference values:
    --- `Enum.RenderPriority.Camera.Value + 1` runs just after the camera. Binding a name that is
    --- already bound replaces the function. Nothing runs in a run without a window. A binding belongs
    --- to the script that made it and is removed with that script's scene.
    function BindToRenderStep(self, name: string, priority: number, fn: (dt: number) -> ()): ()
    --- Binds a function that runs as `fn(intent)` on every simulation tick, just after this machine's
    --- input has become its player's intents. Use it for input that is not an `InputAction`, such as a
    --- turn computed from the mouse, a touch gesture or a bot. `intent:Set(action, value)` sets an
    --- intent by name to a boolean, a number, a `Vector2` or a `vector`. Every reader of
    --- `Player:GetIntent` sees the value, on this machine and, in a match, on the authority. A value
    --- set this way overrides an `InputAction` of the same name. The `intent` object is valid only
    --- during the call. The optional `player` argument selects a local guest; with nil, the primary
    --- local player is used. A binding for a guest that has been removed is skipped. Functions run in
    --- the order they were bound. Binding a name that is already bound replaces the function, and a
    --- binding belongs to the script that made it and is removed with that script's scene.
    function BindToIntent(self, name: string, fn: (intent: IntentWriter) -> (), player: Player?): ()
    --- Removes the function bound with `BindToIntent` under `name`. Does nothing if no function is
    --- bound under that name.
    function UnbindFromIntent(self, name: string): ()
    --- Binds a function that runs as `fn(step)` inside the simulation step, before physics is solved.
    --- It runs once for each player character this machine simulates: every character on the authority,
    --- and the client's own on a client. Use it for movement that a script controls and a client should
    --- predict without correction at any latency, such as a dash, a double jump, a dodge or a jump pad.
    --- What the function does to the character is part of the step: calling `Move` or `Jump`, or
    --- setting a velocity, an impulse, a position or an attribute. When a client is corrected and
    --- simulates its character again, the function runs again for each replayed tick, with the input of
    --- that tick, and `step.Replaying` is true. Read the player's input from `step` with `GetIntent`
    --- and `Pressed`, and measure time with `step.Tick`, the player's own tick number, which is the
    --- same on the client and the authority. An attribute the function sets on `step.Character` is
    --- predicted state: it is saved every tick, restored before a tick is replayed, and corrected by
    --- the authority's value. Use `step.Random` for random numbers, never an unseeded `Random`. The
    --- function must not yield; `task.wait` inside it raises an error. Functions run in the order they
    --- were bound. Binding a name that is already bound replaces the function, and a binding belongs to
    --- the script that made it and is removed with that script's scene. In a single-player game the
    --- function runs once per tick and is never replayed.
    function BindToPredictedStep(self, name: string, fn: (step: PredictedStep) -> ()): ()
    --- Removes the function bound with `BindToPredictedStep` under `name`. Does nothing if no function
    --- is bound under that name.
    function UnbindFromPredictedStep(self, name: string): ()
    --- Removes the function bound with `BindToRenderStep` under `name`. Does nothing if no function is
    --- bound under that name.
    function UnbindFromRenderStep(self, name: string): ()
    --- Returns whether the world is paused.
    function IsPaused(self): boolean
    --- Returns how the previous run of the game ended on this machine, and where its report is. Call it
    --- at startup to offer the player a way to send a crash report: the engine uploads nothing and
    --- shows nothing by itself. `Outcome` is `Clean` when the run was asked to end and did, `Crashed`
    --- when it ended in a fault, and `None` when there was no previous run. `Unfinished` means it ended
    --- without a fault and without being asked to, which is normal on a phone, where the system closes
    --- games in the background. `ScriptErrors` is the number of script errors that nothing caught, and
    --- `FirstScriptError` is the first of them. `Report` is the path of a text file written for a run
    --- that crashed, was left unfinished or had script errors. The file identifies the game and the
    --- engine and holds the crash note and the end of that run's log. It is nil if the run left nothing
    --- to report. `Dump` is the crash dump next to it, on a system that writes one. A typical check is
    --- `if last.Outcome == Enum.RunOutcome.Crashed or last.ScriptErrors > 0 then`. On a phone, the file
    --- is in the game's own folder, `Android/data/<package>/files`, which a cable or the system's file
    --- browser can open without a permission. The result describes this machine and is the same on a
    --- host and on a client.
    function GetLastRun(self): { Outcome: EnumRunOutcome, ScriptErrors: number, FirstScriptError: string?, Report: string?, Dump: string? }
    --- Returns the current state of the 3D simulation as a buffer, to roll back to later. It holds the
    --- physics solver's state and the position and motion of every simulated part and character. It
    --- does not hold which instances exist, their other properties, the 2D layer or script variables. A
    --- rollback game keeps its own state alongside and restores both. The result is deterministic: the
    --- same world saved on two machines gives the same bytes.
    function SaveSimulation(self): buffer
    --- Restores a state that `SaveSimulation` returned, and returns true. Returns false and changes
    --- nothing if the buffer is not a saved simulation, or if the world's simulated parts and
    --- characters differ from those the state was saved with because one was created, destroyed or
    --- anchored since.
    function RestoreSimulation(self, state: buffer): boolean
    --- Advances the 3D simulation by one fixed tick immediately, without running scripts and without
    --- firing `Touched` or `TouchEnded`. Use it to simulate again after `RestoreSimulation`: for each
    --- tick to catch up, set that tick's inputs, such as a character's `MoveDirection` or an impulse,
    --- and call it once.
    function StepSimulation(self): ()
end

