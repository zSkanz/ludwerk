    function ClearParameter(self, name: string): ()
    --- Returns the name of the state a layer is in. During a fade, that is the state being faded into.
    --- With no layer name, the first layer is used. Returns an empty string if no graph is loaded or
    --- the graph has no such layer.
    function GetState(self, layer: string?): string
