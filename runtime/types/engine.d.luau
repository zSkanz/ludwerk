    --- plays twice. `fadeTime` fades the track's weight in from 0 to its `Weight` over that many
    --- seconds, which blends it smoothly with what is already playing.
    function Play(self, fadeTime: number?): ()
    --- Stops the track. With `fadeTime`, its weight fades out over that many seconds and the track
    --- stops when the weight reaches 0. Without it, the track stops immediately. `Ended` does not fire
    --- in either case.
    function Stop(self, fadeTime: number?): ()
end

declare extern type Material with
    --- The path of the material file this handle comes from. For a clone, including a clone of a clone,
    --- it is the file the original was loaded from.
    read Source: Content
    --- The base color of the surface. It is multiplied by `ColorMap` if there is one.
    Color: Color3
    --- How transparent the surface is, from 0 (opaque) to 1 (invisible).
    Transparency: number
    --- The base color image, multiplied by `Color`. It holds color data in sRGB, unlike the normal and
    --- metallic-roughness maps, which hold linear data.
    ColorMap: Content
    --- A normal map in tangent space. It holds linear data, not color.
    NormalMap: Content
    --- An image with occlusion in its red channel, roughness in green and metalness in blue, as in
    --- glTF. It holds linear data, not color.
    MetallicRoughnessMap: Content
    --- The color of the light the surface gives off by itself. It makes the surface bright but does not
    --- light other objects; use a `PointLight` for that.
    Emissive: Color3
    --- An image of the light the surface gives off, multiplied by `Emissive`. It holds color data.
    EmissiveMap: Content
    --- How metallic the surface is, from 0 (not a metal, such as plastic, stone or wood) to 1 (bare
    --- metal).
    Metalness: number
    --- How rough the surface is, from 0 (a mirror) to 1 (fully matte). The default is 0.7.
    Roughness: number
    --- The strength of the normal map. 1 uses the map as authored, and 0 gives a flat surface.
    NormalScale: number
    --- How the alpha of the base color is used. `Opaque` ignores it, `Mask` draws only the pixels whose
    --- alpha is at least `AlphaCutoff`, and `Blend` blends the surface with what is behind it.
    AlphaMode: EnumAlphaMode
    --- The alpha threshold for `Mask` mode. It is used only in that mode.
    AlphaCutoff: number
    --- Whether back faces are drawn. Turn it on for thin surfaces such as leaves and cloth.
    DoubleSided: boolean
    --- The size of one repeat of the textures on a part's faces, in meters. A face shows as many
    --- repeats as fit along it, so the texture has the same scale on every face of a part. At 0, each
    --- texture is stretched over the whole face. A `MeshPart` uses the UVs from its file instead. A
    --- terrain layer also repeats at this size.
    TileSize: number
    --- A height image for a terrain layer, in which white is high. Where two layers meet, the higher
    --- one shows through. Only terrain uses it.
    HeightMap: string
    --- Whether a terrain layer's textures are projected along three axes, so that they do not stretch
    --- on a cliff. On by default. Only terrain uses it.
    Triplanar: boolean
    --- How sharp the edge is where this terrain layer meets another, from 0 (a wide fade) to 1 (a sharp
    --- line that follows the height map). Only terrain uses it.
    BlendSharpness: number
    --- How much a large-scale pattern, tens of meters across, varies the color of a terrain layer, from
    --- 0 (none) to 1. It hides the repetition of the texture. The default is 0.5. Only terrain uses it.
    TilingVariation: number
    --- The scale of a second, larger sample of a terrain layer's textures that is blended in with
    --- distance, from 1 (none) to 32. The default is 6. Only terrain uses it.
    TilingFarScale: number
    --- Whether a terrain layer's textures are placed in hexagonal cells, each randomly offset and
    --- rotated, with blended borders. It hides repetition, which shows most in photographic textures.
    --- It samples each texture three times instead of once. Off by default. Only terrain uses it.
    HexTiling: boolean
    --- How much a body that touches this surface resists sliding. A part uses its material's friction
    --- unless the part's own `Friction` is set, and terrain uses the friction of the material drawn at
    --- each point. The default is 0.3.
    Friction: number
    --- The fraction of its speed a body keeps when it bounces off this surface, from 0 (no bounce) to
    --- 1. The default is 0.
    Restitution: number
    --- The sound of a footstep on this surface, as a content path, or an empty string. The engine does
    --- not play it; a game reads it through `CharacterBody.FloorMaterial` and plays it in time with the
    --- character's steps.
    FootstepSound: Content
    --- Labels a game can read from a surface, such as "slippery", "metal" or "lava", in the order the
    --- material lists them. Each read returns a new table.
    Tags: { string }
    --- Returns a copy of the material that can be changed. The copy has the same properties and the
    --- same `Source`, exists only at run time and is never saved. Assign it with `part.Material = copy`
    --- and then change it: every part that uses the copy changes, and nothing else does.
    function Clone(self): Material
    --- Returns the value this material sets for a parameter of its surface shader, or nil if it leaves
    --- the parameter at the shader's default. The value is a number, a `Vector2`, a `vector` (also used
    --- for a color), a table of four numbers, or the path of a texture.
    function GetShaderParameter(self, name: string): (number | Vector2 | vector | { number } | string)?
    --- Sets a parameter of the material's surface shader. It works only on a clone, because a loaded
    --- material is shared and read-only. A string value is the path of a texture. Every part that uses
    --- the clone is drawn with the new value from the next frame. The value is not replicated: set it
    --- on the machine that draws the part.
    function SetShaderParameter(self, name: string, value: number | boolean | Vector2 | vector | Color3 | { number } | string): ()
end

declare extern type Instance with
    --- The name of this instance. Siblings can share a name. Renaming an instance to a name that a
    --- `WaitForChild` call is waiting for resumes that call, as parenting a new child would.
    Name: string
    --- The instance this one is a child of, or nil when it has no parent. Setting it adds this instance
    --- after its new siblings. Setting it after `Destroy` raises an error.
    Parent: Instance?
    --- The name of this instance's class. `typeof` returns `Instance` for every class, so use
    --- `ClassName` or `IsA` to tell classes apart.
    read ClassName: string
    --- The phase this instance and everything under it belong to, seen only by the players in it.
    --- Empty, the default, is everybody's. A player not in the phase (`Player:AddPhase`) is not sent
    --- the instance at all: it is absent on their machine, not hidden. It leaves their machine when
    --- they leave the phase, as a thing out of range does. It is the server's to say and is not itself
    --- sent. A phased part collides with the characters, and the parts, of the players in its phase,
    --- and never with those of players who are not; everything else collides with it as with any part
    --- (`BasePart.PhaseCollision`). A world names at most 64 phases.
    Phase: string
    --- Whether this instance exists only on this machine and is never sent to another. It is true for
    --- an instance that a client-side script made with `Instance.new` or `Clone`, and for everything
    --- under it. A client-side script is one under `ClientScriptService`, in the client half of
    --- `GlobalScriptService`, or with a `RunContext` other than `Server`; this applies on a host as
    --- well as on a machine that joined. Instances made by server-side scripts or loaded from a scene
    --- are not local, and replicate. The value records who made the instance, not who writes to it
    --- later: a client-side script on a host that sets a property of a replicated instance changes it
    --- for every player.
    read Local: boolean
    --- Fires after an instance becomes a child of this one. Passes the child.
    read ChildAdded: Signal<Instance>
    --- Fires after an instance stops being a child of this one. Passes the child.
    read ChildRemoved: Signal<Instance>
    --- Fires after an instance is added anywhere below this one. Passes the descendant.
    read DescendantAdded: Signal<Instance>
    --- Fires when an instance is removed from anywhere below this one. Passes the descendant. When an
    --- instance moves from one parent to another, the removal fires before the addition.
    read DescendantRemoving: Signal<Instance>
    --- Fires when this instance or one of its ancestors is given a new parent. Passes the instance that
    --- moved and its new parent, which is nil if it was unparented. It fires on the moved instance
    --- first, then on each of its descendants.
    read AncestryChanged: Signal<Instance, Instance?>
    --- Fires when any attribute of this instance changes. Passes the attribute's name.
    read AttributeChanged: Signal<string>
    --- Fires once when `Destroy` is called on this instance. Handlers run after the instance has
    --- already been removed from the tree.
    read Destroying: Signal<()>
    --- Returns the first child with the given name, or nil. Only direct children are searched; to
    --- search deeper, loop over `GetDescendants`.
    function FindFirstChild(self, name: string): Instance?
    --- Returns the first child whose `ClassName` is exactly `className`, or nil. Subclasses do not
    --- match: asking for `BasePart` never finds a `Part`.
    function FindFirstChildOfClass(self, className: string): Instance?
    --- Returns the first child that is of the class `className` or of a class derived from it, or nil.
    --- Abstract base classes such as `BasePart` are accepted.
    function FindFirstChildWhichIsA(self, className: string): Instance?
    --- Returns the nearest ancestor with the given name, or nil. The search starts at `Parent`; the
    --- instance itself is never returned.
    function FindFirstAncestor(self, name: string): Instance?
    --- Returns the nearest ancestor whose `ClassName` is exactly `className`, or nil. The search starts
    --- at `Parent`; the instance itself is never returned.
    function FindFirstAncestorOfClass(self, className: string): Instance?
    --- Returns the path to this instance: the names of its ancestors and its own name, joined by dots,
    --- such as `Workspace.Tree.Trunk`. The path starts below the data model. It is meant for logs;
    --- siblings can share a name, so a path does not always identify one instance.
    function GetFullName(self): string
    --- Returns a new array of this instance's children, in the order they were parented. The array is a
    --- copy, so it is safe to destroy children while looping over it.
    function GetChildren(self): {Instance}
    --- Returns a new array of every descendant, depth first: each child, followed by that child's own
    --- descendants.
    function GetDescendants(self): {Instance}
    --- Waits until a child with the given name exists, and returns it. Returns immediately if one
    --- already exists. With `timeout`, returns nil when the time runs out. Without one, it waits
    --- indefinitely and logs a warning after five seconds of game time.
    function WaitForChild(self, name: string, timeout: number?): Instance?
    --- Returns whether this instance is of the given class or of a class derived from it. A name that
    --- is not a class returns false instead of raising an error.
    function IsA(self, className: string): boolean
    --- Returns whether `descendant` is anywhere below this instance. An instance is not its own
    --- ancestor. Returns false if either instance has been destroyed.
    function IsAncestorOf(self, descendant: Instance): boolean
    --- Returns whether this instance is anywhere below `ancestor`. An instance is not its own
    --- descendant. Returns false if either instance has been destroyed.
    function IsDescendantOf(self, ancestor: Instance): boolean
    --- Returns the content path of the stamp this instance was placed from, such as
    --- `stamps/fighter.stamp.json`, or nil. Only a linked copy of a stamp returns a path; a copy placed
    --- unlinked returns nil. A copy's parameters are stored as its attributes.
    function GetStamp(self): string?
    --- Returns a copy of this instance and everything under it, with no parent. Properties, attributes
    --- and tags are copied at every depth. A reference to an instance inside the copied tree points to
    --- the copy; a reference to anything outside it still points to the original.
    function Clone(self): Instance
    --- Removes this instance and all of its descendants permanently. `Parent` is set to nil and locked,
    --- tags are cleared, and `Destroying` fires. The instance remains readable until the `Destroying`
    --- handlers have run. After that, `Parent` reads nil and `IsDescendantOf` and `IsAncestorOf` return
    --- false, but reading `Name` or `ClassName` or calling `IsA` raises an error.
    function Destroy(self): ()
    --- Returns the value of the named attribute, or nil if it has never been set. Attribute names are
    --- case-sensitive.
    function GetAttribute(self, name: string): (string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence)?
    --- Sets the named attribute, or removes it when `value` is nil. Raises an error for a table, an
    --- instance or a function, and for an empty name; the previous value is kept.
    function SetAttribute(self, name: string, value: (string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence)?): ()
    --- Returns a new table of this instance's attributes, keyed by name.
    function GetAttributes(self): { [string]: string | number | boolean | vector | CFrame | Color3 | Vector2 | UDim | UDim2 | Rect | ColorSequence | NumberSequence }
    --- Returns a signal that fires when the named attribute changes. The attribute does not have to
    --- exist yet.
    function GetAttributeChangedSignal(self, name: string): Signal<()>
    --- Returns a signal that fires when the named property changes. The signal passes no arguments;
    --- read the property for its new value. Each call returns the same signal. Raises an error if the
    --- class has no such property.
    function GetPropertyChangedSignal(self, name: string): Signal<()>
    --- Adds a tag to this instance. Does nothing if the instance already has it. Tags do not depend on
    --- the tree: an instance with no parent keeps its tags and is still found by them.
    function AddTag(self, tag: string): ()
    --- Removes a tag from this instance. Does nothing if the instance does not have it.
    function RemoveTag(self, tag: string): ()
    --- Returns whether this instance has the given tag.
    function HasTag(self, tag: string): boolean
    --- Returns a new array of this instance's tags.
    function GetTags(self): {string}
end

