declare extern type SaveService extends Instance with
    --- The version of the game's save format, an integer starting at 1. Set it before the first call to
    --- `GetSlotAsync`. A slot saved by an older version is passed to `OnMigrate` once and then saved at
    --- this version.
    Version: number
    --- Called to update a slot that was saved by an older `Version`. The callback edits the slot in
    --- place. It runs once, in its own thread, before `GetSlotAsync` returns the slot, and the slot is
    --- then saved at the current version. If it raises an error, the error is logged and the slot is
    --- left as it was read.
    OnMigrate: ((slot: SaveSlot, fromVersion: number) -> ())?
    --- Returns the slot called `name`, yielding until it has been read from disk. A name is 1 to 64
    --- letters, digits, `_` and `-`; any other name raises an error. A slot that does not exist yet is
    --- returned empty. If the slot's file is damaged, the backup left by the previous save is read
    --- instead and a warning is logged. If both are damaged, the slot is returned empty and its
    --- `Recovered` is false.
    function GetSlotAsync(self, name: string): SaveSlot
    --- Returns the names of the slots the game has saved, sorted.
    function ListSlots(self): { string }
    --- Deletes a slot and its backup. A `SaveSlot` object already obtained for it is emptied.
    function DeleteSlot(self, name: string): ()
end

declare extern type DataService extends Instance with
    --- The version of the format of the game's records, a whole number from 1. Set it before the first
    --- call to `LoadAsync`. A record written at an older version is passed to `OnMigrate` once and then
    --- written at this version.
    Version: number
    --- Called to update a record written at an older `Version`. The callback edits the record in place.
    --- It runs once, in its own thread, before `LoadAsync` returns the record, and the record is then
    --- written at the current version. If it raises an error, the error is logged and the record is
    --- left as it was read.
    OnMigrate: ((record: DataRecord, fromVersion: number) -> ())?
    --- Returns the player's record, empty for a player who has none yet, and holds it for this world
    --- until the player leaves or `Release` is called. Where another world holds it, waits for that
    --- world to write it and let it go, for up to ten seconds, and then raises an error that begins
    --- with `DataBusy`. Raises an error on a player's machine, and in a game that is not a server. A
    --- record already held by this world is returned at once.
    function LoadAsync(self, player: Player): DataRecord
    --- Moves items and money between owners: all of the moves, or none. A move is `Move`, an item's id,
    --- or `Pay`, a whole amount of `Currency`, from `From` to `To`. An owner is a `Player` or a name
    --- the game gives what no player owns, such as a guild's bank. For money, a nil owner is the game
    --- itself: what it pays comes from nowhere, and what is paid to it is gone. Returns true, or false
    --- and why: `ItemNotThere` where an item is not where a move says it is, `NotEnough` where a
    --- balance would fall below nought. It is on the disk before it returns, and each move is logged
    --- with the transaction and the world.
    function TransactAsync(self, moves: { { Move: number?, Pay: number?, Currency: string?, From: (Player | string)?, To: (Player | string)? } }): (boolean, string?)
    --- Makes an item of `kind` for `owner` and returns its id. Its `fields` are what a save slot can
    --- hold. No id is ever given twice, even after the item is destroyed.
    function CreateItemAsync(self, owner: Player | string, kind: string, fields: { [string]: any }?): number
    --- Destroys an item. Returns false where there is no item with that id.
    function DestroyItemAsync(self, id: number): boolean
    --- Returns the items `owner` has, oldest first.
    function GetItemsAsync(self, owner: Player | string): { { Id: number, Kind: string, Fields: { [string]: any } } }
    --- Returns how much of `currency` `owner` has: nought where they have never had any.
    function GetBalanceAsync(self, owner: Player | string, currency: string): number
    --- Returns a value no player owns, such as an auction's listings or a world event's progress, and
    --- its version. Nil and 0 for a value never written.
    function GetAsync(self, scope: string, key: string): (any, number)
    --- Writes a shared value, but only while its version is still `version`, the one `GetAsync`
    --- returned. Returns whether it was written, and the version it has now: a world that lost to
    --- another reads it again. The value is what a save slot can hold, of at most 256 KiB written; nil
    --- clears it.
    function SetAsync(self, scope: string, key: string, value: any, version: number): (boolean, number)
    --- Calls `transform` with a shared value as it is, and writes what it returns, unless another world
    --- wrote first. Then `transform` is called again with what that world wrote. Returns the value
    --- written. The function must not yield, and may run more than once. No lock is held while it runs.
    function UpdateAsync(self, scope: string, key: string, transform: (any) -> any): any
end

declare extern type LocalizationService extends Instance with
    --- The locale that text is returned in, such as `en` or `pt-BR`. Setting it records the player's
    --- choice: the choice is kept for the next run, and `LocaleChanged` fires. The initial value is the
    --- first of these that exists: the player's saved choice, the language of the store or launcher
    --- that started the game if a platform provider reports one, the system language, `[project]
    --- default_locale`, and `en`. Each is matched to a catalog the project has. A locale the project
    --- has no catalog for is matched to a catalog of the same language, so `pt` uses `pt-BR`. If there
    --- is none, setting it raises an error.
    Locale: string
    --- The language that voices are played in, which can differ from the language of the text. When a
    --- `Sound` is played, its `Content` is looked for under `l10n/<VoiceLocale>/`. Reading this
    --- property returns the language in effect, which is always one of `GetVoiceLocales`. Set to an
    --- empty string, the default, it follows the text language: `Locale` matched to a language this
    --- machine has voices for, or else the first system language it has voices for, or else the
    --- project's default. `VoiceFollowsLocale` reports whether it is following. Setting a language
    --- records the player's choice, which is kept for the next run. A language this machine cannot play
    --- is matched to one of the same language, so `pt` uses `pt-BR`; if there is none, setting it
    --- raises an error. A change takes effect at the next `Play`: a sound that is playing finishes in
    --- the language it started in.
    VoiceLocale: string
    --- Whether the voice language follows the text language. It is true until a language is set on
    --- `VoiceLocale`, and true again after `VoiceLocale` is set to an empty string. A settings menu can
    --- use it to show "same as text" as the current choice.
    read VoiceFollowsLocale: boolean
    --- Fires when `Locale` changes. During development, it also fires when a catalog file is edited and
    --- reloaded. Set the text of the game's labels in its handler.
    read LocaleChanged: Signal<string>
    --- Fires when the language that voices are played in changes, with the new `locale`. That happens
    --- when a script sets `VoiceLocale`, or when the text language changes and the voice language
    --- follows it.
    read VoiceLocaleChanged: Signal<string>
    --- Returns the locales the project has a catalog for, in order. Use it to fill a language menu.
    function GetLocales(self): { string }
    --- Returns the languages this machine can play voices in, with the project's default first and the
    --- others sorted. The others are the languages under `l10n/` that the game shipped with or that an
    --- installed language pack added. A menu built from the list never offers a voice language that is
    --- not installed.
    function GetVoiceLocales(self): { string }
    --- Returns the system's preferred languages, most preferred first, as the platform reports them,
    --- whether or not the game supports them. Use it to show "your system's language" in a menu.
    --- Returns an empty list on a dedicated server.
    function GetSystemLocales(self): { string }
    --- Returns the text for `key` in the current `Locale`. Each `{name}` in the text is replaced by
    --- `arguments.name`, which can be a string, a number or a boolean. If no catalog has the key, the
    --- key itself is returned and a warning is logged once.
    function Translate(self, key: string, arguments: { [string]: any }?): string
end

declare extern type GraphicsService extends Instance with
    --- The overall quality level. Setting it applies that level to every quality setting, like
    --- `ApplyPreset`. It reads `Custom` when any quality setting differs from the level's value.
    --- `Custom` cannot be set.
    QualityLevel: EnumGraphicsQuality
    --- The fraction of the window's resolution the world is drawn at, from one third to 1. The
    --- interface is always drawn at the window's full resolution.
    RenderScale: number
    --- The quality of the sun's shadows, as a level. Setting it sets `ShadowResolution` and
    --- `ShadowCascades` to that level's values. `Off` uses no cascades.
    ShadowQuality: EnumShadowQuality
    --- The side of one shadow cascade, in texels, from 256 to 2048. It is rounded down to a power of
    --- two.
    ShadowResolution: number
    --- The number of cascades in the sun's shadow, from 0 to 4. At 0 the sun casts no shadows.
    ShadowCascades: number
    --- The distance from the camera within which the sun casts shadows, in meters, from 10 to 1000.
    ShadowDistance: number
    --- The method used to smooth edges.
    AntiAliasing: EnumAntiAliasingMode
    --- The method used to scale the world up to the window's resolution when `RenderScale` is below 1.
    --- At a scale of 1, `FSR1` does nothing and `FSR2` acts only as anti-aliasing.
    Upscaling: EnumUpscalingMode
    --- How much the picture is sharpened, from 0 to 1. Sharpening is applied after an FSR 1 upscale,
    --- after temporal anti-aliasing, and as part of FSR 2.
    Sharpness: number
    --- Whether creases and corners are darkened, where little ambient light reaches.
    AmbientOcclusion: boolean
    --- Whether the sun's shadows reach right up to the object that casts them.
    ContactShadows: boolean
    --- Whether bright areas glow.
    Bloom: boolean
    --- Whether a world's `DepthOfFieldEffect` is drawn. When it is off, the picture is sharp even in a
    --- scene that has the effect.
    DepthOfField: boolean
    --- Whether a world's `SunRaysEffect` is drawn. When it is off, no shafts are drawn even in a scene
    --- that has the effect.
    SunRays: boolean
    --- Whether the brightness of the picture adapts to the scene. When it is off, the exposure is
    --- fixed.
    AutoExposure: boolean
    --- The largest number of lights drawn in one frame.
    LightBudget: number
    --- A multiplier on the distance at which distant terrain is drawn in finer detail, relative to the
    --- quality level's own value. At 2 the detail extends twice as far, and at 0.5 half as far.
    TerrainDetail: number
    --- The fraction of the foliage of every `FoliageLayer` that is drawn, from 0 to 1. It multiplies
    --- the project's own foliage density.
    FoliageDensity: number
    --- Whether decals are drawn on the foliage standing in them (see `FoliageLayer.ReceivesDecals`).
    --- When it is off, a decal appears on the ground under the foliage but not on the foliage, which is
    --- cheaper. It is off at the `Low` quality level, and below `High` on a handheld device.
    FoliageDecals: boolean
    --- A multiplier, from 0.25 to 8, on how often small skinned meshes are posed. At 1, a character is
    --- posed every tick while it is at least 12% of the picture's height, every second tick down to 6%,
    --- every fourth down to 3%, and every eighth below that. At 2 the thresholds are 6%, 3% and 1.5%,
    --- and at 4 they are halved again. Raise it for a game whose camera is far from a crowd, since a
    --- crowd posed every fourth tick moves in visible steps. Higher values cost more.
    AnimationDetail: number
    --- A multiplier on the distance at which objects are drawn, from 0.25 to 4. This setting is saved
    --- and reported but has no effect yet.
    ViewDistance: number
    --- How much of each texture is loaded. `High` loads the full size, `Medium` half the size (a
    --- quarter of the memory), and `Low` a quarter of the size (a sixteenth of the memory). The initial
    --- value depends on the machine's memory, whatever the quality level: `Low` below 3 GB, `Medium`
    --- below 5 GB and `High` above. A game or a player can set another value. It applies to compiled
    --- content: material maps, the images in model files, decals and particles. Sprites, tilesets,
    --- block faces and interface images are always drawn at their own size, and no texture is reduced
    --- below 64 pixels. A texture that is already loaded keeps its size until it is loaded again, so
    --- set this before loading the scene that should use it.
    TextureQuality: EnumTextureQuality
    --- How sharp textures stay when seen at a shallow angle, from 1 to 16. This setting is saved and
    --- reported but has no effect yet.
    AnisotropicFiltering: number
    --- A multiplier on the distance at which a mesh changes level of detail. This setting is saved and
    --- reported but has no effect yet.
    LODBias: number
    --- The finest level of detail a mesh can be drawn at; 0 is the mesh's finest. This setting is saved
    --- and reported but has no effect yet.
    MaximumLODLevel: number
    --- The largest number of particles alive at once. This setting is saved and reported but has no
    --- effect yet.
    ParticleBudget: number
    --- Whether particles fade where they meet a surface. This setting is saved and reported but has no
    --- effect yet.
    SoftParticles: boolean
    --- The number of bones that can move one vertex, from 1 to 4. This setting is saved and reported
    --- but has no effect yet.
    SkinWeights: number
    --- The memory that textures can keep loaded, in mebibytes; 0 is no limit. This setting is saved and
    --- reported but has no effect yet.
    TextureStreamingBudget: number
    --- The time a frame can spend uploading data to the GPU, in milliseconds. This setting is saved and
    --- reported but has no effect yet.
    AsyncUploadBudget: number
    --- Whether motion is blurred. This setting is saved and reported but has no effect yet.
    MotionBlur: boolean
    --- How fog is drawn. This setting is saved and reported but has no effect yet.
    FogQuality: EnumGraphicsLevel
    --- Whether bounced light is computed. At `High` and above, each `IrradianceVolume` is computed and
    --- used. Below `High`, a surface inside a volume is lit as it is outside one: by the ambient light,
    --- or by the light of a `ReflectionProbe`. On a phone, every quality level starts below `High`.
    GlobalIllumination: EnumGraphicsLevel
    --- The time per frame that computing bounced light can take during play, in milliseconds, from 0.25
    --- to 16. The default is 1.5 unless a quality level or the game sets another. The budget is spent
    --- on computing each `IrradianceVolume` and on updating `Dynamic` volumes when the lighting
    --- changes, starting with the volume nearest the camera. With a lower value, the light follows a
    --- moving sun more slowly. A volume is always shown lit by one consistent moment, never partly
    --- updated. Behind a loading screen, the whole frame is used regardless of this value.
    GlobalIlluminationBudget: number
    --- What shiny surfaces reflect. At `Low` they reflect the sky, and no `ReflectionProbe` is
    --- captured. `Medium` keeps eight probes at 64 texels per side, `High` keeps sixteen at 128, and
    --- `Ultra` keeps thirty-two. A phone keeps half as many, and none below `High`. When a scene has
    --- more probes than are kept, the ones farthest from the camera are not used, and surfaces there
    --- reflect the sky.
    Reflections: EnumGraphicsLevel
    --- Whether smooth surfaces reflect what is on screen. It shows a character standing on a polished
    --- floor, an object that moved after a `ReflectionProbe` was captured, or the far bank of a lake.
    --- `Low` and `Medium` are off. `High` traces each pixel's reflection ray for 24 steps, and `Ultra`
    --- for 48. Where the screen holds no answer, the surface falls back to what `Reflections` provides.
    --- Only the `Ultra` quality preset turns this setting on, and on a phone it starts off at every
    --- level.
    ScreenSpaceReflections: EnumGraphicsLevel
    --- Whether light bounces off what is on screen. It adds fine detail that an `IrradianceVolume` is
    --- too coarse for, such as the red of a wall on the floor beside it. `Low` and `Medium` are off.
    --- `High` casts four rays per pixel at half resolution, and `Ultra` eight, accumulated over a few
    --- frames. The result replaces the matching share of the volume's light or the ambient light, so no
    --- light is counted twice. Only the `Ultra` quality preset turns this setting on, and on a phone it
    --- starts off at every level.
    ScreenSpaceBounce: EnumGraphicsLevel
    --- The largest number of pixels along the shorter side that the world is drawn at; 0 means no
    --- limit. The quality levels of a handheld device set it, because a phone's display has more pixels
    --- than are worth drawing.
    RenderResolutionCap: number
    --- Whether the game is windowed, borderless or fullscreen. A handheld device always uses the whole
    --- display.
    WindowMode: EnumWindowMode
    --- The size of the window in pixels when windowed, or the display mode when fullscreen. Zero means
    --- the project's window size when windowed, and the display's native mode when fullscreen.
    Resolution: Vector2
    --- The display the window is on, as an index into the list that `GetMonitors` returns.
    Monitor: number
    --- Whether each frame waits for the display's refresh. On by default, and always on for a handheld
    --- device.
    VSync: boolean
    --- The highest frame rate, in frames per second; 0 means no limit. With `VSync` off it is the only
    --- limit. With `VSync` on, it can only limit the rate below the display's refresh rate.
    MaxFrameRate: number
    --- The highest frame rate while the window is in the background or minimized, in frames per second;
    --- 0 means no limit.
    BackgroundFrameRate: number
    --- Whether an extra frame is generated between every two drawn frames, using AMD FSR 3 frame
    --- generation. Twice as many frames are shown for the same rendering cost. Each drawn frame is
    --- shown half a frame later, which adds input latency; leave it off for a game where reaction time
    --- matters. The interface is drawn on every frame shown and is never interpolated. It applies to
    --- the main view of a perspective camera, on a device with compute shaders, and not on Metal;
    --- elsewhere frames are shown as drawn. While it is on, frames wait for the display's refresh
    --- whatever `VSync` is set to. No quality level changes this setting.
    FrameGeneration: boolean
    --- An offset on the gamma of the picture, from -1 to 1. This setting is saved and reported but has
    --- no effect yet.
    Brightness: number
    --- Fires when the quality level or any quality setting changes, whatever changed it. It fires at
    --- most once per frame.
    read QualityChanged: Signal<()>
    --- Sets every quality setting to the value that `level` gives it, replacing whatever a script, the
    --- player or the project set. `Auto` selects the level that was measured for this machine. `Custom`
    --- raises an error. The display settings, such as the window, `VSync` and the frame rate limits,
    --- are not part of a level and are not changed.
    function ApplyPreset(self, level: EnumGraphicsQuality): ()
    --- Discards the values a script set and the values the player saved, so that the project's defaults
    --- apply. The player's saved file is not changed until `SaveAsync` is called.
    function ResetToDefaults(self): ()
    --- Returns where the value of a setting comes from. `setting` is the name of a property, such as
    --- `"VSync"`. Raises an error for a name that is not a setting.
    function GetSource(self, setting: string): EnumSettingSource
    --- Returns whether a setting has an effect yet. A few settings are saved and reported before the
    --- renderer uses them; use this method to hide or disable them in a menu.
    function IsApplied(self, setting: string): boolean
    --- Returns the level of a group of settings: the level whose values every setting in the group has.
    --- Returns nil if the settings do not all match one level.
    function GetGroupLevel(self, group: EnumGraphicsGroup): EnumGraphicsLevel?
    --- Sets every setting in `group` to the value that `level` gives it.
    function SetGroupLevel(self, group: EnumGraphicsGroup, level: EnumGraphicsLevel): ()
    --- Returns the fullscreen resolutions that the window's display supports, largest first. Returns an
    --- empty list where there is no display.
    function GetSupportedResolutions(self): { Vector2 }
    --- Returns the displays, in the order that `Monitor` indexes them.
    function GetMonitors(self): { { Name: string, Size: Vector2, RefreshRate: number } }
    --- Returns the refresh rate of the display the window is on, in hertz, or 0 if it is unknown.
    function GetRefreshRate(self): number
    --- Saves the player's settings to `settings.json` in the player's own folder: the previously saved
    --- values, updated with what a script has set since. Yields until the file is written, at the end
    --- of the frame, and returns whether it was. After that, `GetSource` returns `Player` for those
    --- settings. Returns false where there is nowhere to write: in a game that turned `[display]
    --- remember_player_settings` off, or in a run that has no folder of its own.
    function SaveAsync(self): boolean
    --- Reloads the player's saved settings and discards what a script has set since. Use it for a
    --- menu's Revert button. Yields until it is done, at the end of the frame, and returns whether
    --- there was a file to read.
    function LoadAsync(self): boolean
end

declare extern type XRService extends Instance with
    --- Whether a headset is drawing this game. False on the screen, on a server and in a headless run
