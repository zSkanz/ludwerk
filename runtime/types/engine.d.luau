declare extern type ConsoleService extends Instance with
    --- Adds the command `name` to the console. `name` is one lowercase word, and none of the engine's
    --- own. Registering a name again replaces it, as a hot reload does. `spec.Parameters` lists what
    --- the command takes, in order: each has a `Name` and a `Type` (`"string"`, `"number"`, `"boolean"`
    --- or `"Player"`), and the `Optional` ones come last. A word left over at the end goes to the last
    --- `string` parameter, so `announce Doors open at noon` gives the whole sentence. A `Player` is
    --- written as their name, their `UserId` or the start of their `PublicKey`. A line that does not
    --- fit is answered with the command's usage, and `callback` is not called. `spec.Permission`, 0 to
    --- 3, is who may run it: 2 when absent. The local console is 3. `spec.Description` is shown by
    --- `help`; it may be a key of the game's own catalog. `callback` runs on a thread of its own, on
    --- the server, between ticks. Its first argument is who ran it, then the parameters, `nil` for an
    --- optional one left out. What it returns is shown to whoever ran it; an error it raises is shown
    --- the same way and does not stop the server. It may yield, and the console takes the next line
    --- meanwhile.
    function Register(self, name: string, spec: { Description: string?, Parameters: { { Name: string, Type: string, Optional: boolean? } }?, Permission: number? }, callback: (caller: { Local: boolean, Name: string, Key: string, Permission: number }, ...any) -> any): ()
    --- Takes the command `name` out of the console. Nothing happens if there is none.
    function Unregister(self, name: string): ()
    --- Runs `line` as the server's own console would, with every permission, and returns what the
    --- command answered. Raises when the command failed. Yields until the command has finished: a line
    --- runs between ticks.
    function ExecuteAsync(self, line: string): string
end

declare extern type CryptoService extends Instance with
    --- Returns a buffer of `count` bytes from the operating system's random generator, for a key, a
    --- salt or a token. `count` is an integer from 0 to 1048576.
    function RandomBytes(self, count: number): buffer
    --- Returns an unpredictable integer from `min` to `max`, both included, with every value equally
    --- likely. Use it for a room code, or for the seed of a `Random` that must differ on each run. Both
    --- arguments must be integers, with `min` no greater than `max`.
    function RandomInteger(self, min: number, max: number): number
    --- Returns a new identifier that no other call returns, on this or any machine: a version 4 UUID in
    --- lowercase, of the form `xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx`. It has 122 random bits, so it can
    --- also be used as a session token.
    function UniqueId(self): string
    --- Returns the SHA-256 hash of the bytes of `data`, as 64 lowercase hexadecimal characters. The
    --- same bytes give the same result everywhere. Do not use it for passwords: it is fast, so hashed
    --- passwords can be guessed quickly. Use `HashPasswordAsync` for those.
    function Sha256(self, data: string | buffer): string
    --- Returns the HMAC-SHA-256 of `data` with `key`, as 64 lowercase hexadecimal characters. It is a
    --- signature that only a holder of the key can create or check. Use it to sign a token on a server,
    --- or to sign a request to a web service. Compare signatures with `SecureEquals`.
    function HmacSha256(self, key: string | buffer, data: string | buffer): string
    --- Returns whether `a` and `b` contain the same bytes, in a time that does not depend on where they
    --- differ. Use it to compare a token or a signature received from outside. Comparing with `==`
    --- stops at the first difference, and the time it takes reveals how much of a guess was right.
    function SecureEquals(self, a: string | buffer, b: string | buffer): boolean
    --- Returns a hash of `password` to store instead of the password. It yields while the hash is
    --- computed on another thread, so a server's tick does not wait for it. The hash is Argon2id with a
    --- random salt, and is deliberately slow (tens of milliseconds and 64 MiB of memory), so that a
    --- stolen table of hashes cannot be guessed quickly. Hashing the same password twice gives two
    --- different strings. Check a password with `VerifyPasswordAsync`, never with `==`. The result is a
    --- string of fewer than 128 characters that contains its own salt and cost settings, such as
    --- `$argon2id$v=19$m=65536,t=2,p=1$...`; store all of it. A password can be at most 1024 bytes.
    --- Requests are processed one at a time, in order.
    function HashPasswordAsync(self, password: string): string
    --- Returns whether `password` is the password that `hash` was made from by `HashPasswordAsync`. It
    --- yields while the check runs. Returns false if `hash` is not a hash that `HashPasswordAsync`
    --- produced.
    function VerifyPasswordAsync(self, password: string, hash: string): boolean
end

declare extern type ContentProvider extends Instance with
    --- The number of assets requested with `PreloadAsync` that have not finished loading.
    read RequestQueueSize: number
    --- Loads every item in a list and yields until each has loaded or failed. An item is a content
    --- path, such as `asset://models/tree.gltf`, or an instance, which stands for every asset that it
    --- and its descendants use. `callback` runs once for each item as it finishes, with
    --- `Enum.AssetFetchStatus.Success` or `Failure`. Meshes and images are uploaded to the GPU. A
    --- `.surface.hlsl` path compiles the surface shader's pipelines, so they are not created during
    --- play when the shader first appears. A sound is opened and its length is read. A name with no
    --- `://` is a stamp, named as for `Instance.stamp`: its file is read and kept, and every asset it
    --- uses is loaded with it. Preloaded assets are held for the scene in which they were requested and
    --- for the next scene, which is what a loading screen needs. After that they are unloaded like
    --- anything else a previous scene used, unless a scene still shows them. To hold assets for the
    --- whole game, use `Keep`.
    function PreloadAsync(self, items: { string | Instance }, callback: ((item: string | Instance, status: EnumAssetFetchStatus) -> ())?): ()
    --- Holds every item in a list, named as for `PreloadAsync`, until `Release` is called. Leaving a
    --- scene unloads the meshes and images that only that scene showed, but never a kept one. Use it
    --- for what the game shows repeatedly across scenes, such as the player's character or common
    --- enemies. It requests the items and returns without waiting; call `PreloadAsync` with the same
    --- list to wait for them. Kept assets stay in GPU memory, so keep only what is needed.
    function Keep(self, items: { string | Instance }): ()
    --- Stops holding every item that was passed to `Keep`. Nothing is unloaded at once: an asset that
    --- no scene shows is unloaded the next time the game leaves a scene.
    function Release(self, items: { string | Instance }): ()
end

declare extern type SceneService extends Instance with
