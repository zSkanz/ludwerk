declare extern type StreamingService extends Instance with
    --- Whether the world streams. Turning it off freezes the current state: nothing new is loaded and
    --- nothing loaded is unloaded. Use it to hold the world still during an operation.
    Enabled: boolean
    --- The distance from a focus within which the engine tries to keep cells loaded, in meters. A cell
    --- inside it is loaded when time allows. A loaded cell is unloaded only beyond a somewhat larger
    --- distance, so a focus at a boundary does not load and unload the same cell repeatedly.
    LoadRadius: number
    --- The distance from a focus within which cells must be loaded, in meters. Everything inside it is
    --- loaded before a focus moves into it, so a character never walks into an area that has not
    --- loaded. See `PauseOutsideLoadedArea` for what happens when the area is not ready.
    MinRadius: number
    --- Whether the simulation waits while the area within `MinRadius` is not loaded. With it off, a
    --- character can fall through ground that has not loaded. While waiting, ticks do not advance;
    --- nothing is rolled back. It has no effect on a client, which cannot pause a simulation it does
    --- not control. A client holds its camera and shows that it is loading instead.
    PauseOutsideLoadedArea: boolean
    --- The distance within which cells of structures must be loaded, in meters. It lets large
    --- structures use a larger radius than small detail. At 0, the default, `MinRadius` is used.
    StructureMinRadius: number
    --- The distance from a focus within which cells of structures are kept loaded, in meters. It works
    --- like `LoadRadius`. At 0, `LoadRadius` is used.
    StructureLoadRadius: number
    --- The distance within which cells of terrain features must be loaded, in meters. It is usually the
    --- largest of the three, so the horizon reaches farther than the objects on it. At 0, `MinRadius`
    --- is used. It also applies to a saved `Terrain` and a block world that are streamed in cells. When
    --- a world first loads, the simulation waits until the ground within this radius has loaded, so
    --- nothing falls through it.
    TerrainMinRadius: number
    --- The distance from a focus within which cells of terrain features are kept loaded, in meters. At
    --- 0, `LoadRadius` is used. A saved `Terrain` and a block world that are streamed in cells are also
    --- kept to this radius. A terrain cell holds a few large objects, so raising this radius costs much
    --- less than raising the radius for detail.
    TerrainLoadRadius: number
    --- Fires when an area requested by a script has finished loading.
    read AreaLoaded: Signal<vector, number>
    --- Fires for each instance that is streamed out while a script still holds a reference to it. Such
    --- an instance is not destroyed: its parent becomes nil, so the reference stays valid and the
    --- instance can still be read. An instance that no script refers to is destroyed, and this event
    --- does not fire for it.
    read InstanceStreamedOut: Signal<Instance>
    --- Adds an instance as a focus, so that the world also streams around it. A focus is usually the
    --- character or the camera. There can be several, and a cell is kept loaded if any focus needs it.
    --- Raises an error for an instance that has no position in the world.
    function AddFocus(self, instance: Instance): ()
    --- Removes an instance as a focus. Removing the last focus does not unload the world: what is
    --- loaded stays loaded.
    function RemoveFocus(self, instance: Instance): ()
    --- Yields until everything within `radius` of `position` is loaded, both the cells of parts and the
    --- terrain. Call it before teleporting a character, so that the destination exists on arrival. Also
    --- call it at startup before `Terrain:HeightAt`, which returns nil for terrain that has not loaded.
    --- It returns immediately if the area is already loaded. Raises an error if the world has no cells
    --- there.
    function LoadAreaAsync(self, position: vector, radius: number): ()
end

declare extern type TagService extends Instance with
