declare extern type DebugService extends Instance with
    --- Whether the debug overlay is drawn. It is off by default, including in exported games.
    OverlayVisible: boolean
    --- Fires for every console message. Passes the text and its level. Each `print` fires it once with
    --- its text at `Info`, and each `warn` once at `Warning`. Engine messages start with their key in
    --- square brackets, as in `[scene.err.parent_cycle] ...`, so a handler can match a key to find
    --- engine messages. Errors raised in signal handlers are also reported here.
    read MessageOut: Signal<string, EnumLogLevel>
    --- Draws a line between two positions in world space for one frame. Does nothing in a headless run.
    function DrawLine(self, a: vector, b: vector, color: Color3?): ()
    --- Draws the wireframe of a box at a `CFrame`, with a size in meters, for one frame. Does nothing
    --- in a headless run.
    function DrawBox(self, cframe: CFrame, size: vector, color: Color3?): ()
    --- Draws the wireframe of a sphere at a position in world space, with a radius in meters, for one
    --- frame. Does nothing in a headless run.
    function DrawSphere(self, position: vector, radius: number, color: Color3?): ()
    --- Requests a capture of the main thread's CPU scopes, starting and ending at frame boundaries,
    --- with durations in seconds of real time. The measurement must be longer than 0 and at most 120
    --- seconds, and the warm-up from 0 to 120 seconds. Returns false while another capture is pending,
    --- or for a duration that is out of range or not finite. It is a diagnostic tool; do not use its
    --- results in the simulation.
    function CaptureProfile(self, seconds: number, warmupSeconds: number?): boolean
    --- Returns the report of the capture requested with `CaptureProfile`, or nil until the capture
    --- completes. The report is a table with `frames`, `seconds`, `ticksPerFrame` and `scopes`. Each
    --- scope has `name`, `depth`, `meanMs`, `bestMs`, `medianMs`, `p95Ms`, `p99Ms`, `worstMs`,
    --- `selfMedianMs`, `calls` and `perCallMs`. The times are a frame's: what the scope spent in one
    --- frame, over the frames captured. `calls` is how many times it ran in a frame, at the median, and
    --- `perCallMs` is one run of it. `ticksPerFrame` is how many simulation ticks a frame ran, at the
    --- median: 1 for a world keeping up. A server catching up runs several in a frame, and a tick's
    --- scopes then show several ticks' time in each frame; read `perCallMs` for one tick. A scope's
    --- times include its child scopes and any waiting, and they are CPU times, not GPU times. At most
    --- the latest 16,384 frames are kept. The report stays available until the next capture is
    --- requested.
    function GetProfileReport(self): any
    --- Returns the value of a named statistic. The built-in statistics include `FPS`, `FrameTimeMs`,
    --- `PhysicsBodies`, `InstanceCount`, `DrawCalls`, `MeshLodDraws` and `LuaMemoryKB`, and
    --- `SetCustomStat` defines more. Raises an error for a name that is not a statistic.
    function GetStat(self, name: string): number
    --- Defines or updates a statistic of the game's own under a name. It can then be read with
    --- `GetStat` and is shown in the Stats panel. Raises an error if the value is not a number.
    function SetCustomStat(self, name: string, value: number): ()
    --- Opens one panel of the debug overlay by name. The built-in panels are `Stats`, `Scene`, `Log`,
    --- `Streaming`, `Physics` and `Terrain`. The `Terrain` panel shows the terrain's triangles and
    --- normals around the camera, in red where a triangle faces the wrong way. Raises an error for an
    --- unknown panel name.
    function ShowPanel(self, name: string): ()
    --- Closes one panel of the debug overlay by name, with the same names as `ShowPanel`. Raises an
    --- error for an unknown panel name.
    function HidePanel(self, name: string): ()
end

declare extern type HotReloadService extends Instance with
    --- Fires in the old world when a reload has been requested, before anything is removed. It is the
    --- last moment at which `SaveState` can be called. The reload waits for its handlers to finish.
    read PreReload: Signal<()>
    --- Fires in the world a reload has built, after every entry script has run for the first time and
    --- the preserved state is in place.
    read PostReload: Signal<()>
    --- Stores a value under `key` so that the world built by the next reload can read it. The value is
    --- copied when the method is called. It can be nil, a boolean, a number, a string, a buffer, or a
    --- table of those. Raises an error for a function, a thread, an instance or a table that contains
    --- itself.
    function SaveState(self, key: string, value: any): ()
    --- Returns the value that `SaveState` stored under `key` before the reload, or nil if there is
    --- none. The result is a new copy: changing it does not change what is stored.
    function LoadState(self, key: string): any
    --- Returns whether this world was built by a hot reload instead of by starting the engine. Use it
    --- to reuse what the previous world left instead of building it again. Instances tagged
    --- `PreserveOnReload` are already in the tree when the first entry script runs.
    function IsReload(self): boolean
end

declare extern type PhysicsService extends Instance with
    --- The length of one simulation tick, in seconds. The default is 1/60. Every timer counts in ticks:
    --- `task.wait(1)` is exactly 60 ticks at the default, on every machine and in every run. Code that
    --- expresses durations as multiples of this value works at any tick rate. A new value takes effect
    --- at the start of the next frame. Setting a value outside 1/240 to 1/30 raises an error.
    FixedTimestep: number
    --- Registers a collision group. A new group collides with every group until
    --- `CollisionGroupSetCollidable` says otherwise. Registering a name that already exists does
    --- nothing, so a script can register its groups every time it starts.
    function RegisterCollisionGroup(self, name: string): ()
    --- Sets whether parts in two groups collide with each other. The setting is symmetric: setting it
    --- for a and b also sets it for b and a.
    function CollisionGroupSetCollidable(self, a: string, b: string, collidable: boolean): ()
    --- Returns the names of every registered group as a new array, in the order they were registered,
    --- with `Default` first.
    function GetRegisteredCollisionGroups(self): {string}
end

declare extern type InputService extends Instance with
    --- Whether the pointer is locked to the window and reports movement instead of position, as a
    --- first-person camera needs. While it is locked, `GetPointerPosition` returns the position the
    --- pointer had when it was locked. To read the movement, bind a `Direction2D` action to
    --- `MouseMovement`. While the pointer is locked, the interface ignores it: nothing is hovered or
    --- pressed, and no `Active` object receives it. The keyboard and a gamepad can still select UI
    --- objects. To let the player click the interface, unlock the pointer first, as a menu does.
    PointerLocked: boolean
    --- Whether the system cursor is drawn. It is independent of `PointerLocked`: a strategy game can
    --- hide the cursor during a cutscene without locking it.
    PointerVisible: boolean
    --- The kind of input the player is using: `KeyboardMouse`, `Gamepad` or `Touch`. It has the same
    --- value as `LastInputDeviceType`, and `InputDeviceChanged` fires when it changes. For the family
    --- of the gamepad, use `PreferredGamepadType`.
    read PreferredInput: EnumInputDeviceType
    --- The family of the gamepad the player last used. Connecting a gamepad does not select it; the
    --- player must use it. The value is kept when the player switches to keyboard or touch, and becomes
    --- `Unknown` when that gamepad disconnects. Use it to choose button icons.
    read PreferredGamepadType: EnumGamepadType
    --- The connection id of the gamepad the player last used, or 0 if none is selected. A gamepad that
    --- reconnects gets a new id. The value is kept when the player switches to keyboard or touch. It is
    --- not a player index.
    read PreferredGamepadId: number
    --- The kind of device the player most recently used. Use it to switch a HUD's button prompts. It
    --- changes only on deliberate input: a gamepad stick resting inside its dead zone does not change
    --- it.
    read LastInputDeviceType: EnumInputDeviceType
    --- How far a finger must travel before the movement counts as a swipe, in millimeters on the
    --- screen. The default is 6. The engine converts it to pixels from the display's pixel density, so
    --- it is the same physical distance on a phone and on a monitor.
    SwipeThreshold: number
    --- Whether this machine has a touchscreen. It is known from startup, before any touch, so a game
    --- can choose which HUD to build before its first frame. It is true on a phone and on a laptop with
    --- a touchscreen.
    read TouchAvailable: boolean
    --- Whether a keyboard is attached. On a phone it is false until a keyboard is connected or paired.
    read KeyboardAvailable: boolean
    --- Whether at least one gamepad is connected. It changes as gamepads are connected and
    --- disconnected. `InputDeviceChanged` fires when one is first used.
    read GamepadAvailable: boolean
    --- Fires on the tick an input starts: a key or button is pressed, or a trigger passes half of its
    --- range. The second argument, `uiConsumed`, is true when the interface already used the input,
    --- because the pointer was over a UI object or a `TextInput` had focus. Check it, or the game
    --- reacts to clicks on buttons and to text typed into a chat box. A key handled through this event
    --- cannot be rebound by the player and does not appear in a settings menu. For gameplay input, an
    --- `InputAction` is usually the better choice; this event suits prototypes, debug keys and input
    --- that players never remap. It fires on simulation ticks, so a handler that changes the world is
    --- reproduced exactly in a replay. For camera look at the frame rate, use an `InputContext` with
    --- `Rate` set to `Enum.InputRate.Render`.
    read InputBegan: Signal<InputObject, boolean>
    --- Fires on a tick in which an input changed without starting or ending: the pointer moved, the
    --- wheel turned, or a stick or trigger changed position. `Position` and `Delta` hold the change. It
    --- fires at most once per tick for each source, with the deltas accumulated since the previous
    --- event, so fast movement is not lost. As with `InputBegan`, input handled here cannot be rebound
    --- by the player.
    read InputChanged: Signal<InputObject, boolean>
    --- Fires on the tick an input stops. It fires for every held input when the window loses focus, so
    --- a handler that pairs it with `InputBegan` never leaves an input stuck. `uiConsumed` has the
    --- value it had when the input began, so a press that started on a button is still marked as
    --- consumed when it is released elsewhere.
    read InputEnded: Signal<InputObject, boolean>
    --- Fires when a finger, or the mouse with its left button held, travels `SwipeThreshold` along one
    --- axis. It fires while the finger is still down, with the position where the stroke began, in
    --- window pixels, and the number of fingers down. One long drag in one direction is one swipe. A
    --- change of direction starts the next, measured from the finger's position at that moment. The
    --- same swipe also drives `Enum.KeyCode.SwipeUp` and its three siblings for an `InputAction`. A
    --- press that the interface consumed (see `UIObject.Active`) starts no touch gesture.
    read TouchSwiped: Signal<EnumSwipeDirection, Vector2, number>
    --- Fires when a finger touches and lifts at the same place within a third of a second. Passes the
    --- position, in window pixels. A mouse click on the world also fires it.
    read TouchTapped: Signal<Vector2>
    --- Fires once when a finger has stayed where it touched for half a second, while it is still down.
    --- Lifting the finger afterward does not count as a tap.
    read TouchLongPressed: Signal<Vector2>
    --- Fires on each tick in which two fingers move apart or together. Passes the distance between them
    --- relative to the distance when the second finger touched, so 2 means twice as far apart, and the
    --- point midway between them. To zoom, multiply the zoom the game had before the pinch by this
    --- ratio.
    read TouchPinched: Signal<number, Vector2>
    --- Fires when the fingers that are down move. Passes how far they moved in this tick, in window
    --- pixels, as a single motion however many fingers there are; +Y is down the window, as for
    --- `Position`. Use it for a camera that is dragged with one finger or two.
    read TouchPanned: Signal<Vector2, number>
    --- Fires when `PreferredGamepadType` changes. It is independent of `InputDeviceChanged`.
    read PreferredGamepadTypeChanged: Signal<EnumGamepadType>
    --- Fires when `PreferredGamepadId` changes, including when the player switches between two gamepads
    --- of the same family.
    read PreferredGamepadIdChanged: Signal<number>
    --- Fires when a gamepad connects. Connecting does not change `PreferredInput` or the preferred
    --- gamepad.
    read GamepadConnected: Signal<number, EnumGamepadType>
    --- Fires when a gamepad disconnects. Passes the id it had and its family. Other connected gamepads
    --- are not affected.
    read GamepadDisconnected: Signal<number, EnumGamepadType>
    --- Fires when `LastInputDeviceType` changes. Use it to redraw button prompts.
    read InputDeviceChanged: Signal<EnumInputDeviceType>
    --- Fires when the game window gains or loses keyboard focus. Losing focus releases every held
    --- input.
    read WindowFocusChanged: Signal<boolean>
    --- Returns the ids of the connected gamepads, in ascending order. `GamepadConnected` and
    --- `GamepadDisconnected` fire when the list changes. Connecting a gamepad does not change
    --- `PreferredInput` or assign the gamepad to a local player.
    function GetGamepads(self): {number}
    --- Returns whether a key of one gamepad, given by its id, is held. It reads the device directly,
    --- whether or not the interface consumed the input. Returns false for a gamepad that is not
    --- connected and for a key that is not a gamepad key. An analog input counts as held beyond half of
    --- its range.
    function IsGamepadKeyDown(self, gamepadId: number, keyCode: EnumKeyCode): boolean
    --- Returns the position of the pointer in window pixels, measured from the top left, for the
    --- current tick. The value does not change within a tick.
    function GetPointerPosition(self): Vector2
    --- Returns whether a key, button or trigger is held, for the current tick. An analog input counts
    --- as held beyond half of its range. It reads the device directly and ignores whether the interface
    --- consumed the input. For input that respects the interface and can be rebound, use an
    --- `InputAction`.
    function IsKeyDown(self, keyCode: EnumKeyCode): boolean
    --- Sets the value of one of the `Virtual` key codes from something that is not hardware. Use it for
    --- an on-screen button, an on-screen thumbstick or an accessibility control. The value is treated
    --- like input from a device. It drives actions through an ordinary `InputBinding`, obeys context
    --- priority and `Sink`, and is recorded in a replay. The value is a number, not a press. Use 1 and
    --- 0 for a button, and values in between for a slider or a thumbstick axis. A `Bool` action bound
    --- to it counts as pressed beyond 0.5. The value stays until it is set again; it is cleared when
    --- the window loses focus. Raises an error for a key code that is not one of the `Virtual` codes.
    function SetVirtualState(self, keyCode: EnumKeyCode, value: number): ()
    --- Copies text to the player's clipboard, such as a room code, a seed or a link. The clipboard
    --- cannot be read: there is no method that returns its contents. The text goes to the clipboard of
    --- the machine that runs the script, so call it from a client script. It does nothing on a server
    --- or in a headless run. The limit is 64 KiB; longer text is cut at a character boundary. If it is
    --- called several times in one frame, the last call is kept.
    function SetClipboard(self, text: string): ()
end

declare extern type TweenService extends Instance with
    --- Returns a tween that moves each named property of `instance` to its goal value. The tween is
    --- created stopped; call `Play` to start it. Every goal is checked when the tween is created.
    --- Raises an error for a property the class does not have, a read-only property or a value of the
    --- wrong type. Only properties that can be interpolated are accepted: numbers, vectors, `CFrame`,
    --- `Color3`, `Vector2`, `UDim`, `UDim2` and `Rect`. A boolean or string goal raises an error.
    function Create(self, instance: Instance, tweenInfo: TweenInfo, goals: { [string]: any }): Tween
    --- Returns `alpha` eased by an easing style and direction, with the same calculation a tween uses.
    --- Use it to ease a value that is not a property. `alpha` is not clamped, and some styles, such as
    --- `Back` and `Elastic`, return values outside 0 to 1.
    function GetValue(self, alpha: number, easingStyle: EnumEasingStyle, easingDirection: EnumEasingDirection): number
end

declare extern type UIService extends Instance with
    --- The distance from each edge of the window within which drawing is not safe, in pixels, because
    --- of a camera cutout, rounded corners or a system gesture bar. It is zero for a desktop window.
    read SafeAreaInsets: Rect
    --- The size of the area the interface is drawn into, in pixels: the window in a game, or the
    --- Viewport panel in the editor. `AbsolutePosition` and the pointer position are measured in it,
    --- and a `ScreenGui` with `ReferenceHeight` is scaled to it.
    read ViewportSize: Vector2
    --- The ratio of the window's pixels to its logical size: 2 on a display at 200% scaling. UI
    --- coordinates are in pixels, so multiply by this value to give something the same physical size on
    --- different screens.
    read DisplayScale: number
    --- The orientations in which the game can be held on a phone or tablet. Setting it takes effect
    --- immediately and rotates the screen if needed. The value saved with the scene is the one the game
    --- starts with. A layout sees the new `AbsoluteSize` on the next frame. It has no effect on a
    --- desktop.
    ScreenOrientation: EnumScreenOrientation
    --- The UI object selected by a gamepad or the arrow keys, or nil. The D-pad, the left stick and the
    --- arrow keys move the selection: to the object's `NextSelectionUp`, `Down`, `Left` or `Right` if
    --- set, and otherwise to the nearest selectable object in that direction. `ButtonA` or Enter fires
    --- the selected object's `Activated`. Set it to move the selection, for example to the first button
    --- when a menu opens. Raises an error for an object that is not `Selectable`.
    SelectedObject: UIObject?
    --- The id of the gamepad that can navigate the interface and activate `SelectedObject`. At 0, every
    --- gamepad can. With a positive id, only that gamepad navigates menus; the others still reach
    --- `InputService` and their `InputContext`s. Keyboard and pointer navigation are not affected.
    --- Changing the id releases any held navigation input.
    GamepadId: number
    --- Whether the engine manages the selection when the game does not. When it is on and nothing is
    --- selected, the first press of a D-pad, a stick or an arrow key selects the first selectable
    --- object on the topmost screen, and a pointer press clears the selection, so a player who uses the
    --- mouse sees no selection outline. When it is off, the selection changes only when a script sets
    --- it.
    AutoSelect: boolean
    --- Fires when a `TextInput` gains keyboard focus.
    read TextInputFocused: Signal<TextInput>
    --- Fires when a `TextInput` loses keyboard focus.
    read TextInputFocusReleased: Signal<TextInput>
    --- Fires when `SelectedObject` changes. Passes the newly selected object, or nil.
    read SelectionChanged: Signal<UIObject?>
    --- Returns the `TextInput` that has keyboard focus, or nil. A chat hotkey can check it before
    --- opening the chat box.
    function GetFocusedTextInput(self): TextInput?
end

declare extern type AudioService extends Instance with
    --- A multiplier on every sound, applied after the sound's own volume and its group's. It belongs to
    --- the game: use it for a fade or a cutscene. It is not saved. For the player's volume setting, use
    --- `PlayerVolume`.
    MasterVolume: number
    --- The player's master volume, from 0 to 1, applied to every sound on this machine. It is a player
    --- setting, like the graphics settings: a value a script sets is kept for the next run, it is not
    --- saved with a scene, and it is not replicated. Setting it on a dedicated server raises an error.
    PlayerVolume: number
    --- The player's volume for every `Sound` whose `Category` is `Music`, from 0 to 1. It is a player
    --- setting, kept like `PlayerVolume`.
    MusicVolume: number
    --- The player's volume for every `Sound` whose `Category` is `Effects`, from 0 to 1. It is a player
    --- setting, kept like `PlayerVolume`.
    EffectsVolume: number
    --- The player's volume for every `Sound` whose `Category` is `Voice`, from 0 to 1. It is a player
    --- setting, kept like `PlayerVolume`.
    VoiceVolume: number
    --- The factor music is multiplied by while a voice plays, from 0 to 1. At 1, music is not lowered.
    --- While any `Voice` sound is audible on a machine, every `Music` sound there fades down to this
    --- factor over 0.15 seconds, and back up over 0.6 seconds when the voice stops. A voice is audible
    --- when it is playing, in range and not muted by the player. The value belongs to the game, like
    --- `MasterVolume`. The fade happens in each machine's mixer, and scripts cannot read it.
    MusicUnderVoice: number
    --- Creates a `Sound` that is not positional, parents it to this service, plays it and returns it.
    --- Use it for a one-shot sound such as a click or a pickup. The sound is destroyed shortly after it
    --- ends, after handlers of its `Ended` event have run. Use the returned sound to set its volume or
    --- category. A sound that the caller stops or sets to loop is not destroyed automatically.
    function PlayLocal(self, content: Content): Sound
    --- Returns the low, middle and high levels of every audible sound of one category on this machine,
    --- mixed together, as three numbers from 0 to 1. It is `Sound:GetBands` for a whole category. Use
    --- it to drive a visualizer from the music. The mix includes each sound's volume, its group's
    --- volume, the master volume and distance, but not the player's volume settings. It is computed
    --- only when requested.
    function GetBands(self, category: EnumSoundCategory): (number, number, number)
end

declare extern type DialogueService extends Instance with
    --- When captions are shown: `Auto`, `On` or `Off`. It is a player setting: a value a script sets is
    --- kept for the next run. Setting it on a dedicated server raises an error. `ShowsCaption` applies
    --- it to one caption.
    Subtitles: EnumSubtitleMode
    --- The size of caption text, from 0.75 to 2. It is a player setting, kept like `Subtitles`.
    SubtitleScale: number
    --- The opacity of the background behind captions, from 0 (none) to 1. It is a player setting, kept
    --- like `Subtitles`.
    SubtitleBackground: number
    --- Fires when a caption becomes current on this machine: its sound started or came into range.
    read CaptionStarted: Signal<Caption>
    --- Fires when a caption stops being current on this machine: its sound ended, was stopped, went out
    --- of range or was destroyed.
    read CaptionEnded: Signal<Caption>
    --- Plays a line of dialogue and returns its sound. `line` is `<name>.<id>`, the file and the entry.
    --- Raises an error if no file has the line. It creates a `Voice` sound with a `Caption` from the
    --- line's entry and parents it to `at`, or to `Workspace` if `at` is nil. If `at` is a part, the
    --- line is heard from there. The sound is destroyed shortly after it ends. Use the returned sound
    --- to wait for `Ended` or to stop the line. Called on a server, the sound replicates like any
    --- instance: every player hears the line in their own voice language and reads it in their own text
    --- language. Called on a client, the line plays only on that machine.
    function Say(self, line: string, at: Instance?): Sound
    --- Returns the captions that are current on this machine, in the order their sounds started: every
    --- `Caption` whose `Sound` is playing and can be heard here. Returns an empty list on a dedicated
    --- server.
    function GetCaptions(self): { Caption }
    --- Returns whether a caption should be shown, according to `Subtitles`. It is always true with `On`
    --- and always false with `Off`. With `Auto`, it is true when the player does not hear the line in
    --- the language they read: the voice language differs from the text language, the sound fell back
    --- to the default language's recording while the text is in another language, or the sound has no
    --- recording.
    function ShowsCaption(self, caption: Caption): boolean
end

declare extern type VoxelService extends Instance with
    --- The size of one block, in meters. It can be set only while the world has no blocks; otherwise
    --- setting it raises an error. Call `Clear` first to change it in a built world.
    BlockSize: number
    --- The number of 16 by 16 by 16 chunks that hold at least one block. A chunk with no blocks is not
    --- stored.
    read ChunkCount: number
    --- The number of registered block types. Their ids run from 1 to this number.
    read BlockTypeCount: number
    --- Registers a block type and returns its id. Ids are assigned from 1 in the order of registration,
    --- so the same script gets the same ids on every machine. Registering a name again returns its
    --- existing id and updates its colors. A world can have up to 4,095 block types. `color` is the
    --- color of the top face, and of every face if no other color is given. `sideColor` is the color of
    --- the four sides, and `bottomColor` the color of the bottom, which defaults to the side color. A
    --- grass block, for example, is green on top and brown elsewhere.
    function RegisterBlock(self, name: string, color: Color3, sideColor: Color3?, bottomColor: Color3?): number
    --- Sets the images of a block type, as content paths such as `asset://textures/grass_top.png`, for
    --- its top, its four sides and its bottom. The sides default to the top image and the bottom to the
    --- side image. The block's colors tint its images, so register the type in white to show the images
    --- unchanged. An empty string removes an image. Each image fills one face of a block and repeats on
    --- every block. Images are sampled without filtering, so pixel art stays sharp at any distance. The
    --- side image is upright on every side and is never mirrored.
    function SetBlockTextures(self, id: number, texture: string, sideTexture: string?, bottomTexture: string?): ()
    --- Sets how a block type lets what is behind it show through. `Cutout` blocks have holes where
    --- their image is transparent. `Translucent` blocks blend with what is behind them; `transparency`
    --- (0 to 1, default 0.5) sets how much shows through where the image does not. See-through blocks
    --- still collide, and they do not darken the corners of the blocks around them.
    function SetBlockOpacity(self, id: number, opacity: EnumBlockOpacity, transparency: number?): ()
    --- Makes a block type a fluid, such as water, lava or oil. With a `reach` of 0, it makes the type
    --- an ordinary block again. A fluid block placed with `SetBlock` or `FillBlocks` is a source and
    --- stays in place. From it the fluid flows down first, filling every empty block below. Where it
    --- cannot fall, it spreads sideways for `reach` blocks (1 to 7), one level shallower with each
    --- block. When the source is removed, the fluid it fed drains away. The fluid moves once every
    --- `ticksPerStep` simulation ticks (default 5); a larger number makes a slower fluid. A fluid is
    --- drawn translucent whatever its opacity setting, as deep as it is full. It does not collide and
    --- does not block `Raycast`, so a character can walk into a lake and a tool can reach the lake bed.
    --- `GetBlock` returns the fluid's type at every level, and `GetFluidDepth` returns how full a block
    --- is.
    function SetBlockFluid(self, id: number, reach: number, ticksPerStep: number?): ()
    --- Sets what the fluid `from` turns into where it touches the fluid `touching`. For example, lava
    --- that touches water turns to stone, and the water stays. A block of `from`, including a source,
    --- that touches `touching` on any of its six sides turns into `result` on the next step. Both types
    --- must be fluids. A `result` of 0 removes the reaction. To make the other fluid change too, set a
    --- second reaction with the two types swapped.
    function SetFluidReaction(self, from: number, touching: number, result: number): ()
    --- Returns how full a block is with fluid, from 0 to 1. It is 1 where the fluid is falling or has
    --- more of the same fluid above it, slightly below 1 at a source, and lower with each block the
    --- fluid has spread. Returns 0 for a block that is not a fluid.
    function GetFluidDepth(self, block: vector): number
    --- Returns the id a block type was registered with, or nil if no type has that name.
    function GetBlockId(self, name: string): number?
    --- Places a block, or removes one when `id` is 0. `block` is a block coordinate, whose components
    --- are rounded down. Returns whether anything changed.
    function SetBlock(self, block: vector, id: number): boolean
    --- Returns the id of the block at a block coordinate, or 0 for air. A fluid block returns the
    --- fluid's type at every level; use `GetFluidDepth` for how full it is.
    function GetBlock(self, block: vector): number
    --- Fills every block in the box between two block coordinates, both included, with one block id; 0
    --- empties the box. Returns the number of blocks that changed. Use it to build a floor, a wall or
    --- the first ground of a world in one call. Raises an error for a box of more than 256 blocks along
    --- an axis; fill a larger box in pieces.
    function FillBlocks(self, from: vector, to: vector, id: number): number
    --- Removes every block. The registered block types are kept.
    function Clear(self): ()
    --- Returns the block coordinate that a world position falls in.
    function WorldToBlock(self, position: vector): vector
    --- Returns the world position of the center of a block.
    function BlockToWorld(self, block: vector): vector
    --- Casts a ray through the blocks and returns the first solid block it enters and the face it
    --- entered through, as an outward normal. Returns nil and nil if it hits nothing within the length
    --- of `direction`. The block is the one to break; the block plus the normal is where to place a new
    --- block. Fluids do not stop the ray.
    function Raycast(self, origin: vector, direction: vector): (vector?, vector?)
end

declare extern type NavigationService extends Instance with
    --- The radius of the default agent type, in meters. Paths stay this far from walls. To use other
    --- sizes, define agent types with `DefineAgent`.
    AgentRadius: number
    --- The height of the default agent type, in meters. A gap lower than this is not passable.
    AgentHeight: number
    --- The highest step the default agent type can walk up, in meters. A higher step is an obstacle.
    AgentMaxClimb: number
    --- The steepest ground the default agent type can walk on, in degrees from level.
    AgentMaxSlope: number
    --- Returns a path from `from` to `to`: a list of waypoints to walk between in straight lines, and
    --- whether the path reaches the goal. Returns nil if `from` is not on walkable ground. A path that
    --- stops short is still returned, with false as the second value. That happens when the goal is off
    --- the walkable ground, is cut off, or lies beyond ground that has not been built yet. Walk the
    --- path and query again from where it ends. The third value is a list parallel to the waypoints:
    --- the `Label` of the `NavigationLink` that starts at each waypoint, or an empty string where the
    --- next segment is walked. `agent` is the name of a type defined with `DefineAgent`; an empty
    --- string uses the default type.
    function FindPath(self, from: vector, to: vector, agent: string?): ({ vector }?, boolean, { string })
    --- Defines a named agent type with its own size, and so its own walkable ground. For example, a
    --- giant does not fit through a door that the default agent uses. Queries and `NavigationAgent`
    --- select a type by name. Defining a name again replaces the type.
    function DefineAgent(self, name: string, radius: number, height: number, maxClimb: number?, maxSlope: number?): ()
    --- Sets the cost of walking on ground that a `NavigationArea` marks with a label. A path through
    --- such ground counts its length multiplied by `cost`. `math.huge` makes the ground impassable. A
    --- label with no cost set costs 1. Changing a cost does not rebuild the mesh.
    function SetAreaCost(self, label: string, cost: number): ()
    --- Returns a path on the 2D plane: the points where the path turns, and whether it reaches `to`.
    --- Returns nil if `from` is inside a wall. The path runs over the cells of every `Tilemap2D`. A
    --- tile that is filled and collides is a wall, and so is every anchored `Part2D` that collides.
    --- Diagonal steps never cut across the corner of a wall.
    function FindPath2D(self, from: Vector2, to: Vector2): ({ Vector2 }?, boolean)
    --- Returns the walkable point nearest to a position, within `maxDistance` meters, or nil. Use it to
    --- place a spawn point or a teleport destination on walkable ground, or to turn a click on the
    --- world into a path goal.
    function NearestPoint(self, point: vector, maxDistance: number?): vector?
    --- Walks in a straight line from `from` toward `to` over the walkable ground and returns where it
    --- stops: at `to`, or where a wall or an edge blocks the way. Returns nil if `from` is not on
    --- walkable ground. It is much cheaper than `FindPath`; try it first, since most moves are
    --- straight.
    function Raycast(self, from: vector, to: vector): vector?
    --- Builds the navigation mesh over a box immediately, so that the first path through it does not
    --- wait for it. Returns the number of tiles it built. Ground that is already built and unchanged
    --- costs nothing.
    function BuildRegion(self, minimum: vector, maximum: vector): number
end

