# Every flag the vendored Luau defines, by the library that defines it, as a
# header (ADR 0093, amended 2026-10-06; ADR 0217).
#
# **Why a generated list.** Luau ships every change behind a flag that is off
# until the change has been through its own release train. The engine has to
# know which library reads each one, because that decides what it may do with
# it: the type checker's own are turned on in the editor's checker, as Luau's
# own tools -- `luau-analyze`, and the `luau-lsp` that `ludwerk check` runs --
# turn them on (`setLuauFlagsDefault`, less the few `isAnalysisFlagExperimental`
# names); a parser's, a compiler's or a VM's changes what a script compiles to
# or how it runs, so a project that sets one has every machine in a match agree
# on it, and the tools that check its scripts told it.
#
# **The editor's checker ran with none on** at first: the new solver at the pin
# with every fix made since it was written switched off, which reported
# `hero.Body.Parent` on a value typed `any` as "type 'unknown' does not have key
# 'Parent'" in a project `ludwerk check` called clean.
#
# **Why the library, and why it is reliable.** A flag is process-wide and found
# by name. A flag DEFINED under `Analysis/` or `EqSat/` cannot be read by the VM,
# the compiler or the parser: those libraries are built and linked without the
# checker (a shipped game carries none, ADR 0002), so a reference from them
# would not link -- and the same holds the other way for each library a lower
# one does not depend on. The definitions are read from the vendored sources at
# the pin, so the lists move with the pin and nobody keeps them.

function(engine_luau_flags output)
    # Directory, and the area the engine files its flags under.
    set(areas
        "Ast:Parser"
        "Compiler:Compiler" "Bytecode:Compiler"
        "VM:Vm"
        "CodeGen:CodeGen" "Inliner:CodeGen"
        "Analysis:Analysis" "EqSat:Analysis"
        "Config:Other" "Require:Other" "Common:Other")
    set(text "// Generated by cmake/engine_luau_flags.cmake from the vendored Luau. Not edited.\n")
    string(APPEND text "#pragma once\n\n#include <string_view>\n\nnamespace engine::app {\n\n")
    set(total 0)
    foreach(area IN ITEMS Parser Compiler Vm CodeGen Analysis Other)
        set(names_${area} "")
    endforeach()
    foreach(pair IN LISTS areas)
        string(REPLACE ":" ";" parts "${pair}")
        list(GET parts 0 directory)
        list(GET parts 1 area)
        file(GLOB sources CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/third_party/luau/${directory}/src/*.cpp")
        foreach(source IN LISTS sources)
            file(STRINGS "${source}" lines REGEX "^LUAU_(DYNAMIC_)?FAST(FLAG|INT)VARIABLE\\([A-Za-z0-9_]+")
            foreach(line IN LISTS lines)
                string(REGEX REPLACE "^LUAU_(DYNAMIC_)?FAST(FLAG|INT)VARIABLE\\(([A-Za-z0-9_]+).*$" "\\3" name
                       "${line}")
                list(APPEND names_${area} "${name}")
            endforeach()
        endforeach()
    endforeach()
    foreach(area IN ITEMS Parser Compiler Vm CodeGen Analysis Other)
        list(REMOVE_DUPLICATES names_${area})
        list(SORT names_${area})
        list(LENGTH names_${area} count)
        math(EXPR total "${total} + ${count}")
        string(APPEND text "inline constexpr std::string_view Luau${area}Flags[] = {\n")
        foreach(name IN LISTS names_${area})
            string(APPEND text "    \"${name}\",\n")
        endforeach()
        # Never empty, so the array is always one: a placeholder no flag is named.
        string(APPEND text "    \"\",\n};\n\n")
    endforeach()
    list(LENGTH names_Analysis analysis)
    if(analysis EQUAL 0 OR total EQUAL 0)
        message(FATAL_ERROR
            "No Luau flag was found under third_party/luau: the macro that defines one changed its spelling, and "
            "cmake/engine_luau_flags.cmake must read the new one.")
    endif()
    string(APPEND text "} // namespace engine::app\n")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${text}" @ONLY)
endfunction()
