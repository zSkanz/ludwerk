Ludwerk: a pipeline cache on Vulkan, kept on disk across runs.

SDL's Vulkan backend made every pipeline with no VkPipelineCache ("TODO:
enable pipeline caching"), so a driver without a disk cache of its own --
a phone's, a standalone headset's -- compiled every pipeline again in every
session, and a material's first use in play waited for it. With this patch
the device makes one cache, seeded from the file named by
SDL_PROP_GPU_DEVICE_CREATE_VULKAN_PIPELINE_CACHE_FILE_STRING when it is
created, makes every graphics and compute pipeline through it -- a pipeline
cache is synchronized by the implementation, so pipelines made on several
threads at once share it -- and writes it back when the device is destroyed,
beside the file first and then moved over it. Data the driver cannot use,
another GPU's or another driver's, it ignores, as Vulkan specifies. Without
the property the cache lives for the session alone. Direct3D 12 and Metal
are unchanged. Upstream makes no cache; send it, or drop it when a pinned
release carries one.

diff --git a/include/SDL3/SDL_gpu.h b/include/SDL3/SDL_gpu.h
index 5b43eea..24c2ae4 100644
--- a/include/SDL3/SDL_gpu.h
+++ b/include/SDL3/SDL_gpu.h
@@ -2349,6 +2349,11 @@ extern SDL_DECLSPEC SDL_GPUDevice * SDLCALL SDL_CreateGPUDevice(
  *   This allows configuring a variety of Vulkan-specific options such as
  *   increasing the API version and opting into extensions aside from the
  *   minimal set SDL requires.
+ * - `SDL_PROP_GPU_DEVICE_CREATE_VULKAN_PIPELINE_CACHE_FILE_STRING`: a file
+ *   the device's pipeline cache is read from when it is created and written
+ *   back to when it is destroyed, so pipelines made in one run are not
+ *   compiled again in the next. Data from another GPU or driver is ignored by
+ *   the driver. (Ludwerk patch.)
  *
  * With the Metal backend: -
  * `SDL_PROP_GPU_DEVICE_CREATE_METAL_ALLOW_MACFAMILY1_BOOLEAN`: By default,
@@ -2393,6 +2398,7 @@ extern SDL_DECLSPEC SDL_GPUDevice * SDLCALL SDL_CreateGPUDeviceWithProperties(
 #define SDL_PROP_GPU_DEVICE_CREATE_D3D12_AGILITY_SDK_PATH_STRING                "SDL.gpu.device.create.d3d12.agility_sdk_path"
 #define SDL_PROP_GPU_DEVICE_CREATE_VULKAN_REQUIRE_HARDWARE_ACCELERATION_BOOLEAN "SDL.gpu.device.create.vulkan.requirehardwareacceleration"
 #define SDL_PROP_GPU_DEVICE_CREATE_VULKAN_OPTIONS_POINTER                       "SDL.gpu.device.create.vulkan.options"
+#define SDL_PROP_GPU_DEVICE_CREATE_VULKAN_PIPELINE_CACHE_FILE_STRING            "SDL.gpu.device.create.vulkan.pipeline_cache_file"
 #define SDL_PROP_GPU_DEVICE_CREATE_METAL_ALLOW_MACFAMILY1_BOOLEAN               "SDL.gpu.device.create.metal.allowmacfamily1"
 
 #define SDL_PROP_GPU_DEVICE_CREATE_XR_ENABLE_BOOLEAN                            "SDL.gpu.device.create.xr.enable"
diff --git a/src/gpu/vulkan/SDL_gpu_vulkan.c b/src/gpu/vulkan/SDL_gpu_vulkan.c
index 9158d69..f44ff7c 100644
--- a/src/gpu/vulkan/SDL_gpu_vulkan.c
+++ b/src/gpu/vulkan/SDL_gpu_vulkan.c
@@ -1167,6 +1167,10 @@ struct VulkanRenderer
     VkPhysicalDeviceProperties2KHR physicalDeviceProperties;
     VkPhysicalDeviceDriverPropertiesKHR physicalDeviceDriverProperties;
     VkDevice logicalDevice;
+    /* Ludwerk: every pipeline is made through this, seeded from and kept in
+     * `pipelineCacheFile` across runs (patch 0011). */
+    VkPipelineCache pipelineCache;
+    char *pipelineCacheFile;
     Uint8 integratedMemoryNotification;
     Uint8 outOfDeviceLocalMemoryWarning;
     Uint8 outofBARMemoryWarning;
@@ -5142,6 +5146,32 @@ static void VULKAN_DestroyDevice(
     SDL_DestroyMutex(renderer->descriptorSetLayoutFetchLock);
     SDL_DestroyMutex(renderer->windowLock);
 
+    /* Ludwerk: the pipelines this run made, kept for the next (patch 0011).
+     * Written beside the file and moved over it, so a run that ends while
+     * another is writing never leaves half of one. */
+    if (renderer->pipelineCache != VK_NULL_HANDLE) {
+        if (renderer->pipelineCacheFile != NULL) {
+            size_t size = 0;
+            if (renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, NULL) == VK_SUCCESS && size > 0) {
+                void *data = SDL_malloc(size);
+                if (data != NULL && renderer->vkGetPipelineCacheData(renderer->logicalDevice, renderer->pipelineCache, &size, data) == VK_SUCCESS) {
+                    char *partial = NULL;
+                    if (SDL_asprintf(&partial, "%s.%" SDL_PRIu64 ".partial", renderer->pipelineCacheFile, (Uint64)SDL_GetCurrentThreadID()) > 0) {
+                        if (SDL_SaveFile(partial, data, size)) {
+                            if (!SDL_RenamePath(partial, renderer->pipelineCacheFile)) {
+                                SDL_RemovePath(partial);
+                            }
+                        }
+                        SDL_free(partial);
+                    }
+                }
+                SDL_free(data);
+            }
+        }
+        renderer->vkDestroyPipelineCache(renderer->logicalDevice, renderer->pipelineCache, NULL);
+    }
+    SDL_free(renderer->pipelineCacheFile);
+
     renderer->vkDestroyDevice(renderer->logicalDevice, NULL);
     renderer->vkDestroyInstance(renderer->instance, NULL);
 
@@ -6734,10 +6764,9 @@ static SDL_GPUGraphicsPipeline *VULKAN_CreateGraphicsPipeline(
     vkPipelineCreateInfo.basePipelineHandle = VK_NULL_HANDLE;
     vkPipelineCreateInfo.basePipelineIndex = 0;
 
-    // TODO: enable pipeline caching
     vulkanResult = renderer->vkCreateGraphicsPipelines(
         renderer->logicalDevice,
-        VK_NULL_HANDLE,
+        renderer->pipelineCache,
         1,
         &vkPipelineCreateInfo,
         NULL,
@@ -6872,7 +6901,7 @@ static SDL_GPUComputePipeline *VULKAN_CreateComputePipeline(
 
     vulkanResult = renderer->vkCreateComputePipelines(
         renderer->logicalDevice,
-        (VkPipelineCache)VK_NULL_HANDLE,
+        renderer->pipelineCache,
         1,
         &vkShaderCreateInfo,
         NULL,
@@ -13750,6 +13779,34 @@ static SDL_GPUDevice *VULKAN_CreateDevice(bool debugMode, bool preferLowPower, S
         return NULL;
     }
 
+    /* Ludwerk: a pipeline cache, seeded from the file the app names (patch
+     * 0011). Data the driver cannot use -- another GPU's, another driver's --
+     * it ignores; a cache that cannot be made at all is none, as before. */
+    renderer->pipelineCache = VK_NULL_HANDLE;
+    renderer->pipelineCacheFile = NULL;
+    {
+        const char *file = SDL_GetStringProperty(props, SDL_PROP_GPU_DEVICE_CREATE_VULKAN_PIPELINE_CACHE_FILE_STRING, NULL);
+        void *seed = NULL;
+        size_t seedSize = 0;
+        VkPipelineCacheCreateInfo cacheInfo;
+        SDL_zero(cacheInfo);
+        cacheInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+        if (file != NULL && *file != '\0') {
+            renderer->pipelineCacheFile = SDL_strdup(file);
+            seed = SDL_LoadFile(file, &seedSize);
+        }
+        cacheInfo.initialDataSize = seed != NULL ? seedSize : 0;
+        cacheInfo.pInitialData = seed;
+        if (renderer->vkCreatePipelineCache(renderer->logicalDevice, &cacheInfo, NULL, &renderer->pipelineCache) != VK_SUCCESS) {
+            cacheInfo.initialDataSize = 0;
+            cacheInfo.pInitialData = NULL;
+            if (renderer->vkCreatePipelineCache(renderer->logicalDevice, &cacheInfo, NULL, &renderer->pipelineCache) != VK_SUCCESS) {
+                renderer->pipelineCache = VK_NULL_HANDLE;
+            }
+        }
+        SDL_free(seed);
+    }
+
     if (renderer->supportsFragmentDensityMap) {
         SDL_SetNumberProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_FRAGMENT_DENSITY_MIN_TEXEL_WIDTH_NUMBER, renderer->minFragmentDensityTexelSize.width);
         SDL_SetNumberProperty(renderer->props, SDL_PROP_GPU_DEVICE_VULKAN_FRAGMENT_DENSITY_MIN_TEXEL_HEIGHT_NUMBER, renderer->minFragmentDensityTexelSize.height);
